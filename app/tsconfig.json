{
  "extends": "../node_modules/astro/tsconfigs/strictest.json",
  "include": [
    "src/**/*",
    "vite.config.ts",
    "cloudflare.config.ts",
    "./.cloudflare/types/index.d.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "moduleResolution": "bundler",
    "module": "esnext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ]
  }
}
