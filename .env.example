# Local values for `pnpm dev`. Copy to .dev.vars (the Cloudflare dev server reads secrets from there).

# The admin appointed when the club's database starts. Open /forgot with this address to get a link that sets the password.
ADMIN_EMAIL=admin@club.test

# CHIP Collect test keys, from portal.chip-in.asia (Developers). Test keys take only test cards.
CHIP_SECRET_KEY=
CHIP_BRAND_ID=
