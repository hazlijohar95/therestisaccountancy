# SITE_URL is read from the shell at build time, not from this file: SITE_URL=https://example.com pnpm build
# It sets the address invitation links point to.

# Where the club database lives. Defaults to data/club.sqlite.
# DATABASE_PATH=data/club.sqlite

# The admin created by `pnpm db:admin`. Run it again to reset the password.
ADMIN_EMAIL=admin@club.test
ADMIN_NAME=Club Admin
ADMIN_PASSWORD=
