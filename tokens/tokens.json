{
  "$description": "Source of truth for The Rest Is Accountancy (club) and Stick to Accounting (podcast). Edit here, then run: node scripts/build-tokens.mjs",
  "color": {
    "ink": {
      "$value": "#231F20",
      "$description": "Logo ink. Read from the STA artwork file (rich black, C0 M0 Y0 K100 converted)."
    },
    "night": {
      "$value": "#000000",
      "$description": "True black ground of every TRIA cover and the dark STA artboard."
    },
    "paper": {
      "$value": "#FFFFFF",
      "$description": "Clean paper. Light logo ground."
    },
    "tape": {
      "$value": "#F7D52A",
      "$description": "Masking-tape yellow behind 'Podcast Show', read from the STA artwork file. The podcast's ground."
    },
    "highlighter": {
      "$value": "#F4DD6C",
      "$description": "Brush-stroke yellow behind the banner wordmark (Canva recolour value)."
    },
    "redline": {
      "$value": "#A8180F",
      "$description": "New. Auditor's red pen: corrections, negative figures, the live dot. Deep enough to read on tape yellow. Never decorative."
    }
  },
  "font": {
    "serif": {
      "$value": "'Fraunces', 'Iowan Old Style', Georgia, serif",
      "$description": "Companion to both wordmarks (the logos are outlined; their typefaces are not in the files)."
    },
    "hand": {
      "$value": "'Gochi Hand', 'Comic Sans MS', cursive",
      "$description": "Companion to the 'Podcast Show' and 'Death, Taxes and Ai.' lettering."
    },
    "sans": {
      "$value": "'Instrument Sans', 'Helvetica Neue', Arial, sans-serif",
      "$description": "Text, UI and figures."
    }
  },
  "serifSetting": {
    "club": {
      "$value": {
        "weight": 380,
        "variation": "'SOFT' 0, 'WONK' 1",
        "tracking": "-0.02em"
      }
    },
    "podcast": {
      "$value": {
        "weight": 900,
        "variation": "'SOFT' 100, 'WONK' 0",
        "tracking": "-0.035em"
      }
    }
  },
  "size": {
    "poster": {
      "$value": "clamp(3.5rem, 2rem + 7.5vw, 9rem)"
    },
    "title": {
      "$value": "clamp(2.25rem, 1.6rem + 2.6vw, 4rem)"
    },
    "head": {
      "$value": "clamp(1.5rem, 1.25rem + 1vw, 2.125rem)"
    },
    "lead": {
      "$value": "1.25rem"
    },
    "body": {
      "$value": "1.0625rem"
    },
    "small": {
      "$value": "0.875rem"
    },
    "label": {
      "$value": "0.8125rem"
    }
  },
  "space": {
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "24px"
    },
    "6": {
      "$value": "32px"
    },
    "7": {
      "$value": "48px"
    },
    "8": {
      "$value": "64px"
    },
    "9": {
      "$value": "96px"
    },
    "10": {
      "$value": "128px"
    }
  },
  "radius": {
    "none": {
      "$value": "0"
    },
    "round": {
      "$value": "999px",
      "$description": "Avatars, the play button and the live dot only. The brand is square-cut."
    }
  },
  "rotate": {
    "tape": {
      "$value": "-3deg",
      "$description": "Banner brush stroke sits at -2.83deg."
    },
    "tag": {
      "$value": "-2deg",
      "$description": "Host name tags sit at -1.95deg."
    },
    "sticker": {
      "$value": "1.5deg"
    }
  },
  "motion": {
    "quick": {
      "$value": "160ms"
    },
    "settle": {
      "$value": "420ms"
    },
    "ease": {
      "$value": "cubic-bezier(.2, .8, .2, 1)"
    },
    "slap": {
      "$value": "cubic-bezier(.3, 1.6, .5, 1)",
      "$description": "Overshoot used once: tape landing."
    }
  },
  "theme": {
    "$description": "Semantic roles, each [light, dark]. No greys: hierarchy comes from size and weight, every rule is ink.",
    "club": {
      "bg": [
        "paper",
        "night"
      ],
      "surface": [
        "paper",
        "night"
      ],
      "ink": [
        "ink",
        "paper"
      ],
      "muted": [
        "ink",
        "paper"
      ],
      "rule": [
        "ink",
        "paper"
      ],
      "accent": [
        "ink",
        "paper"
      ],
      "onAccent": [
        "paper",
        "night"
      ],
      "mark": [
        "ink",
        "paper"
      ],
      "onMark": [
        "paper",
        "night"
      ],
      "alert": [
        "redline",
        "#FF6A5C"
      ]
    },
    "podcast": {
      "bg": [
        "tape",
        "night"
      ],
      "surface": [
        "paper",
        "night"
      ],
      "ink": [
        "ink",
        "paper"
      ],
      "muted": [
        "ink",
        "paper"
      ],
      "rule": [
        "ink",
        "paper"
      ],
      "accent": [
        "tape",
        "tape"
      ],
      "onAccent": [
        "ink",
        "ink"
      ],
      "mark": [
        "highlighter",
        "tape"
      ],
      "onMark": [
        "ink",
        "ink"
      ],
      "alert": [
        "redline",
        "#FF6A5C"
      ]
    }
  },
  "contract": {
    "$description": "Pairs the build must pass (WCAG 2.2 contrast). [foreground, background, minimum].",
    "pairs": [
      [
        "ink",
        "bg",
        7
      ],
      [
        "muted",
        "bg",
        4.5
      ],
      [
        "ink",
        "surface",
        7
      ],
      [
        "muted",
        "surface",
        4.5
      ],
      [
        "onAccent",
        "accent",
        4.5
      ],
      [
        "alert",
        "bg",
        4.5
      ],
      [
        "alert",
        "surface",
        4.5
      ],
      [
        "onMark",
        "mark",
        4.5
      ],
      [
        "bg",
        "ink",
        7
      ]
    ]
  },
  "stroke": {
    "hair": {
      "$value": "1px"
    },
    "rule": {
      "$value": "2px"
    },
    "heavy": {
      "$value": "4px",
      "$description": "Section rules and frames. The brutal line."
    }
  },
  "shadow": {
    "hard": {
      "$value": "6px",
      "$description": "Offset of the podcast's hard shadow. No blur, ever."
    }
  },
  "grid": {
    "gutter": {
      "$value": "2px",
      "$description": "Cells sit on an ink ground; the gutter shows as a rule."
    },
    "max": {
      "$value": "1320px"
    }
  },
  "style": {
    "$description": "Per-brand component behaviour, emitted inside each brand scope so nested brands never leak.",
    "club": {
      "btnShadow": "0 0 0 0 transparent",
      "btnShadowHover": "0 0 0 0 transparent",
      "btnShift": "0px",
      "btnHoverBg": "transparent",
      "btnHoverInk": "var(--ink)",
      "grain": "none"
    },
    "podcast": {
      "btnShadow": "var(--shadow-hard) var(--shadow-hard) 0 var(--ink)",
      "btnShadowHover": "calc(var(--shadow-hard) + 3px) calc(var(--shadow-hard) + 3px) 0 var(--ink)",
      "btnShift": "-3px",
      "btnHoverBg": "var(--accent)",
      "btnHoverInk": "var(--on-accent)",
      "grain": "var(--texture-grain)"
    }
  }
}
