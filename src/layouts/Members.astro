---
import { actions } from 'astro:actions';
import Logo from '../components/Logo.astro';
import { site } from '../data/club.ts';
import Base from './Base.astro';

interface Props {
  title: string;
}

const member = Astro.locals.member;
const links = [
  { href: '/members', label: 'Overview' },
  { href: '/members/resources', label: 'Templates' },
  { href: '/members/sessions', label: 'Sessions' },
  { href: '/members/calls', label: 'One-to-one' },
  { href: '/members/community', label: 'Community' },
  { href: '/members/account', label: 'Account' },
  ...(member?.role === 'admin' ? [{ href: '/admin', label: 'Admin' }] : []),
];
const here = Astro.url.pathname.replace(/\/$/, '');
const current = (href: string) => (here === href || (href !== '/members' && here.startsWith(`${href}/`)) ? 'page' : undefined);
---

<Base title={Astro.props.title} noindex>
  <header class="bar night">
    <div class="wrap in">
      <a class="home" href="/members"><Logo brand="club" label={`${site.name}, members`} /></a>
      <nav aria-label="Members">
        {links.map((link) => <a href={link.href} aria-current={current(link.href)}>{link.label}</a>)}
      </nav>
      <form method="POST" action={`/sign-in${actions.signOut}`}>
        <button class="btn ghost out" type="submit">Sign out</button>
      </form>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="wrap foot small">
    <a href="/">Public site</a>
    <span>{member ? `Signed in as ${member.email}` : ''}</span>
  </footer>
</Base>

<style>
  .bar { position: sticky; top: 0; z-index: 40; border-bottom: var(--stroke-hair) solid var(--ink); }
  .in { display: flex; align-items: center; gap: var(--space-5); min-height: var(--bar); }
  .home { flex: none; width: 168px; color: inherit; }
  nav { display: flex; gap: var(--space-5); margin-inline-start: auto; overflow-x: auto; scrollbar-width: none; }
  nav a { flex: none; font: 600 var(--size-small)/1 var(--font-sans); text-decoration: none; padding-block: var(--space-3); background: linear-gradient(currentColor, currentColor) left calc(100% - 6px) / 0 var(--stroke-hair) no-repeat; transition: background-size var(--motion-settle) var(--motion-ease); }
  nav a:hover, nav a[aria-current="page"] { background-size: 100% var(--stroke-hair); }
  form { margin: 0; }
  .out { min-height: 40px; padding: .55em 1em; font-size: var(--size-small); }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); padding-block: var(--space-6); border-top: var(--stroke-hair) solid var(--ink); margin-top: var(--space-9); }
  @media (max-width: 720px) { .in { flex-wrap: wrap; padding-block: var(--space-3); } .home { width: 124px; } nav { order: 3; width: 100%; margin: 0; flex-wrap: wrap; row-gap: 0; column-gap: var(--space-4); overflow: visible; } form { margin-inline-start: auto; } }
</style>
