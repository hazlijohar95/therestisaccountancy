---
import Bar from '../components/Bar.astro';
import Footer from '../components/Footer.astro';
import Base from './Base.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** False on a page whose task contradicts the footer's newsletter sign-up, like unsubscribing from it. */
  signup?: boolean;
}

const { signup = true, ...base } = Astro.props;
---

<Base {...base}>
  <Bar />
  <main id="main"><slot /></main>
  <Footer signup={signup} />
</Base>
