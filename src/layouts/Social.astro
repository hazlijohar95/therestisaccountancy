---
import '../styles/social.css';
import Logo from '../components/Logo.astro';
import Avatar from '../components/social/Avatar.astro';
import Symbols from '../components/social/Symbols.astro';
import { SEARCH_MAX } from '../lib/search.ts';
import { clubPath, isSocialHost, signInPath, socialPath, socialPathOf } from '../server/paths.ts';
import Base from './Base.astro';

export type Section = 'floor' | 'list' | 'problems' | 'verify' | 'notifications';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  noindex?: boolean;
  /** The nav item this page belongs to. */
  section?: Section;
}

const { title, description = 'The people in accountancy worth following. Every credential ticked, every claim sourced.', noindex = false, section } = Astro.props;
const url = Astro.url;
const member = Astro.locals.member;
/* Read in the middleware, before the store is released, so the header can draw the member's track and seal. */
const own = Astro.locals.profile;
const unread = Astro.locals.unread;
const to = (path: string) => socialPath(url, path);
const nav: readonly { section: Section; href: string; label: string; icon: string }[] = [
  { section: 'floor', href: to('/'), label: 'Floor', icon: 'i-floor' },
  { section: 'list', href: to('/list'), label: 'The List', icon: 'i-list' },
  { section: 'problems', href: to('/problems'), label: 'Problems', icon: 'i-problem' },
  { section: 'verify', href: to('/verify'), label: 'Get ticked', icon: 'tk' },
];
/* Signing in happens on the club's host, and comes back to this page. */
const signIn = signInPath(url, socialPathOf(url));
---

<Base title={title} description={description} noindex={noindex} brand="social">
  <Symbols />
  <header class="top">
    <div class="top-in">
      <a class="brand" href={to('/')} aria-label="The Rest Is Accountancy Social, home">
        <Logo brand="club" class="wordmark" />
        <span class="tape">social</span>
      </a>
      <nav class="nav" aria-label="Main">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={item.section === section ? 'page' : undefined}>
              <svg aria-hidden="true">
                <use href={`#${item.icon}`} />
              </svg>
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
      <div class="top-end">
        <a class="icon-btn" href={to('/search')} aria-label="Search" aria-keyshortcuts="Control+K Meta+K /" data-search-open>
          <svg aria-hidden="true"><use href="#i-search" /></svg>
        </a>
        {
          member ? (
            <>
            <a class="icon-btn bell" href={to('/notifications')} aria-label={unread ? `Notifications, ${unread} unread` : 'Notifications'} aria-current={section === 'notifications' ? 'page' : undefined}>
              <svg aria-hidden="true"><use href="#i-bell" /></svg>
              {unread > 0 && <span class="count" aria-hidden="true">{unread}</span>}
            </a>
            <a class="me" href={to('/me')} aria-label="Your profile">
              <Avatar name={member.name} track={own?.track} sealed={own?.sealed ?? false} size="sm" />
            </a>
            </>
          ) : (
            <>
              <a class="btn sm ghost" href={signIn}>Sign in</a>
              <a class="btn sm" href={to('/request')}>Request to join</a>
            </>
          )
        }
      </div>
    </div>
  </header>
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="foot">
    <p>Ticks confirm credentials. They never vouch for advice.</p>
    <nav aria-label="Footer">
      <a href={to('/ticks')}>What a tick means</a>
      <a href={to('/nominate')}>Nominate someone</a>
      {member ? <a href={to('/invites')}>Invite someone</a> : <a href={to('/request')}>Request to join</a>}
      <a href={clubPath(url, '/')}>The club</a>
      <a href={clubPath(url, '/privacy')}>Privacy</a>
    </nav>
  </footer>
  {/* The dialog fetches from the host the page is on: the social host would be another origin from /social on the club's. */}
  <dialog class="modal card search" id="search" aria-labelledby="search-title" data-endpoint={isSocialHost(url.hostname) ? '/search' : '/social/search'} data-nominate={to('/nominate')}>
    <h2 class="sr-only" id="search-title">Search</h2>
    <div class="s-box">
      <svg class="ic" aria-hidden="true"><use href="#i-search" /></svg>
      <input id="s-q" class="s-input" type="search" role="combobox" aria-expanded="false" aria-controls="s-list" aria-autocomplete="list" aria-label="Search people and posts" placeholder="Search people and posts" autocomplete="off" spellcheck="false" maxlength={SEARCH_MAX} />
    </div>
    <div id="s-list" role="listbox" aria-label="Results"></div>
    <p class="s-hint" id="s-hint">Type a name, a handle, a topic or words from a post.</p>
    <p class="sr-only" role="status" id="s-count"></p>
    <p class="s-keys small" aria-hidden="true"><kbd>↑</kbd> <kbd>↓</kbd> move · <kbd>Enter</kbd> open · <kbd>Esc</kbd> close</p>
    <button class="icon-btn close" type="button" aria-label="Close search" data-search-close>
      <svg aria-hidden="true"><use href="#i-x" /></svg>
    </button>
  </dialog>
</Base>

<script>
  import { initCommands } from '../lib/commands.ts';
  import { initSearch } from '../lib/search-dialog.ts';

  initCommands();
  initSearch();
</script>
