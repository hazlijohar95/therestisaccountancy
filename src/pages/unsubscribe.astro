---
import Page from '../layouts/Page.astro';

export const prerender = false;

/* Whole sentences per list, so none is built from a fragment. */
const copy = {
  newsletter: { ask: 'Stop the newsletter?', done: 'Done. The newsletter will stop.' },
  digest: { ask: 'Stop the weekly email?', done: 'Done. No more weekly emails.' },
  replies: { ask: 'Stop emails about replies in your threads?', done: 'Done. No more emails about replies in your threads.' },
} as const;

const list = Astro.url.searchParams.get('list');
const key = Astro.url.searchParams.get('k') ?? '';
const done = Astro.url.searchParams.has('done');
const newsletter = list === 'newsletter';
const text = list === 'newsletter' || list === 'digest' || list === 'replies' ? copy[list] : null;
---

<Page title="Unsubscribe" noindex signup={false}>
  <section class="wrap block" aria-labelledby="page-title">
    {
      !text ? (
        <>
          <h1 class="head" id="page-title">That link is not complete.</h1>
          <p>Open the unsubscribe link at the bottom of the latest email again, or reply to that email and ask us to stop.</p>
        </>
      ) : done ? (
        <>
          <h1 class="head" id="page-title">{text.done}</h1>
          {newsletter ? (
            <p>Changed your mind? <a href="/newsletter">Subscribe again</a>.</p>
          ) : (
            <p>Change your mind any time in <a href="/members/account#email">your account</a>.</p>
          )}
        </>
      ) : (
        <>
          <h1 class="head" id="page-title">{text.ask}</h1>
          <form method="POST" action={`/unsubscribe?k=${encodeURIComponent(key)}&list=${list}`}>
            <input type="hidden" name="from" value="page" />
            <button class="btn" type="submit">Unsubscribe</button>
          </form>
          {!newsletter && <p class="small">Emails about your membership, sign-in and sessions you said you would come to still arrive.</p>}
        </>
      )
    }
  </section>
</Page>

<style>
  .block { display: grid; gap: var(--space-5); padding-block: clamp(64px, 9vw, 128px); }
  .block > * { margin: 0; max-width: 640px; }
</style>
