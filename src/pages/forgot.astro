---
import { actions, isInputError } from 'astro:actions';
import Page from '../layouts/Page.astro';
import { formAction } from '../lib/format.ts';

export const prerender = false;

const result = Astro.getActionResult(actions.requestLink);
const sentTo = result?.data?.email ?? null;
const error = result?.error ? (isInputError(result.error) ? result.error.fields.email?.[0] : result.error.message) : null;
---

<Page title="Get a new link" noindex>
  <section class="night" aria-labelledby="page-title">
    <div class="wrap in">
      <div>
        <p class="label top">Members</p>
        <h1 class="headline serif" id="page-title">Get a new link.</h1>
        <p class="lead">Forgot your password, or lost your invitation? Enter the email you joined with. We send a link that sets a new password.</p>
      </div>
      {
        sentTo ? (
          <div class="form" role="status">
            <p class="note">If {sentTo} belongs to a member, a link is on its way. It works once.</p>
            <p class="small">Nothing after a few minutes? Check your spam folder. A new link can be sent every ten minutes.</p>
            <p class="small"><a href="/sign-in">Back to sign in</a></p>
          </div>
        ) : (
          <form method="POST" action={formAction(Astro.url, actions.requestLink)} class="form">
            <div class="field">
              <label for="email">Email</label>
              <input class="input" id="email" name="email" type="email" autocomplete="username" required aria-invalid={error ? 'true' : undefined} aria-describedby={error ? 'form-error' : undefined} autofocus={error ? true : undefined} />
            </div>
            {error && <p class="error" id="form-error" role="alert">{error}</p>}
            <button class="btn" type="submit">Email me a link</button>
            <p class="small"><a href="/sign-in">Back to sign in</a></p>
          </form>
        )
      }
    </div>
  </section>
</Page>

<style>
  .in { display: grid; gap: var(--space-8); padding-block: clamp(32px, 4vw, 48px) clamp(80px, 10vw, 144px); }
  .top { margin: 0 0 var(--space-6); padding-bottom: var(--space-4); border-bottom: var(--stroke-hair) solid var(--ink); }
  .headline { margin: 0 0 var(--space-5); max-width: 10ch; font-size: var(--size-page); line-height: .98; }
  .lead { margin: 0; max-width: 36ch; }
  .form { display: grid; gap: var(--space-5); align-content: start; max-width: 440px; }
  .form .btn { justify-self: start; }
  .note, .error { margin: 0; font-weight: 600; }
  .error { color: var(--alert); }
  .small { margin: 0; }
  @media (min-width: 900px) { .in { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; } }
</style>
