---
import catalog from '@therestisaccountancy/brand/logos/catalog.json';
import staLockup from '@therestisaccountancy/brand/logos/sta-lockup-color.svg';
import Byline from '../components/Byline.astro';
import Closing from '../components/Closing.astro';
import Story from '../components/Story.astro';
import { authorPath, authors, host, hostFirstName, roleOf } from '../data/authors.ts';
import { podcast } from '../data/club.ts';
import { columnBySlug } from '../data/columns.ts';
import Page from '../layouts/Page.astro';
import { postsInColumn } from '../server/posts.ts';

/* The show's page: its logo as the title, its line, where to listen, then every episode. Every's /podcast, in our brand. */
const show = columnBySlug('podcast');
const episodes = await postsInColumn('podcast');
const logoAspect = catalog.find((e) => e.file === 'assets/logos/sta-lockup-color.svg')?.aspect ?? 3.42;
/* Everyone who has co-hosted, most episodes first. A new co-host shows here after their first episode. */
const cohosts = authors
  .filter((author) => roleOf(author) === 'Co-host')
  .map((author) => ({ author, count: episodes.filter((e) => e.data.authors.includes(author.handle)).length }))
  .filter(({ count }) => count > 0)
  .sort((a, b) => b.count - a.count)
  .map(({ author }) => author.handle);
---

<Page title="Podcast" description="Stick to Accounting, the club’s podcast. News, analysis and interviews. Free and public.">
  <header class="wrap show">
    <h1><img src={staLockup.src} alt={show?.name ?? 'Stick to Accounting'} width="480" height={Math.round(480 / logoAspect)} /></h1>
    <p class="line">{show?.tagline}</p>
    <p class="small">Hosted by <a href={authorPath(host)}>{host.name}</a>. Accountant friends join as co-hosts.</p>
    {
      cohosts.length > 0 && (
        <div class="cohosts">
          <p class="label">Co-hosts so far</p>
          <Byline handles={cohosts} size={32} />
        </div>
      )
    }
    <a class="platform" href={podcast.subscribe} rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.8 15.1V8.9l5.4 3.1Z" /></svg>
      <span>Subscribe on YouTube</span>
    </a>
    {
      episodes.length > 1 && (
        <div class="seg order" role="group" aria-label="Order of episodes" style="--n: 2; --i: 0">
          <span class="thumb" aria-hidden="true" />
          <button type="button" aria-pressed="true" data-order="newest">Newest</button>
          <button type="button" aria-pressed="false" data-order="oldest">Oldest</button>
        </div>
      )
    }
  </header>

  <section class="wrap episodes" aria-labelledby="episodes-title">
    <h2 class="visually-hidden" id="episodes-title">Episodes</h2>
    {
      episodes.length > 0 ? (
        <ol class="grid" data-episodes>
          {episodes.map((post) => <li><Story post={post} showColumn={false} /></li>)}
        </ol>
      ) : (
        <p class="empty">{podcast.find}</p>
      )
    }
  </section>
  <Closing title="The episodes ask. The club answers." lead={`Start with the podcast. It is free and public. The club is where members work out the answers, with ${hostFirstName} and each other.`} />
</Page>

<script>
  /* Newest first is the page as served. Oldest reverses it in place; the cards keep their links and order of reading. */
  const order = document.querySelector('.order');
  const grid = document.querySelector('[data-episodes]');
  if (order instanceof HTMLElement && grid instanceof HTMLOListElement) {
    for (const button of order.querySelectorAll<HTMLButtonElement>('button[data-order]')) {
      button.addEventListener('click', () => {
        if (button.getAttribute('aria-pressed') === 'true') return;
        for (const other of order.querySelectorAll('button')) other.setAttribute('aria-pressed', String(other === button));
        order.style.setProperty('--i', button.dataset.order === 'oldest' ? '1' : '0');
        for (const card of [...grid.children].reverse()) grid.appendChild(card);
      });
    }
  }
</script>

<style>
  .show { display: grid; justify-items: center; gap: var(--space-3); padding-block: clamp(48px, 7vw, 96px) var(--space-7); text-align: center; }
  .show p, h1 { margin: 0; }
  h1 { width: clamp(260px, 40vw, 480px); margin-bottom: var(--space-4); line-height: 0; }
  h1 img { display: block; width: 100%; height: auto; }
  .line { font-size: var(--size-lead); }
  .cohosts { display: grid; justify-items: center; gap: var(--space-2); margin-top: var(--space-2); }
  .platform { display: inline-flex; align-items: center; gap: var(--space-2); margin-top: var(--space-3); font: 600 var(--size-small)/1 var(--font-sans); text-decoration: none; }
  .platform svg { width: 1.5em; height: 1.5em; fill: currentColor; }
  @media (hover: hover) { .platform:hover span { text-decoration: underline; text-decoration-thickness: var(--stroke-hair); } }
  .order { margin-top: var(--space-5); }
  .episodes { padding-block: 0 clamp(72px, 9vw, 128px); }
  .grid { display: grid; margin: 0; padding: var(--space-6) 0 0; list-style: none; border-top: var(--stroke-hair) solid var(--ink); }
  .grid > li { padding-block: 0 var(--space-7); }
  @media (min-width: 600px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); } }
  /* Equal columns, with the rule drawn in the middle of each gap, so every cover and title starts on the same line. */
  @media (min-width: 1000px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--space-7); }
    .grid > li { position: relative; }
    .grid > li:not(:nth-child(4n + 1))::before { content: ""; position: absolute; inset: 0 auto var(--space-7) calc(var(--space-7) / -2); border-inline-start: var(--stroke-hair) solid var(--ink); }
  }
  .empty { margin: 0; padding-top: var(--space-6); text-align: center; }
</style>
