---
import { actions, isInputError } from 'astro:actions';
import Page from '../layouts/Page.astro';
import { formAction } from '../lib/format.ts';
import { safeNext, socialPath } from '../server/paths.ts';

export const prerender = false;

const next = safeNext(Astro.url.searchParams.get('next'));
const signedOut = Astro.getActionResult(actions.signOut);
const result = Astro.getActionResult(actions.signIn);

/* With nowhere asked for, a member goes home: admins to the admin page, people only on Social to their profile. */
const socialHome = socialPath(Astro.url, '/me');
if (result?.data) return Astro.redirect(next !== '/members' ? next : !result.data.clubApproved ? socialHome : result.data.role === 'admin' ? '/admin' : next);
if (Astro.locals.member && !signedOut) return Astro.redirect(next === '/members' && !Astro.locals.member.clubApproved ? socialHome : next);

/* One account signs in to the club and to Social. Coming from Social, the page says so. */
const forSocial = next.startsWith('/social') || next.startsWith('http');

const error = result?.error && !isInputError(result.error) ? result.error.message : null;
---

<Page title="Sign in" noindex>
  <section class="night" aria-labelledby="page-title">
    <div class="wrap in">
      <div>
        <p class="label top">{forSocial ? 'Social' : 'Members'}</p>
        <h1 class="headline serif" id="page-title">{forSocial ? 'Sign in to Social.' : 'Sign in to the club.'}</h1>
        <p class="lead">{forSocial ? 'One account for Social and the club. Just joined? Use the link we emailed to set a password first.' : 'New member? Use the link in your invitation to set a password first.'}</p>
      </div>
      <form method="POST" action={formAction(Astro.url, actions.signIn)} class="form">
        {signedOut?.data && <p class="note" role="status">You have signed out.</p>}
        <div class="field">
          <label for="email">Email</label>
          <input class="input" id="email" name="email" type="email" autocomplete="username" required aria-invalid={error ? 'true' : undefined} aria-describedby={error ? 'form-error' : undefined} autofocus={error ? true : undefined} />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input class="input" id="password" name="password" type="password" autocomplete="current-password" required />
        </div>
        {error && <p class="error" id="form-error" role="alert">{error}</p>}
        <button class="btn" type="submit">Sign in</button>
        <p class="small">Forgot your password, or lost your invitation? <a href="/forgot">Get a new link by email</a>.</p>
        {forSocial ? <p class="small">New here? Social is invite-only. Use the link you were sent, or <a href={socialPath(Astro.url, '/request')}>request to join</a>.</p> : <p class="small">Not a member yet? <a href="/join">Request membership</a>.</p>}
      </form>
    </div>
  </section>
</Page>

<style>
  .in { display: grid; gap: var(--space-8); padding-block: clamp(32px, 4vw, 48px) clamp(80px, 10vw, 144px); }
  .top { margin: 0 0 var(--space-6); padding-bottom: var(--space-4); border-bottom: var(--stroke-hair) solid var(--ink); }
  .headline { margin: 0 0 var(--space-5); max-width: 10ch; font-size: var(--size-page); line-height: .98; }
  .lead { margin: 0; max-width: 36ch; }
  .form { display: grid; gap: var(--space-5); align-content: start; max-width: 440px; }
  .form .btn { justify-self: start; }
  .note, .error { margin: 0; font-weight: 600; }
  .error { color: var(--alert); }
  .small { margin: 0; }
  @media (min-width: 900px) { .in { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; } }
</style>
