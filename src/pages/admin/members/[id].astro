---
import { actions, isInputError } from 'astro:actions';
import LinkNotice from '../../../components/LinkNotice.astro';
import Masthead from '../../../components/Masthead.astro';
import Notice from '../../../components/Notice.astro';
import { roleLabel, statusLabel } from '../../../data/members.ts';
import Members from '../../../layouts/Members.astro';
import { formAction, formatDay } from '../../../lib/format.ts';
import { ROLES, memberNumber } from '../../../server/club.ts';

export const prerender = false;

const me = Astro.locals.member;
if (!me) return Astro.redirect('/sign-in');

const removed = Astro.getActionResult(actions.removeMember);
if (removed?.data) return Astro.redirect('/admin?removed');

const updated = Astro.getActionResult(actions.updateMember);
const suspended = Astro.getActionResult(actions.suspendMember);
const reinstated = Astro.getActionResult(actions.reinstateMember);
const issued = Astro.getActionResult(actions.newLink);

const id = Number(Astro.params.id);
const member = Number.isInteger(id) ? await Astro.locals.club.member(id) : null;
if (!member) return new Response(null, { status: 404, statusText: 'Not found' });

const self = member.id === me.id;
const fieldErrors = updated?.error && isInputError(updated.error) ? updated.error.fields : {};
const removeErrors = removed?.error && isInputError(removed.error) ? removed.error.fields : {};
const failure = [updated, suspended, reinstated, issued, removed]
  .map((r) => (r?.error && !isInputError(r.error) ? r.error.message : null))
  .find((message) => message !== null);
const done = updated?.data ? 'Saved.' : suspended?.data ? 'Suspended. They are signed out everywhere.' : reinstated?.data ? 'Reinstated. They can sign in with their password.' : null;

const [completed, postCount, standing] = await Promise.all([Astro.locals.club.completedLessons(member.id), Astro.locals.community.postCount(member.id), Astro.locals.billing.standing(member.id)]);
const lessonsDone = completed.size;
const facts = [
  { term: 'Member number', detail: memberNumber(member) },
  { term: 'Status', detail: statusLabel[member.status] },
  {
    term: 'Paid',
    detail: member.role === 'admin' ? 'Admins do not pay' : standing.paidUntil ? `Until ${formatDay(standing.paidUntil)}${standing.access === 'grace' ? ', renewal failing' : ''}${standing.cardOnFile && standing.renews ? ', renews by card' : ', not renewing'}` : 'Not yet',
  },
  { term: 'Role', detail: roleLabel[member.role] },
  { term: 'Since', detail: formatDay(member.joinedAt) },
  { term: 'Lessons done', detail: String(lessonsDone) },
  { term: 'Community posts', detail: String(postCount) },
];
const access = {
  invited: 'They have not set a password yet. A new invitation link replaces any earlier one.',
  active: 'They can sign in. A reset link lets them choose a new password and signs them out everywhere else.',
  suspended: 'They cannot sign in or use a link, and their sessions have ended. Reinstating lets them sign in with their existing password.',
} as const;
---

<Members title={member.name}>
  <Masthead label="Admin / Member" title={member.name}>
    <p><a href="/admin#members-title">All members</a></p>
  </Masthead>

  {issued?.data && <LinkNotice issued={issued.data} />}
  {done && <Notice>{done}</Notice>}
  {failure && <Notice tone="error">{failure}</Notice>}

  <section class="wrap block" aria-labelledby="facts-title">
    <h2 class="head" id="facts-title">On record</h2>
    <dl class="facts">{facts.map(({ term, detail }) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}</dl>
  </section>

  <section class="wrap block" aria-labelledby="details-title">
    <h2 class="head" id="details-title">Details</h2>
    <form method="POST" action={formAction(Astro.url, actions.updateMember)} class="form">
      <input type="hidden" name="member" value={member.id} />
      <div class="field">
        <label for="name">Name</label>
        <input class="input" id="name" name="name" value={member.name} maxlength="60" required aria-invalid={fieldErrors.name ? 'true' : undefined} />
        {fieldErrors.name?.[0] && <span class="error">{fieldErrors.name[0]}</span>}
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input class="input" id="email" name="email" type="email" value={member.email} required aria-invalid={fieldErrors.email ? 'true' : undefined} />
        <span class="hint">They sign in with this. Tell them when it changes.</span>
        {fieldErrors.email?.[0] && <span class="error">{fieldErrors.email[0]}</span>}
      </div>
      {
        self ? (
          <p class="small">You are an admin. Another admin can change your role.</p>
        ) : (
          <div class="field">
            <label for="role">Role</label>
            <select class="input" id="role" name="role">
              {ROLES.map((role) => <option value={role} selected={role === member.role}>{roleLabel[role]}</option>)}
            </select>
            <span class="hint">Admins can invite, edit, suspend and remove members, and moderate the community.</span>
          </div>
        )
      }
      <button class="btn" type="submit">Save</button>
    </form>
  </section>

  <section class="wrap block" aria-labelledby="access-title">
    <h2 class="head" id="access-title">Access</h2>
    <p class="note">{access[member.status]}</p>
    <div class="actions">
      {
        member.status !== 'suspended' && (
          <form method="POST" action={formAction(Astro.url, actions.newLink)}>
            <input type="hidden" name="member" value={member.id} />
            <button class="btn" type="submit">{member.status === 'invited' ? 'New invitation link' : 'Reset link'}</button>
          </form>
        )
      }
      {
        member.status === 'suspended' ? (
          <form method="POST" action={formAction(Astro.url, actions.reinstateMember)}>
            <input type="hidden" name="member" value={member.id} />
            <button class="btn" type="submit">Reinstate</button>
          </form>
        ) : (
          !self && (
            <form method="POST" action={formAction(Astro.url, actions.suspendMember)}>
              <input type="hidden" name="member" value={member.id} />
              <button class="btn ghost" type="submit">Suspend</button>
            </form>
          )
        )
      }
    </div>
  </section>

  {
    !self && (
      <section class="wrap block" aria-labelledby="remove-title">
        <h2 class="head" id="remove-title">Remove</h2>
        <p class="note">
          Removing deletes their account, lesson progress, open links and join request. It cannot be undone. Anything they posted in the community stays,
          shown as from a former member. To keep their record, suspend them instead.
        </p>
        <form method="POST" action={formAction(Astro.url, actions.removeMember)} class="form">
          <input type="hidden" name="member" value={member.id} />
          <label class="check">
            <input type="checkbox" name="confirm" value="yes" required aria-invalid={removeErrors.confirm ? 'true' : undefined} />
            <span>I understand {member.name} will be deleted for good.</span>
          </label>
          {removeErrors.confirm?.[0] && <span class="error">{removeErrors.confirm[0]}</span>}
          <button class="btn" type="submit">Remove member</button>
        </form>
      </section>
    )
  }
</Members>

<style>
  .block { display: grid; gap: var(--space-5); padding-block: clamp(48px, 6vw, 80px) 0; }
  .block > * { max-width: 720px; }
  .facts dd { overflow-wrap: anywhere; }
  .form { display: grid; gap: var(--space-5); max-width: 480px; }
  .form .btn { justify-self: start; }
  .note, .small { margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .actions form { margin: 0; }
  .check { display: flex; gap: var(--space-3); align-items: start; font-weight: 600; }
  .check input { width: 20px; height: 20px; margin: .1em 0 0; accent-color: var(--ink); flex: none; }
  .error { color: var(--alert); font-weight: 600; font-size: var(--size-small); }
</style>
