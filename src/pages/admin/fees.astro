---
import { actions } from 'astro:actions';
import Masthead from '../../components/Masthead.astro';
import Notice from '../../components/Notice.astro';
import Pager from '../../components/Pager.astro';
import { FEE_FIGURES, feeChoices, feeFigures, PUBLISH_MIN } from '../../data/fees.ts';
import Members from '../../layouts/Members.astro';
import { formAction, formatDay } from '../../lib/format.ts';
import { pageCount, pageHref, pagingOf } from '../../lib/paging.ts';
import type { Edition } from '../../server/fees.ts';

export const prerender = false;

const PAGE_SIZE = 50;

const published = Astro.getActionResult(actions.publishFees);
const unpublished = Astro.getActionResult(actions.unpublishFees);
const deleted = Astro.getActionResult(actions.deleteFeeResponse);
const failure = [published, unpublished, deleted].map((r) => r?.error?.message ?? null).find(Boolean) ?? null;

const { fees } = Astro.locals;
const [current, editions] = await Promise.all([fees.current(), fees.editions()]);
const asked = Number(Astro.url.searchParams.get('edition'));
const shown = editions.find((e) => e.edition === asked) ?? current;
const paging = pagingOf(Astro.url, PAGE_SIZE);
const { items, total } = await fees.review(shown.edition, { limit: paging.size, offset: paging.offset });
const pages = pageCount(total, paging.size);
if (paging.page > pages) return Astro.redirect(pageHref(Astro.url, pages));

const status = (e: Edition) =>
  e.status === 'published' && e.publishedAt
    ? `Published ${formatDay(e.publishedAt)}. Takes no more answers.`
    : `${e.status === 'open' ? 'Taking answers.' : 'Closed. Not published.'} ${e.publishable ? 'Ready to publish.' : `Needs ${PUBLISH_MIN - e.responses} more to publish.`}`;
const yearHref = (e: Edition) => `/admin/fees?edition=${e.edition}#answers-title`;
const rm = (n: number | null) => (n === null ? '' : `RM ${n.toLocaleString('en-MY')}`);
---

<Members title="Fee survey · Admin">
  <Masthead label="Admin" title="Fee survey">
    <p>
      Answers are anonymous. The form asks for no name or email, and nothing that says who sent them is kept. A year's
      results go up on <a href="/fees">the fee survey page</a> only when a host publishes it, which needs {PUBLISH_MIN} answers.
      Read them first and delete any that are plainly made up. Publishing this year's stops it taking answers until you
      take it down again.
    </p>
  </Masthead>

  {published?.data && <Notice>The {published.data.edition} results are up on <a href={`/fees?edition=${published.data.edition}#results`}>the fee survey page</a>.</Notice>}
  {unpublished?.data && <Notice>The {unpublished.data.edition} results are down. {unpublished.data.status === 'open' ? 'The survey takes answers again.' : ''}</Notice>}
  {deleted?.data && <Notice>Answer deleted. It no longer counts in the results.</Notice>}
  {failure && <Notice tone="error">{failure}</Notice>}

  <section class="wrap block" aria-labelledby="years-title">
    <h2 class="head" id="years-title">By year</h2>
    <div class="scroll">
      <table class="ledger years">
        <thead><tr><th>Year</th><th>Answers</th><th>Status</th><th><span class="sr">Results</span></th><th><span class="sr">Download</span></th></tr></thead>
        <tbody>
          {editions.map((e) => (
            <tr aria-current={e.edition === shown.edition ? 'true' : undefined}>
              <td><a href={yearHref(e)}>{e.edition}</a></td>
              <td>{e.responses}</td>
              <td>{status(e)}</td>
              <td class="act">
                {e.status === 'published' ? (
                  <form method="POST" action={formAction(Astro.url, actions.unpublishFees)}>
                    <input type="hidden" name="edition" value={e.edition} />
                    <button class="btn ghost" type="submit">Take down</button>
                  </form>
                ) : (
                  <form method="POST" action={formAction(Astro.url, actions.publishFees)}>
                    <input type="hidden" name="edition" value={e.edition} />
                    <button class="btn" type="submit" disabled={!e.publishable}>Publish</button>
                  </form>
                )}
                {e.responses > 0 && <a href={`/fees?edition=${e.edition}#results`}>{e.status === 'published' ? 'See them' : 'Preview'}</a>}
              </td>
              <td>{e.responses > 0 && <a href={`/admin/fees.csv?edition=${e.edition}`} download>CSV</a>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="answers-title">
    <h2 class="head" id="answers-title">{shown.edition} answers, newest first</h2>
    {
      items.length === 0 ? (
        <p class="empty">No answers for {shown.edition} yet. They appear here as people send them from the fee survey page.</p>
      ) : (
        <>
          <p class="small">A figure far from most answers for that fee is <mark class="mark">marked</mark>, so the ones worth a second look stand out.</p>
          <div class="scroll">
            <table class="ledger answers">
              <thead>
                <tr>
                  <th>Received</th>
                  <th>Practice</th>
                  <th>Pricing</th>
                  {FEE_FIGURES.map((figure) => <th>{feeFigures[figure].label}</th>)}
                  <th>Sure (1 to 5)</th>
                  <th><span class="sr">Delete</span></th>
                </tr>
              </thead>
              <tbody>
                {items.map((r) => (
                  <tr>
                    <td>{formatDay(r.createdAt)}</td>
                    <td class="practice">
                      {feeChoices.stage.labelOf(r.stage)}. {feeChoices.years.labelOf(r.years)} in practice. {feeChoices.team.labelOf(r.team)} in the team. {r.state}. {r.niche ? 'Serves a niche.' : 'Generalist.'}
                    </td>
                    <td>{feeChoices.pricing.labelOf(r.pricing)}</td>
                    {FEE_FIGURES.map((figure) =>
                      r.unusual.includes(figure) ? (
                        <td><mark class="mark">{rm(r.fees[figure])}</mark><span class="sr"> (far from most answers)</span></td>
                      ) : (
                        <td>{rm(r.fees[figure])}</td>
                      ),
                    )}
                    <td>{r.confidence}</td>
                    <td>
                      <details class="confirm">
                        <summary>Delete</summary>
                        <form method="POST" action={formAction(Astro.url, actions.deleteFeeResponse)}>
                          <input type="hidden" name="answer" value={r.id} />
                          <button class="btn" type="submit">Delete for good</button>
                        </form>
                      </details>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <Pager url={Astro.url} page={paging.page} pages={pages} label={`${shown.edition} answer pages`} />
        </>
      )
    }
  </section>
</Members>

<style>
  .block { display: grid; gap: var(--space-5); padding-block: clamp(48px, 6vw, 80px) 0; }
  .scroll { position: relative; overflow-x: auto; }
  .years { min-width: 640px; }
  .answers { min-width: 960px; }
  .years td:nth-child(3), .years th:nth-child(3), .answers .practice, .answers th:nth-child(2) { text-align: start; white-space: normal; }
  .years tr[aria-current] td:first-child { font-weight: 700; }
  .act { display: flex; align-items: center; justify-content: end; gap: var(--space-4); }
  .act form { margin: 0; }
  .act .btn, .confirm .btn { min-height: 36px; padding: .4em .8em; font-size: var(--size-small); }
  .practice { min-width: 18rem; }
  .confirm summary { cursor: pointer; text-decoration: underline; text-underline-offset: .2em; }
  .confirm form { margin: var(--space-2) 0 0; }
  .empty { margin: 0; padding-block: var(--space-5); border-block: var(--stroke-hair) solid var(--ink); }
  .small { margin: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
