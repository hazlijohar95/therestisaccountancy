---
import { actions, isInputError } from 'astro:actions';
import Masthead from '../../components/Masthead.astro';
import Notice from '../../components/Notice.astro';
import { SESSION_KINDS } from '../../data/sessions.ts';
import Members from '../../layouts/Members.astro';
import { postedFields } from '../../lib/form.ts';
import { formAction, formatMoment, listOf } from '../../lib/format.ts';

export const prerender = false;

const added = Astro.getActionResult(actions.addSession);
const cancelled = Astro.getActionResult(actions.cancelSession);
if (added?.data) return Astro.redirect('/admin/sessions?added');

const fieldErrors = added?.error && isInputError(added.error) ? added.error.fields : {};
const failure = [added, cancelled].map((r) => (r?.error && !isInputError(r.error) ? r.error.message : null)).find(Boolean) ?? null;
const posted = added?.error ? await postedFields(Astro.request) : () => '';

const { schedule } = Astro.locals;
const upcoming = await schedule.upcoming(null);
const rolls = await Promise.all(upcoming.map((s) => schedule.attendees(s.id)));
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kuala_Lumpur' }).format(new Date());
const told = cancelled?.data?.told ?? 0;
---

<Members title="Sessions · Admin">
  <Masthead label="Admin" title="Sessions">
    <p>Put a session on the calendar and members see it, say whether they are coming, and get a calendar file and a reminder the day before. Times are Malaysia time.</p>
  </Masthead>

  {Astro.url.searchParams.has('added') && <Notice>Session added. Members see it now.</Notice>}
  {cancelled?.data && <Notice>Session called off. {told === 0 ? 'Nobody had said they were coming.' : told === 1 ? 'The one member coming has been emailed.' : `The ${told} members coming have been emailed.`}</Notice>}
  {failure && <Notice tone="error">{failure}</Notice>}

  <section class="wrap block" aria-labelledby="upcoming-title">
    <h2 class="head" id="upcoming-title">On the calendar</h2>
    {
      upcoming.length === 0 ? (
        <p class="empty">Nothing scheduled.</p>
      ) : (
        <ol class="sessions">
          {upcoming.map((s, i) => (
            <li class="session">
              <div class="small">{formatMoment(s.startsAt)} · {s.minutes} min · {s.kind}</div>
              <h3 class="title">{s.title}</h3>
              <p class="small">{s.going === 0 ? 'Nobody coming yet.' : `Coming: ${listOf((rolls[i] ?? []).map((m) => m.name))}.`}</p>
              <details class="confirm">
                <summary>Call it off</summary>
                <form method="POST" action={formAction(Astro.url, actions.cancelSession)}>
                  <input type="hidden" name="session" value={s.id} />
                  <span class="small">Everyone coming gets an email saying it is off.</span>
                  <button class="btn" type="submit">Call it off</button>
                </form>
              </details>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <section class="wrap block" aria-labelledby="add-title">
    <h2 class="head" id="add-title">Add a session</h2>
    <form method="POST" action={formAction(Astro.url, actions.addSession)} class="form">
      <div class="field">
        <label for="title">Title</label>
        <input class="input" id="title" name="title" required maxlength="120" value={posted('title')} aria-invalid={fieldErrors.title ? 'true' : undefined} />
        {fieldErrors.title?.[0] && <span class="error">{fieldErrors.title[0]}</span>}
      </div>
      <div class="field">
        <label for="kind">Kind</label>
        <select class="input" id="kind" name="kind">{SESSION_KINDS.map((k) => <option selected={posted('kind') === k}>{k}</option>)}</select>
      </div>
      <div class="pair">
        <div class="field">
          <label for="date">Date</label>
          <input class="input" id="date" name="date" type="date" min={today} required value={posted('date')} aria-invalid={fieldErrors.date ? 'true' : undefined} />
          {fieldErrors.date?.[0] && <span class="error">{fieldErrors.date[0]}</span>}
        </div>
        <div class="field">
          <label for="time">Start, Malaysia time</label>
          <input class="input" id="time" name="time" type="time" required value={posted('time')} aria-invalid={fieldErrors.time ? 'true' : undefined} />
          {fieldErrors.time?.[0] && <span class="error">{fieldErrors.time[0]}</span>}
        </div>
      </div>
      <div class="field">
        <label for="minutes">Length in minutes</label>
        <input class="input" id="minutes" name="minutes" type="number" min="15" max="480" step="5" required value={posted('minutes') || '60'} aria-invalid={fieldErrors.minutes ? 'true' : undefined} />
        {fieldErrors.minutes?.[0] && <span class="error">{fieldErrors.minutes[0]}</span>}
      </div>
      <div class="field">
        <label for="link">Call link</label>
        <input class="input" id="link" name="link" type="url" placeholder="https://" required value={posted('link')} aria-invalid={fieldErrors.link ? 'true' : undefined} />
        <span class="hint">Only members see it.</span>
        {fieldErrors.link?.[0] && <span class="error">{fieldErrors.link[0]}</span>}
      </div>
      <div class="field">
        <label for="detail">What it covers <span class="hint">(optional)</span></label>
        <textarea class="input" id="detail" name="detail" rows="4" maxlength="1000">{posted('detail')}</textarea>
        {fieldErrors.detail?.[0] && <span class="error">{fieldErrors.detail[0]}</span>}
      </div>
      <button class="btn" type="submit">Add session</button>
    </form>
  </section>
</Members>

<style>
  .block { display: grid; gap: var(--space-5); padding-block: clamp(48px, 6vw, 80px) 0; }
  .sessions { display: grid; margin: 0; padding: 0; list-style: none; border-top: var(--stroke-rule) solid var(--ink); }
  .session { display: grid; gap: var(--space-2); padding-block: var(--space-5); border-bottom: var(--stroke-hair) solid var(--ink); }
  .session .small, .title { margin: 0; }
  .title { font-size: var(--size-head); line-height: 1.2; }
  .confirm summary { cursor: pointer; text-decoration: underline; text-underline-offset: .2em; width: fit-content; }
  .confirm form { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin: var(--space-3) 0 0; }
  .confirm .btn { min-height: 36px; padding: .4em .8em; font-size: var(--size-small); }
  .form { display: grid; gap: var(--space-5); max-width: 560px; }
  .form .btn { justify-self: start; }
  .pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: var(--space-5); }
  textarea.input { resize: vertical; line-height: 1.5; }
  .error { color: var(--alert); font-weight: 600; }
  .empty { margin: 0; padding-block: var(--space-5); border-block: var(--stroke-hair) solid var(--ink); }
</style>
