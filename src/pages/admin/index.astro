---
import { actions } from 'astro:actions';
import LinkNotice from '../../components/LinkNotice.astro';
import Masthead from '../../components/Masthead.astro';
import Notice from '../../components/Notice.astro';
import Pager from '../../components/Pager.astro';
import { roleLabel, statusLabel } from '../../data/members.ts';
import Members from '../../layouts/Members.astro';
import { formAction, formatDay } from '../../lib/format.ts';
import { pageCount, pageHref, pagingOf } from '../../lib/paging.ts';
import { LINK_DAYS, MEMBER_STATUSES, memberNumber, type MemberStatus } from '../../server/club.ts';

export const prerender = false;

const PAGE_SIZE = 50;
const DECIDED_SHOWN = 20;

const invited = Astro.getActionResult(actions.invite);
const declined = Astro.getActionResult(actions.decline);
const failure = invited?.error?.message ?? declined?.error?.message ?? null;
const removed = Astro.url.searchParams.has('removed');

const { club } = Astro.locals;
const [pending, decided] = await Promise.all([club.joinRequests({ decided: false }), club.joinRequests({ decided: true, limit: DECIDED_SHOWN })]);

const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const askedStatus = Astro.url.searchParams.get('status');
const status = MEMBER_STATUSES.find((s) => s === askedStatus);
const paging = pagingOf(Astro.url, PAGE_SIZE);
const { items: members, total } = await club.members({ query, status, limit: paging.size, offset: paging.offset });
const pages = pageCount(total, paging.size);
if (paging.page > pages) return Astro.redirect(pageHref(Astro.url, pages));

const counts = await club.memberCounts();
const everyone = counts.invited + counts.active + counts.suspended;
const filterHref = (next: MemberStatus | undefined) => {
  const target = new URL('/admin', Astro.url);
  if (query) target.searchParams.set('q', query);
  if (next) target.searchParams.set('status', next);
  return `${target.pathname}${target.search}#members-title`;
};
const filters = [
  { label: `All ${everyone}`, href: filterHref(undefined), current: status === undefined },
  ...MEMBER_STATUSES.map((s) => ({ label: `${statusLabel[s]} ${counts[s]}`, href: filterHref(s), current: status === s })),
];
const waiting = pending.length === 1 ? 'One request waiting.' : pending.length === 0 ? 'No requests waiting.' : `${pending.length} requests waiting.`;
---

<Members title="Admin">
  <Masthead label="Admin" title={waiting}>
    <p>
      Invite someone and the club makes them a member with a private link to set a password, emailed to
      them. It works once and lasts {LINK_DAYS.welcome} days. Open a member to edit them, send a reset link, suspend or remove them.
    </p>
    <p class="tools"><a href="/admin/sessions">Sessions</a> <a href="/admin/members.csv" download>Download members (CSV)</a></p>
  </Masthead>

  {invited?.data && <LinkNotice issued={invited.data} />}
  {declined?.data && <Notice>Request declined.</Notice>}
  {removed && <Notice>Member removed.</Notice>}
  {failure && <Notice tone="error">{failure}</Notice>}

  <section class="wrap block" aria-labelledby="pending-title">
    <h2 class="head" id="pending-title">Waiting for a decision</h2>
    {
      pending.length === 0 ? (
        <p class="empty">Nothing waiting. New requests from the join form appear here.</p>
      ) : (
        <div class="scroll">
          <table class="ledger">
            <thead><tr><th>Name</th><th>Email</th><th>Where they are</th><th>Received</th><th><span class="sr">Decision</span></th></tr></thead>
            <tbody>
              {pending.map((r) => (
                <tr>
                  <td>{r.name}</td>
                  <td>{r.email}</td>
                  <td>{r.stage}</td>
                  <td>{formatDay(r.createdAt)}</td>
                  <td class="decide">
                    <form method="POST" action={formAction(Astro.url, actions.invite)}><input type="hidden" name="request" value={r.id} /><button class="btn" type="submit">Invite</button></form>
                    <form method="POST" action={formAction(Astro.url, actions.decline)}><input type="hidden" name="request" value={r.id} /><button class="btn ghost" type="submit">Decline</button></form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <section class="wrap block" aria-labelledby="members-title">
    <h2 class="head" id="members-title">Members</h2>
    <form method="GET" action="/admin#members-title" class="search" role="search">
      {status && <input type="hidden" name="status" value={status} />}
      <label class="sr" for="q">Search members</label>
      <input class="input" id="q" name="q" type="search" value={query} placeholder="Name or email" maxlength="100" />
      <button class="btn ghost" type="submit">Search</button>
    </form>
    <nav class="filters" aria-label="Filter members by status">
      {filters.map((f) => <a href={f.href} aria-current={f.current ? 'page' : undefined}>{f.label}</a>)}
    </nav>
    {
      members.length === 0 ? (
        <p class="empty">{query ? `No member matches “${query}”.` : 'No members with that status.'}</p>
      ) : (
        <div class="scroll">
          <table class="ledger">
            <thead><tr><th>No.</th><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Since</th></tr></thead>
            <tbody>
              {members.map((m) => (
                <tr>
                  <td>{memberNumber(m)}</td>
                  <td><a href={`/admin/members/${m.id}`}>{m.name}</a></td>
                  <td>{m.email}</td>
                  <td>{roleLabel[m.role]}</td>
                  <td>{statusLabel[m.status]}</td>
                  <td>{formatDay(m.joinedAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
    <Pager url={Astro.url} page={paging.page} pages={pages} label="Member pages" />
  </section>

  {
    decided.length > 0 && (
      <section class="wrap block" aria-labelledby="decided-title">
        <h2 class="head" id="decided-title">Recent decisions</h2>
        <div class="scroll">
          <table class="ledger">
            <thead><tr><th>Name</th><th>Email</th><th>Where they are</th><th>Decision</th></tr></thead>
            <tbody>
              {decided.map((r) => (
                <tr><td>{r.name}</td><td>{r.email}</td><td>{r.stage}</td><td>{r.status === 'invited' ? 'Invited' : 'Declined'}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</Members>

<style>
  .block { display: grid; gap: var(--space-5); padding-block: clamp(48px, 6vw, 80px) 0; }
  .scroll { position: relative; overflow-x: auto; }
  .ledger { min-width: 640px; }
  .ledger td:not(:first-child), .ledger th:not(:first-child) { text-align: start; white-space: normal; }
  .ledger td { overflow-wrap: anywhere; }
  .decide { display: flex; gap: var(--space-2); justify-content: end; }
  .decide form { margin: 0; }
  .decide .btn { min-height: 36px; padding: .4em .8em; font-size: var(--size-small); }
  .empty { margin: 0; padding-block: var(--space-5); border-block: var(--stroke-hair) solid var(--ink); }
  .search { display: flex; flex-wrap: wrap; gap: var(--space-3); max-width: 560px; }
  .search .input { flex: 1 1 14rem; }
  .filters { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); font: 600 var(--size-small)/1.4 var(--font-sans); }
  .filters a { text-decoration: none; }
  .filters a[aria-current="page"] { text-decoration: underline; text-underline-offset: .3em; }
  .tools { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); font-weight: 600; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
