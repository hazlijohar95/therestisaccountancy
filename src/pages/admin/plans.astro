---
import { actions, isInputError } from 'astro:actions';
import Masthead from '../../components/Masthead.astro';
import Notice from '../../components/Notice.astro';
import PlanLetter from '../../components/PlanLetter.astro';
import { PLAN_REPLY_MAX } from '../../data/plan.ts';
import Members from '../../layouts/Members.astro';
import { postedFields } from '../../lib/form.ts';
import { capitalised, firstName, formAction, formatDay, formatMoment, numberWord } from '../../lib/format.ts';
import { waited } from '../../server/plans.ts';

export const prerender = false;

const ANSWERED_SHOWN = 20;

const answer = Astro.getActionResult(actions.answerPlan);
if (answer?.data) return Astro.redirect('/admin/plans?answered');

const fieldErrors = answer?.error && isInputError(answer.error) ? answer.error.fields : {};
const failure = answer?.error && !isInputError(answer.error) ? answer.error.message : null;
const posted = answer?.error ? await postedFields(Astro.request) : () => '';
const postedPlan = Number(posted('plan'));
/* A refused answer's plan has left the list, so its text is shown back here rather than lost with the form. */
const unsent = failure ? posted('reply') : '';

const { plans } = Astro.locals;
const [waiting, answered] = await Promise.all([plans.waiting(), plans.answered(ANSWERED_SHOWN)]);
const now = new Date();
const title = waiting.length === 0 ? 'No plans waiting.' : waiting.length === 1 ? 'One plan waiting.' : `${capitalised(numberWord(waiting.length))} plans waiting.`;
---

<Members title="Plans · Admin">
  <Masthead label="Admin" title={title}>
    <p>
      A member sends their plan once every section is written. Read it, then answer in writing. They get your answer by email, from you, and the
      plan closes. Until you answer, they can take it back to change it.
    </p>
  </Masthead>

  {!answer?.error && Astro.url.searchParams.has('answered') && <Notice>Answer sent. The member has it by email, from you.</Notice>}
  {failure && <Notice tone="error">{failure}</Notice>}
  {answer?.error && !failure && <Notice tone="error">Your answer was not sent. The note under it says why.</Notice>}
  {
    unsent && (
      <section class="wrap block">
        <div class="field unsent">
          <label for="unsent">Your answer, not sent. Copy it if you want to keep it.</label>
          <textarea class="input" id="unsent" rows="8" readonly>{unsent}</textarea>
        </div>
      </section>
    )
  }

  <section class="wrap block" aria-labelledby="waiting-title">
    <h2 class="head" id="waiting-title">Waiting for an answer</h2>
    {
      waiting.length === 0 ? (
        <p class="empty">Nothing waiting. Plans appear here as members send them, the one waiting longest first.</p>
      ) : (
        <>
          <div class="scroll">
            <table class="ledger">
              <thead><tr><th>Member</th><th>Sent</th><th>Waiting</th><th><span class="sr">Plan</span></th></tr></thead>
              <tbody>
                {waiting.map((p) => (
                  <tr>
                    <td><a href={`/admin/members/${p.member.id}`}>{p.member.name}</a></td>
                    <td>{formatDay(p.sentAt)}</td>
                    <td>{capitalised(waited(p.sentAt, now))}</td>
                    <td><a href={`#plan-${p.id}`}>Read and answer</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {waiting.map((p) => {
            const error = postedPlan === p.id ? fieldErrors.reply?.[0] : undefined;
            const hint = `reply-${p.id}-hint`;
            return (
              <article class="plan" id={`plan-${p.id}`} aria-labelledby={`plan-${p.id}-title`}>
                <header class="who">
                  <h3 class="title" id={`plan-${p.id}-title`}><a href={`/admin/members/${p.member.id}`}>{p.member.name}</a></h3>
                  <p class="small">Sent {formatMoment(p.sentAt)}. Waiting {waited(p.sentAt, now)}.</p>
                </header>
                <PlanLetter plan={p} level={4} />
                <form method="POST" action={`${formAction(Astro.url, actions.answerPlan)}#plan-${p.id}`} class="reply">
                  <input type="hidden" name="plan" value={p.id} />
                  <div class="field">
                    <label for={`reply-${p.id}`}>Your answer to {firstName(p.member.name)}</label>
                    <textarea
                      class="input"
                      id={`reply-${p.id}`}
                      name="reply"
                      rows="10"
                      required
                      maxlength={PLAN_REPLY_MAX}
                      aria-describedby={error ? `${hint} reply-${p.id}-error` : hint}
                      aria-invalid={error ? 'true' : undefined}
                    >{postedPlan === p.id ? posted('reply') : ''}</textarea>
                    <span class="hint" id={hint}>Plain text. Leave a blank line between paragraphs. It goes to them by email, from you, and closes the plan, so it cannot be changed after.</span>
                    {error && <span class="error" id={`reply-${p.id}-error`}>{error}</span>}
                  </div>
                  <button class="btn" type="submit">Send the answer</button>
                </form>
              </article>
            );
          })}
        </>
      )
    }
  </section>

  <section class="wrap block" aria-labelledby="answered-title">
    <h2 class="head" id="answered-title">Answered</h2>
    {
      answered.length === 0 ? (
        <p class="empty">No plans answered yet.</p>
      ) : (
        <div class="answered">
          {answered.length === ANSWERED_SHOWN && <p class="small">The {ANSWERED_SHOWN} most recent.</p>}
          {answered.map((p) => (
            <details class="done">
              <summary>
                <b>{p.member.name}</b>
                <span class="small">Answered {formatDay(p.reply.at)} by {p.reply.by ?? 'a host'}</span>
              </summary>
              <div class="body">
                <p class="small"><a href={`/admin/members/${p.member.id}`}>{p.member.name}, on record</a>. Sent {formatDay(p.sentAt)}.</p>
                <PlanLetter plan={p} level={3} />
              </div>
            </details>
          ))}
        </div>
      )
    }
  </section>
</Members>

<style>
  .block { display: grid; gap: var(--space-6); padding-block: clamp(48px, 6vw, 80px) 0; }
  .scroll { overflow-x: auto; }
  .ledger { min-width: 520px; }
  .plan { display: grid; gap: var(--space-6); padding-block: var(--space-7); border-top: var(--stroke-heavy) solid var(--ink); scroll-margin-top: calc(var(--bar) + 24px); }
  .who { display: grid; gap: var(--space-2); }
  .who .title, .who p { margin: 0; }
  .title { font-size: var(--size-head); line-height: 1.2; overflow-wrap: anywhere; }
  .reply { display: grid; gap: var(--space-4); max-width: 720px; }
  .reply .btn { justify-self: start; }
  textarea.input { min-height: 12rem; resize: vertical; line-height: 1.5; }
  .error { color: var(--alert); font-weight: 600; }
  .unsent { max-width: 720px; }
  .answered { border-top: var(--stroke-rule) solid var(--ink); }
  .answered > p { margin: 0; padding-block: var(--space-3); border-bottom: var(--stroke-hair) solid var(--ink); }
  .done { border-bottom: var(--stroke-hair) solid var(--ink); }
  .done summary { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-4); padding-block: var(--space-4); cursor: pointer; }
  .done summary b { overflow-wrap: anywhere; }
  .body { display: grid; gap: var(--space-5); padding-bottom: var(--space-6); }
  .body > p { margin: 0; }
  .empty { margin: 0; padding-block: var(--space-5); border-block: var(--stroke-hair) solid var(--ink); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
