---
import PageHead from '../components/PageHead.astro';
import { authorPath, authors, roleOf } from '../data/authors.ts';
import { columnPath, columns } from '../data/columns.ts';
import { products } from '../data/products.ts';
import { programmePath, programmes } from '../data/programmes.ts';
import Page from '../layouts/Page.astro';
import { SEARCH_MAX } from '../lib/search.ts';
import { searchSite, type Entry } from '../lib/site-search.ts';
import { allPacks, packName, packPath } from '../server/packs.ts';
import { allPosts, postPath } from '../server/posts.ts';

export const prerender = false;

/* Members-only posts are found by their title and dek only, which everyone can already read. */
const query = (Astro.url.searchParams.get('q') ?? '').slice(0, SEARCH_MAX);
const entries: Entry[] = [
  ...(await allPosts()).map((post) => ({ kind: 'Posts' as const, title: post.data.title.replaceAll('*', ''), summary: post.data.dek, href: postPath(post) })),
  ...programmes.map((p) => ({ kind: 'Programmes' as const, title: p.name, summary: p.promise, keywords: p.topics.join(' · '), href: programmePath(p) })),
  ...products.map((p) => ({ kind: 'Products' as const, title: p.name, summary: p.summary, keywords: p.question, href: p.href })),
  ...(await allPacks()).map((pack) => ({ kind: 'Packs' as const, title: packName(pack), summary: pack.programme.promise, href: packPath(pack) })),
  ...columns.map((c) => ({ kind: 'Columns' as const, title: c.name, summary: c.tagline, href: c.slug === 'podcast' ? ('/podcast' as const) : columnPath(c) })),
  ...authors.map((a) => ({ kind: 'People' as const, title: a.name, summary: `${roleOf(a)}, Stick to Accounting`, href: authorPath(a) })),
];
const groups = searchSite(entries, query);
const total = groups?.reduce((n, group) => n + group.entries.length, 0) ?? 0;
---

<Page title={query ? `Search: ${query}` : 'Search'} description="Search The Rest Is Accountancy: posts, programmes, products, packs, columns and people." noindex={Boolean(query)}>
  <PageHead label="Search" title="What are you looking for?">
    <form class="find" action="/search" method="get" role="search">
      <label class="visually-hidden" for="q">Search posts, programmes, products and people</label>
      <input id="q" name="q" type="search" value={query} maxlength={SEARCH_MAX} autocomplete="off" placeholder="Posts, programmes, products, people" autofocus={!query} />
      <button class="btn" type="submit">Search</button>
    </form>
  </PageHead>
  <section class="wrap results" aria-label="Results">
    {groups && <p class="small count" role="status">{total ? `${total} ${total === 1 ? 'result' : 'results'} for “${query}”.` : `Nothing matches “${query}”. Try a shorter word.`}</p>}
    {
      groups?.map((group) => (
        <section class="group" aria-labelledby={`g-${group.kind}`}>
          <h2 class="label" id={`g-${group.kind}`}>{group.kind}</h2>
          <ul>
            {group.entries.map((entry) => (
              <li>
                <a href={entry.href}>{entry.title}</a>
                <span class="small">{entry.summary}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</Page>

<style>
  .results { display: grid; gap: var(--space-6); padding-block: var(--space-7) var(--space-9); }
  .results:not(:has(*)) { display: none; }
  .find { display: flex; gap: var(--space-3); width: min(100%, 720px); }
  .find input { flex: 1; min-width: 0; }
  .count { margin: 0; }
  .group { display: grid; gap: var(--space-3); max-width: 720px; }
  .group h2 { margin: 0; padding-bottom: var(--space-2); border-bottom: var(--stroke-hair) solid var(--ink); }
  ul { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  li { display: grid; gap: var(--space-1); }
  li a { font: 400 var(--size-lead)/1.25 var(--font-serif); text-decoration: none; }
  @media (hover: hover) { li a:hover { text-decoration: underline; text-decoration-thickness: var(--stroke-hair); text-underline-offset: 4px; } }
</style>
