---
import { actions } from 'astro:actions';
import { getEntry, render } from 'astro:content';
import TemplateList from '../../../components/TemplateList.astro';
import { programmeBySlug } from '../../../data/programmes.ts';
import Members from '../../../layouts/Members.astro';
import { formAction } from '../../../lib/format.ts';
import { lessonPath, lessonsOf } from '../../../server/lessons.ts';
import { resourcesOf } from '../../../server/resources.ts';

export const prerender = false;

const member = Astro.locals.member;
const lesson = await getEntry('lessons', Astro.params.id ?? '');
if (!member) return Astro.redirect('/sign-in');
if (!lesson) return new Response(null, { status: 404, statusText: 'Not found' });

const programme = programmeBySlug(lesson.data.programme);
const siblings = await lessonsOf(lesson.data.programme);
const at = siblings.findIndex((l) => l.id === lesson.id);
const previous = siblings[at - 1];
const next = siblings[at + 1];
const done = (await Astro.locals.club.completedLessons(member.id)).has(lesson.id);
const templates = await resourcesOf(lesson.data.programme, lesson.data.module);
const { Content } = await render(lesson);
---

<Members title={lesson.data.title}>
  <section class="night">
    <div class="wrap masthead">
      <p class="label top"><a href={`/members/programmes/${lesson.data.programme}`}>{programme?.name}</a> / Module {lesson.data.module} · {programme?.topics[lesson.data.module - 1]}</p>
      <h1 class="headline serif">{lesson.data.title}</h1>
      <p class="small">{lesson.data.minutes} minute read</p>
    </div>
  </section>
  <article class="wrap body">
    <div class="prose"><Content /></div>
    {
      templates.length > 0 && (
        <section class="templates" aria-labelledby="templates-title">
          <h2 class="label" id="templates-title">Templates for this module</h2>
          <TemplateList items={templates} />
        </section>
      )
    }
    <form method="POST" action={formAction(Astro.url, actions.lessonDone)} class="done">
      <input type="hidden" name="lesson" value={lesson.id} />
      <input type="hidden" name="done" value={done ? 'false' : 'true'} />
      <p>{done ? 'You marked this lesson done.' : 'Finished it?'}</p>
      <button class:list={['btn', { ghost: done }]} type="submit">{done ? 'Mark as not done' : 'Mark as done'}</button>
    </form>
    <nav class="pager" aria-label="Other lessons">
      {previous ? <a href={lessonPath(previous)}><span class="label">Previous</span><span class="serif">{previous.data.title}</span></a> : <span></span>}
      {next && <a class="next" href={lessonPath(next)}><span class="label">Next</span><span class="serif">{next.data.title}</span></a>}
    </nav>
  </article>
</Members>

<style>
  .masthead { display: grid; gap: var(--space-4); padding-block: clamp(32px, 4vw, 48px) clamp(48px, 6vw, 80px); }
  .top { margin: 0 0 var(--space-4); padding-bottom: var(--space-4); border-bottom: var(--stroke-hair) solid var(--ink); }
  .top a { text-decoration: none; }
  .headline { margin: 0; max-width: 16ch; font-size: clamp(2.5rem, 1.2rem + 4.4vw, 5rem); line-height: 1; letter-spacing: -.035em; text-wrap: balance; }
  .masthead .small { margin: 0; }
  .body { display: grid; gap: var(--space-8); padding-block: clamp(48px, 6vw, 96px); }
  .body > * { max-width: 68ch; }
  .prose { font-size: var(--size-lead); line-height: 1.6; }
  .prose :global(h2) { margin: var(--space-7) 0 var(--space-3); font: 400 var(--size-head)/1.1 var(--display-font); letter-spacing: var(--display-tracking); font-synthesis: none; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 var(--space-4); }
  .prose :global(li) { margin-bottom: var(--space-2); }
  .templates h2 { margin: 0 0 var(--space-3); }
  .done { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-5); border-block: var(--stroke-rule) solid var(--ink); }
  .done p { margin: 0; font-weight: 600; }
  .pager { display: flex; justify-content: space-between; gap: var(--space-5); }
  .pager a { display: grid; gap: var(--space-1); text-decoration: none; }
  .pager .serif { font-size: var(--size-head); line-height: 1.1; }
  .next { text-align: end; }
</style>
