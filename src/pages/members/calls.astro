---
import { actions, isInputError } from 'astro:actions';
import Masthead from '../../components/Masthead.astro';
import Notice from '../../components/Notice.astro';
import { hostFirstName } from '../../data/authors.ts';
import Members from '../../layouts/Members.astro';
import { postedFields } from '../../lib/form.ts';
import { firstName, formAction, formatTime, formatWeekday } from '../../lib/format.ts';
import { byDay, TOPIC_MAX } from '../../server/calls.ts';

export const prerender = false;

const me = Astro.locals.member;
if (!me) return Astro.redirect('/sign-in');
const booked = Astro.getActionResult(actions.bookCall);
const cancelled = Astro.getActionResult(actions.cancelCall);
if (booked?.data) return Astro.redirect('/members/calls?booked');
if (cancelled?.data) return Astro.redirect('/members/calls?cancelled');

const fieldErrors = booked?.error && isInputError(booked.error) ? booked.error.fields : {};
const failure = [booked, cancelled].map((r) => (r?.error && !isInputError(r.error) ? r.error.message : null)).find(Boolean) ?? null;
const posted = booked?.error ? await postedFields(Astro.request) : () => '';

const mine = await Astro.locals.calls.booking(me.id);
const days = byDay(await Astro.locals.calls.open(me.id));
const started = mine !== null && new Date(mine.startsAt).getTime() <= Date.now();
/* A member holding a call still sees the other times, as a list with nothing to pick: one call at a time. */
const Slot = mine ? 'div' : 'label';
---

<Members title="One-to-one">
  <Masthead label="One-to-one" title={`Stuck? Talk it through with ${hostFirstName}.`} narrow>
    <p>Bring the quote you can't price, the client you can't read or the decision you keep putting off. Say what it is when you book, so {hostFirstName} comes ready.</p>
  </Masthead>

  {Astro.url.searchParams.has('booked') && mine && <Notice>Booked. A confirmation with the calendar invite is on its way to {me.email}.</Notice>}
  {Astro.url.searchParams.has('cancelled') && !mine && <Notice>Cancelled. {hostFirstName} has been told.</Notice>}
  {failure && <Notice tone="error">{failure}</Notice>}

  {
    mine && (
      <section class="wrap block" aria-labelledby="mine-title">
        <h2 class="head" id="mine-title">Your call</h2>
        <div class="call">
          <p class="small">
            <time datetime={mine.startsAt}>{formatWeekday(mine.startsAt)}, {formatTime(mine.startsAt)}</time> · {mine.minutes} min{started && <b> · On now</b>}
          </p>
          <h3 class="title">With {mine.host.name}</h3>
          <p class="topic"><span class="label">You said</span> {mine.booking.topic}</p>
          <div class="row">
            <a class="btn" href={mine.link} rel="noopener">Join the call</a>
            <a href={`/members/calls/${mine.id}.ics`}>Add to calendar</a>
          </div>
          <details class="confirm">
            <summary>Cancel the call</summary>
            <form method="POST" action={formAction(Astro.url, actions.cancelCall)}>
              <input type="hidden" name="slot" value={mine.id} />
              <span class="small">
                {firstName(mine.host.name)} gets an email saying you can't make it. Cancel more than two hours ahead and the time goes back on the list for someone else.
              </span>
              <button class="btn" type="submit">Cancel the call</button>
            </form>
          </details>
        </div>
      </section>
    )
  }

  <section class="wrap block" aria-labelledby="open-title">
    <h2 class="head" id="open-title">{mine ? 'Other open times' : 'Book a call'}</h2>
    {
      days.length === 0 ? (
        <p class="empty">
          No open times right now. New ones appear here as {hostFirstName} adds them. Until then, the <a href="/members/community">members' room</a> is open all week.
        </p>
      ) : (
        <>
          {mine && <p class="hold">You can hold one call at a time. To take one of these instead, cancel yours first.</p>}
          <div class="days">
            {days.map((day) => (
              <div class="day" role="group" aria-labelledby={`day-${day.date}`}>
                <h3 class="label" id={`day-${day.date}`}>{formatWeekday(day.slots[0].startsAt)}</h3>
                <ul class="slots">
                  {day.slots.map((s) => (
                    <li>
                      <Slot class="slot">
                        {!mine && <input form="book" type="radio" name="slot" value={s.id} required checked={posted('slot') === String(s.id)} />}
                        <time class="time" datetime={s.startsAt}>{formatTime(s.startsAt)}</time>
                        <span class="small">{s.minutes} min · with {s.host}</span>
                      </Slot>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          {!mine && (
            <form id="book" method="POST" action={formAction(Astro.url, actions.bookCall)} class="book">
              {fieldErrors.slot?.[0] && <span class="error">{fieldErrors.slot[0]}</span>}
              <div class="field">
                <label for="topic">What are you stuck on?</label>
                <textarea class="input" id="topic" name="topic" rows="3" maxlength={TOPIC_MAX} required aria-describedby="topic-hint" aria-invalid={fieldErrors.topic ? 'true' : undefined}>{posted('topic')}</textarea>
                <span class="hint" id="topic-hint">A sentence or two is plenty. Only {hostFirstName} sees it.</span>
                {fieldErrors.topic?.[0] && <span class="error">{fieldErrors.topic[0]}</span>}
              </div>
              <button class="btn" type="submit">Book the call</button>
            </form>
          )}
        </>
      )
    }
    <p class="small">Times are Malaysia time. Booking closes two hours before a call starts.</p>
  </section>
</Members>

<style>
  .block { display: grid; gap: var(--space-5); padding-block: clamp(48px, 6vw, 80px) 0; }
  .call { display: grid; gap: var(--space-3); padding-block: var(--space-5); border-top: var(--stroke-rule) solid var(--ink); border-bottom: var(--stroke-hair) solid var(--ink); }
  .call .small, .title, .topic { margin: 0; }
  .title { font-size: var(--size-head); line-height: 1.2; }
  .topic { max-width: 60ch; }
  .topic .label { display: block; margin-bottom: var(--space-1); }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }
  .confirm summary { cursor: pointer; text-decoration: underline; text-underline-offset: .2em; width: fit-content; }
  .confirm form { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin: var(--space-3) 0 0; }
  .confirm .small { max-width: 60ch; }
  .confirm .btn { min-height: 36px; padding: .4em .8em; font-size: var(--size-small); }
  .book { display: grid; gap: var(--space-5); max-width: 640px; }
  .book .btn { justify-self: start; }
  .hold { margin: 0; }
  .days { display: grid; gap: var(--space-6); max-width: 640px; }
  .day { display: grid; gap: var(--space-3); }
  .day .label { margin: 0; }
  .slots { margin: 0; padding: 0; list-style: none; border-top: var(--stroke-rule) solid var(--ink); }
  .slot { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); padding: var(--space-3) var(--space-2); border-bottom: var(--stroke-hair) solid var(--ink); }
  label.slot { cursor: pointer; transition: background-color var(--motion-quick) var(--motion-ease), color var(--motion-quick) var(--motion-ease); }
  label.slot:hover, label.slot:has(:checked) { background: var(--ink); color: var(--bg); }
  .slot input { margin: 0; accent-color: currentColor; align-self: center; }
  .time { min-width: 5.5em; font-weight: 600; font-variant-numeric: tabular-nums; }
  textarea.input { resize: vertical; line-height: 1.5; }
  .error { color: var(--alert); font-weight: 600; font-size: var(--size-small); }
  .empty { margin: 0; padding-block: var(--space-5); border-block: var(--stroke-hair) solid var(--ink); }
</style>
