---
import { actions, isInputError } from 'astro:actions';
import ListingEntry from '../../components/ListingEntry.astro';
import Masthead from '../../components/Masthead.astro';
import Notice from '../../components/Notice.astro';
import { LISTING_LIMITS, listingPath, services, states } from '../../data/directory.ts';
import Members from '../../layouts/Members.astro';
import { formAction } from '../../lib/format.ts';
import { SAVE_OUTCOMES, type Listing, type SaveOutcome } from '../../server/listings.ts';

export const prerender = false;

/* Forms post from the bare path, so a notice from an earlier action never shows beside the next one's result. */
const here = new URL('/members/listing', Astro.url);

const me = Astro.locals.member;
if (!me) return Astro.redirect('/sign-in');

const saved = Astro.getActionResult(actions.saveListing);
if (saved?.data) return Astro.redirect(`/members/listing?saved=${saved.data.outcome}`);
const paused = Astro.getActionResult(actions.pauseListing);

const listing = await Astro.locals.listings.listing(me.id);
const outcome = SAVE_OUTCOMES.find((o) => o === Astro.url.searchParams.get('saved'));
const savedNotice: Record<SaveOutcome, string> = {
  submitted: 'Sent. A host checks it, and we email you once it is in the directory.',
  resubmitted: 'Sent back to the hosts. It goes in the directory again once a host has checked it.',
  updated: 'Saved. It still waits for a host to check it.',
  unchanged: 'Nothing had changed, so nothing was sent.',
};

const standing = (l: Listing | null): string => {
  if (!l) return "Business owners use the club's directory to find an accountant, and a host checks each listing before it goes up.";
  if (l.review.state === 'returned') return 'A host sent your listing back with this note.';
  if (l.review.state === 'pending') return l.paused ? 'A host is checking your listing, which stays out of the directory while it is paused.' : 'A host is checking your listing, and we email you once it is in the directory.';
  if (l.shown) return 'Your practice is in the directory, where business owners can find it.';
  return l.paused ? 'Your listing is paused, so business owners cannot see it until you unpause it.' : 'Your listing is approved, but it is out of the directory until your membership is paid up.';
};

const fieldErrors = saved?.error && isInputError(saved.error) ? saved.error.fields : {};
const failure = [saved, paused].map((r) => (r?.error && !isInputError(r.error) ? r.error.message : null)).find(Boolean) ?? null;

/* A refused form is shown back as it was typed. Astro's actions read a clone of the request, so the body is unread here. */
const posted = saved?.error ? await Astro.request.formData().catch(() => null) : null;
const typed = (name: string, fallback: string) => {
  if (!posted) return fallback;
  const value = posted.get(name);
  return typeof value === 'string' ? value : '';
};
const chosen: readonly string[] = posted ? posted.getAll('services').filter((v) => typeof v === 'string') : (listing?.services ?? []);
const remote = posted ? posted.has('remote') : (listing?.remote ?? false);
const state = typed('state', listing?.state ?? '');

const submit = !listing ? 'Send for a check' : listing.review.state === 'returned' ? 'Send it back for a check' : 'Save changes';
const warning = listing?.review.state === 'listed' ? 'Saving a change takes your listing out of the directory until a host has checked it. Pausing does not.' : null;
const see = listing ? (listing.shown ? { href: listingPath(listing), label: 'See it in the directory' } : { href: '#preview', label: 'Preview how it reads' }) : null;
const error = (name: keyof typeof fieldErrors) => fieldErrors[name]?.[0];
---

<Members title="Your listing">
  <Masthead label="Find an accountant" title={listing?.practice ?? 'List your practice.'}>
    <p>{standing(listing)}</p>
    {listing?.review.state === 'returned' && <blockquote class="note">{listing.review.note}</blockquote>}
    {
      listing && see && (
        <div class="row">
          <a class="btn" href={see.href}>{see.label}</a>
          <form method="POST" action={formAction(here, actions.pauseListing)}>
            <input type="hidden" name="paused" value={listing.paused ? 'false' : 'true'} />
            <button class="btn ghost" type="submit">{listing.paused ? 'Unpause it' : 'Pause it'}</button>
          </form>
        </div>
      )
    }
  </Masthead>

  {outcome && <Notice>{savedNotice[outcome]}</Notice>}
  {paused?.data && <Notice>{paused.data.paused ? 'Paused. It is out of the directory until you unpause it.' : 'Unpaused.'}</Notice>}
  {failure && <Notice tone="error">{failure}</Notice>}

  <section class="wrap block" aria-labelledby="form-title">
    <h2 class="head" id="form-title">{listing ? 'Your listing' : 'Write your listing'}</h2>
    <p class="small intro">Everything here is shown in the directory, written for a business owner looking for an accountant. A host checks that you are a member and that the practice is real and yours.</p>
    <form method="POST" action={formAction(here, actions.saveListing)} class="form">
      <div class="field">
        <label for="practice">Practice name</label>
        <input class="input" id="practice" name="practice" required maxlength={LISTING_LIMITS.practice} autocomplete="organization" value={typed('practice', listing?.practice ?? '')} aria-invalid={error('practice') ? 'true' : undefined} />
        {error('practice') && <span class="error">{error('practice')}</span>}
      </div>

      <div class="pair">
        <div class="field">
          <label for="state">State</label>
          <select class="input" id="state" name="state" required aria-invalid={error('state') ? 'true' : undefined}>
            <option value="" selected={state === ''} disabled>Pick a state</option>
            {states.map((s) => <option selected={s === state}>{s}</option>)}
          </select>
          {error('state') && <span class="error">{error('state')}</span>}
        </div>
        <div class="field">
          <label for="town">Town or city</label>
          <input class="input" id="town" name="town" required maxlength={LISTING_LIMITS.town} autocomplete="address-level2" value={typed('town', listing?.town ?? '')} aria-invalid={error('town') ? 'true' : undefined} />
          {error('town') && <span class="error">{error('town')}</span>}
        </div>
      </div>

      <label class="check">
        <input type="checkbox" name="remote" checked={remote} />
        <span><b>I take clients anywhere in Malaysia</b><span class="hint">You are shown to business owners in other states too.</span></span>
      </label>

      <fieldset class="field services" aria-describedby="services-hint">
        <legend>Services</legend>
        <span class="hint" id="services-hint">Tick every one you offer.</span>
        <div class="options">
          {
            services.map((s) => (
              <label class="check">
                <input type="checkbox" name="services" value={s.slug} checked={chosen.includes(s.slug)} />
                <span>{s.label}</span>
              </label>
            ))
          }
        </div>
        {error('services') && <span class="error">{error('services')}</span>}
      </fieldset>

      <div class="field">
        <label for="niche">Who you work with most <span class="hint">(optional)</span></label>
        <input class="input" id="niche" name="niche" maxlength={LISTING_LIMITS.niche} value={typed('niche', listing?.niche ?? '')} aria-describedby="niche-hint" aria-invalid={error('niche') ? 'true' : undefined} />
        <span class="hint" id="niche-hint">For example: clinics, restaurants or online sellers.</span>
        {error('niche') && <span class="error">{error('niche')}</span>}
      </div>

      <div class="field">
        <label for="bio">About your practice</label>
        <textarea class="input" id="bio" name="bio" rows="6" required maxlength={LISTING_LIMITS.bio} aria-describedby="bio-hint" aria-invalid={error('bio') ? 'true' : undefined}>{typed('bio', listing?.bio ?? '')}</textarea>
        <span class="hint" id="bio-hint">What you do, who for, and how you work. Up to {LISTING_LIMITS.bio} characters.</span>
        {error('bio') && <span class="error">{error('bio')}</span>}
      </div>

      <div class="field">
        <label for="qualifications">Qualifications</label>
        <input class="input" id="qualifications" name="qualifications" required maxlength={LISTING_LIMITS.qualifications} value={typed('qualifications', listing?.qualifications ?? '')} aria-describedby="qualifications-hint" aria-invalid={error('qualifications') ? 'true' : undefined} />
        <span class="hint" id="qualifications-hint">As you write them after your name. For example: Chartered Accountant (MIA), ACCA.</span>
        {error('qualifications') && <span class="error">{error('qualifications')}</span>}
      </div>

      <div class="field">
        <label for="website">Website <span class="hint">(optional)</span></label>
        <input class="input" id="website" name="website" inputmode="url" autocomplete="url" maxlength={LISTING_LIMITS.website} placeholder="rahman.com.my" value={typed('website', listing?.website ?? '')} aria-invalid={error('website') ? 'true' : undefined} />
        {error('website') && <span class="error">{error('website')}</span>}
      </div>

      <div class="field">
        <label for="contactEmail">Email for enquiries</label>
        <input class="input" id="contactEmail" name="contactEmail" type="email" required autocomplete="email" value={typed('contactEmail', listing?.contactEmail ?? me.email)} aria-describedby="contact-hint" aria-invalid={error('contactEmail') ? 'true' : undefined} />
        <span class="hint" id="contact-hint">Shown in the directory. Business owners write to you here; the club never sees it.</span>
        {error('contactEmail') && <span class="error">{error('contactEmail')}</span>}
      </div>

      <label class="check declare">
        <input type="checkbox" name="declared" required aria-invalid={error('declared') ? 'true' : undefined} />
        <span>
          <b>I hold the qualifications, registrations and professional indemnity cover that the services I list require.</b>
          <span class="hint">The club does not check these, and the directory tells business owners so.</span>
        </span>
      </label>
      {error('declared') && <span class="error">{error('declared')}</span>}

      <div class="send">
        <button class="btn" type="submit">{submit}</button>
        {warning && <span class="small">{warning}</span>}
      </div>
    </form>
  </section>

  {
    listing && !listing.shown && (
      <section class="wrap block" id="preview" aria-labelledby="preview-title">
        <h2 class="head" id="preview-title">How it reads in the directory</h2>
        <p class="small intro">{listing.review.state === 'listed' ? 'This is what business owners see once it is back in the directory.' : 'This is what business owners see once a host approves it. Until then only you and the hosts can see it.'}</p>
        <div class="entries"><ListingEntry listing={listing} /></div>
      </section>
    )
  }
</Members>

<style>
  .block { display: grid; gap: var(--space-5); padding-block: clamp(48px, 6vw, 80px) 0; }
  .intro { margin: 0; max-width: 60ch; }
  .note { margin: 0; padding: var(--space-3) 0 var(--space-3) var(--space-4); border-left: var(--stroke-heavy) solid var(--ink); white-space: pre-line; overflow-wrap: anywhere; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-3); }
  .row form { margin: 0; }
  .form { display: grid; gap: var(--space-6); max-width: 640px; }
  .pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--space-5); }
  textarea.input { resize: vertical; line-height: 1.5; }
  .services { margin: 0; padding: 0; border: 0; min-width: 0; }
  .services legend { padding: 0; font: 600 var(--size-small)/1.3 var(--font-sans); }
  .options { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: var(--space-3) var(--space-5); margin-top: var(--space-2); }
  .check { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; cursor: pointer; }
  .check input { width: 1.25rem; height: 1.25rem; margin: .15em 0 0; accent-color: var(--ink); }
  .check > span { display: grid; gap: var(--space-1); }
  .check .hint { font-size: var(--size-small); }
  .declare { padding-block: var(--space-4); border-block: var(--stroke-hair) solid var(--ink); }
  .send { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .send .small { max-width: 44ch; }
  .error { color: var(--alert); font-weight: 600; font-size: var(--size-small); }
  .entries { border-top: var(--stroke-rule) solid var(--ink); border-bottom: var(--stroke-hair) solid var(--ink); }
</style>
