---
import { actions, isInputError } from 'astro:actions';
import Masthead from '../../components/Masthead.astro';
import Members from '../../layouts/Members.astro';
import { monthlyRate } from '../../data/membership.ts';
import { formAction, formatDay } from '../../lib/format.ts';
import { memberNumber } from '../../server/club.ts';
import { MIN_PASSWORD_LENGTH } from '../../server/password.ts';

export const prerender = false;

const member = Astro.locals.member;
if (!member) return Astro.redirect('/sign-in');

const result = Astro.getActionResult(actions.changePassword);
const saved = Astro.getActionResult(actions.setEmailPrefs);
const renewal = Astro.getActionResult(actions.setRenews);
const standing = member.role === 'admin' ? null : await Astro.locals.billing.standing(member.id);
const until = standing?.paidUntil ? formatDay(standing.paidUntil) : null;
const plan = !standing
  ? null
  : !until
    ? `Not started. Membership is ${monthlyRate}.`
    : standing.access === 'unpaid'
      ? `Your last paid month ended on ${until}.`
      : !standing.renews
        ? `Paid until ${until}. Renewal is off, so your membership ends then.`
        : standing.cardOnFile
          ? `${monthlyRate}. Paid until ${until}, then it renews on your card.`
          : `${monthlyRate}. Paid until ${until}. We email you a link to pay the next month a few days before.`;
const prefs = await Astro.locals.mailings.prefs(member.id);
const choices = [
  { name: 'replies', label: 'Replies in threads I posted in', hint: 'At most one email per thread every six hours.', on: prefs.replies },
  { name: 'digest', label: 'A weekly email on Mondays', hint: 'New threads and the sessions coming up. Only sent when there is news.', on: prefs.digest },
] as const;
const fieldErrors = result?.error && isInputError(result.error) ? result.error.fields : {};
const error = result?.error && !isInputError(result.error) ? result.error.message : null;
const details = [
  { term: 'Name', detail: member.name },
  { term: 'Email', detail: member.email },
  { term: 'Member number', detail: memberNumber(member) },
  { term: 'Member since', detail: formatDay(member.joinedAt) },
];
---

<Members title="Account">
  <Masthead label="Account" title={member.name} />
  <section class="wrap block" aria-labelledby="details-title">
    <h2 class="head" id="details-title">Your details</h2>
    <dl class="facts">{details.map(({ term, detail }) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}</dl>
    <p class="small">To change your name or email, ask the club.</p>
  </section>
  {
    standing && (
      <section class="wrap block" id="membership" aria-labelledby="membership-title">
        <h2 class="head" id="membership-title">Membership</h2>
        <p>{plan}</p>
        {standing.access === 'grace' && <p class="error" role="alert">Your paid month has ended. Pay within a few days to keep your access.</p>}
        <div class="row">
          {(!(standing.cardOnFile && standing.renews) || standing.access !== 'paid') && <a class="btn" href="/members/pay">Pay a month</a>}
          {standing.access !== 'unpaid' && (
            <form method="POST" action={formAction(Astro.url, actions.setRenews)}>
              <input type="hidden" name="renews" value={standing.renews ? 'false' : 'true'} />
              <button class={standing.renews ? 'btn ghost' : 'btn'} type="submit">{standing.renews ? 'Turn off renewal' : 'Turn renewal back on'}</button>
            </form>
          )}
        </div>
        {renewal?.data && <p class="ok" role="status">{renewal.data.renews ? 'Renewal is on.' : `Renewal is off. You keep access until ${until}.`}</p>}
      </section>
    )
  }
  <section class="wrap block" id="email" aria-labelledby="email-title">
    <h2 class="head" id="email-title">Emails from the club</h2>
    <p class="small">Invitations, password links and emails about sessions you said you would come to always arrive.</p>
    <form method="POST" action={formAction(Astro.url, actions.setEmailPrefs)} class="form">
      {
        choices.map((c) => (
          <label class="check">
            <input type="checkbox" name={c.name} checked={c.on} />
            <span><b>{c.label}</b><span class="hint">{c.hint}</span></span>
          </label>
        ))
      }
      {saved?.data && <p class="ok" role="status">Saved.</p>}
      {saved?.error && <p class="error" role="alert">{saved.error.message}</p>}
      <button class="btn" type="submit">Save email choices</button>
    </form>
  </section>
  <section class="wrap block" aria-labelledby="password-title">
    <h2 class="head" id="password-title">Change your password</h2>
    <p class="small">Changing it signs you out on every other device.</p>
    <form method="POST" action={formAction(Astro.url, actions.changePassword)} class="form">
      <input type="hidden" name="email" value={member.email} autocomplete="username" />
      <div class="field">
        <label for="current">Current password</label>
        <input class="input" id="current" name="current" type="password" autocomplete="current-password" required />
      </div>
      <div class="field">
        <label for="password">New password</label>
        <input class="input" id="password" name="password" type="password" autocomplete="new-password" minlength={MIN_PASSWORD_LENGTH} required aria-invalid={fieldErrors.password ? 'true' : undefined} />
        <span class="hint">At least {MIN_PASSWORD_LENGTH} characters.</span>
        {fieldErrors.password?.[0] && <span class="error">{fieldErrors.password[0]}</span>}
      </div>
      <div class="field">
        <label for="confirm">The new password again</label>
        <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" required aria-invalid={fieldErrors.confirm ? 'true' : undefined} />
        {fieldErrors.confirm?.[0] && <span class="error">{fieldErrors.confirm[0]}</span>}
      </div>
      {error && <p class="error" role="alert">{error}</p>}
      {result?.data && <p class="ok" role="status">Your password has been changed. Anywhere else you were signed in is now signed out.</p>}
      <button class="btn" type="submit">Change password</button>
    </form>
  </section>
</Members>

<style>
  .block { display: grid; gap: var(--space-5); padding-block: clamp(48px, 6vw, 80px) 0; }
  .block > * { max-width: 720px; }
  .block > .small { margin: 0; }
  .form { display: grid; gap: var(--space-5); max-width: 440px; }
  .form .btn { justify-self: start; }
  .error, .ok { margin: 0; font-weight: 600; }
  .error { color: var(--alert); }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; }
  .row form { margin: 0; }
  .check { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; cursor: pointer; }
  .check input { width: 1.25rem; height: 1.25rem; margin: .15em 0 0; accent-color: var(--ink); }
  .check span { display: grid; gap: var(--space-1); }
</style>
