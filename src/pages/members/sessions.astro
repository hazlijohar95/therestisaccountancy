---
import { actions } from 'astro:actions';
import { getCollection } from 'astro:content';
import Notice from '../../components/Notice.astro';
import Steps from '../../components/Steps.astro';
import { week } from '../../data/club.ts';
import Masthead from '../../components/Masthead.astro';
import Members from '../../layouts/Members.astro';
import { formAction, formatDay, formatMoment } from '../../lib/format.ts';

export const prerender = false;

const me = Astro.locals.member;
if (!me) return Astro.redirect('/sign-in');
const answered = Astro.getActionResult(actions.rsvp);
const upcoming = await Astro.locals.schedule.upcoming(me.id);
const started = (startsAt: string) => new Date(startsAt).getTime() <= Date.now();
const recordings = (await getCollection('recordings')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Members title="Sessions">
  <Masthead label="Sessions" title="Live every week. Recorded for the weeks you miss." narrow />
  {answered?.data && <Notice>{answered.data.going ? 'You are down for it. A calendar file is on its way by email.' : 'Noted. You are no longer down for it.'}</Notice>}
  {answered?.error && <Notice tone="error">{answered.error.message}</Notice>}
  <section class="wrap block" aria-labelledby="coming-title">
    <h2 class="head" id="coming-title">Coming up</h2>
    {
      upcoming.length === 0 ? (
        <p class="empty">Nothing scheduled yet. New sessions appear here, and in the Monday email.</p>
      ) : (
        <ol class="sessions">
          {upcoming.map((s) => (
            <li class="session">
              <div class="when small"><time datetime={s.startsAt}>{formatMoment(s.startsAt)}</time> · {s.minutes} min · {s.kind}{started(s.startsAt) && <b> · On now</b>}</div>
              <h3 class="title">{s.title}</h3>
              {s.detail && <p class="detail">{s.detail}</p>}
              <p class="small">{s.going === 0 ? 'Nobody has said yet.' : s.going === 1 ? '1 member coming.' : `${s.going} members coming.`}</p>
              <form method="POST" action={formAction(Astro.url, actions.rsvp)} class="row">
                <input type="hidden" name="session" value={s.id} />
                {s.attending ? (
                  <>
                    <a class="btn" href={s.link} rel="noopener">Join the call</a>
                    <a href={`/members/sessions/${s.id}.ics`}>Add to calendar</a>
                    <button class="link" name="going" value="false">I can't make it</button>
                  </>
                ) : (
                  <button class="btn" name="going" value="true">I'm coming</button>
                )}
              </form>
            </li>
          ))}
        </ol>
      )
    }
    <p class="small">Times are Malaysia time.</p>
  </section>
  <section class="wrap block" aria-labelledby="kinds-title">
    <h2 class="head" id="kinds-title">Three kinds of session</h2>
    <Steps items={week.sessions} />
    <dl class="facts">
      {week.between.map(({ term, detail }) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}
    </dl>
  </section>
  <section class="wrap block" aria-labelledby="recordings-title">
    <h2 class="head" id="recordings-title">Recordings</h2>
    {
      recordings.length === 0 ? (
        <p class="empty">No recordings yet. Each session's recording is added here after it airs.</p>
      ) : (
        <table class="ledger">
          <thead><tr><th>Session</th><th>Kind</th><th>Date</th></tr></thead>
          <tbody>
            {recordings.map((r) => (
              <tr><td><a href={r.data.url}>{r.data.title}</a></td><td>{r.data.kind}</td><td>{formatDay(r.data.date)}</td></tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>
</Members>

<style>
  .block { display: grid; gap: var(--space-6); padding-block: clamp(48px, 6vw, 80px) 0; }
  .sessions { display: grid; margin: 0; padding: 0; list-style: none; border-top: var(--stroke-rule) solid var(--ink); }
  .session { display: grid; gap: var(--space-3); padding-block: var(--space-5); border-bottom: var(--stroke-hair) solid var(--ink); }
  .title { margin: 0; font-size: var(--size-head); line-height: 1.2; }
  .detail { margin: 0; max-width: 60ch; white-space: pre-line; }
  .session .small { margin: 0; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); margin: 0; }
  .link { padding: 0; border: 0; background: none; color: inherit; font: inherit; text-decoration: underline; text-underline-offset: .2em; cursor: pointer; }
  .empty { margin: 0; padding-block: var(--space-5); border-block: var(--stroke-hair) solid var(--ink); }
</style>
