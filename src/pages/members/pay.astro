---
import { actions } from 'astro:actions';
import Masthead from '../../components/Masthead.astro';
import Notice from '../../components/Notice.astro';
import { anyTerm, everyRate, monthsFree, TERMS, terms } from '../../data/membership.ts';
import Members from '../../layouts/Members.astro';
import { capitalised, formAction, formatDay, numberWord } from '../../lib/format.ts';
import { settle } from '../../server/payments.ts';
import { report } from '../../server/report.ts';

export const prerender = false;

const me = Astro.locals.member;
if (!me) return Astro.redirect('/sign-in');
if (me.role === 'admin') return Astro.redirect('/members');

const started = Astro.getActionResult(actions.checkout);
if (started?.data) return Astro.redirect(started.data.url);

/* Back from CHIP: its callback may not have landed yet, so ask CHIP directly. */
const back = Astro.url.searchParams.get('back');
if (back === 'paid') {
  /* The member may have opened the payment page more than once and paid any of them. */
  for (const open of await Astro.locals.billing.unpaid(me.id, 'checkout')) {
    await settle(Astro.locals.billing, open).catch((error: unknown) => report('payment', `Payment ${open} could not be checked with CHIP on return`, error));
  }
}
const standing = await Astro.locals.billing.standing(me.id);
if (back === 'paid' && standing.access === 'paid') return Astro.redirect('/members?paid');

const lapsed = standing.access === 'unpaid' && standing.paidUntil !== null;
const current = standing.access !== 'unpaid' && standing.paidUntil !== null;
const offers = TERMS.map((term) => {
  const free = monthsFree(term);
  return { term, label: terms[term].label, price: terms[term].price, saving: free > 0 ? `${capitalised(numberWord(free))} months free.` : null };
});
const renewsByCard = standing.cardOnFile && standing.renews;
---

<Members title="Membership">
  <Masthead label="Membership" title={lapsed ? 'Your membership needs a payment.' : current ? 'Pay ahead.' : `Welcome, ${me.name}. One step left.`}>
    <p>
      {
        lapsed
          ? `Your last paid ${standing.term} ended on ${formatDay(standing.paidUntil ?? '')}. Pay for ${anyTerm} to carry on.`
          : current
            ? `You are paid until ${formatDay(standing.paidUntil ?? '')}. What you pay for now is added after that.`
            : `Membership is ${everyRate}. Choose one, pay, and you are in.`
      }
    </p>
  </Masthead>

  {back === 'failed' && <Notice tone="error">The payment did not go through, and nothing was charged. Try again, or use another card.</Notice>}
  {back === 'paid' && standing.access !== 'paid' && <Notice>CHIP is still confirming your payment. Refresh this page in a minute.</Notice>}
  {started?.error && <Notice tone="error">{started.error.message}</Notice>}

  <section class="wrap block" aria-labelledby="pay-title">
    <h2 class="head" id="pay-title">Pay by the {TERMS.join(' or the ')}</h2>
    <ul class="offers">
      {
        offers.map((offer) => (
          <li>
            <h3 class="serif rate">{offer.label}</h3>
            {offer.saving && <p class="saving">{offer.saving}</p>}
            <form method="POST" action={formAction(Astro.url, actions.checkout)}>
              <input type="hidden" name="term" value={offer.term} />
              <button class="btn" type="submit">Pay {offer.price} with CHIP</button>
            </form>
          </li>
        ))
      }
    </ul>
    <p class="small">
      You pay on CHIP's secure page by online banking (FPX), then come straight back here. CHIP emails you a receipt.
      {renewsByCard ? `Your card renews at whichever you paid for last, ${anyTerm}.` : 'Before your paid time ends we email you a link to pay for more.'}
      Stop any time: you keep access to the end of the time you paid for.
    </p>
  </section>
</Members>

<style>
  .block { display: grid; gap: var(--space-5); padding-block: clamp(48px, 6vw, 80px) 0; }
  .block > * { max-width: 640px; margin: 0; }
  .offers { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-6); padding: 0; list-style: none; }
  .offers li { display: flex; flex-direction: column; gap: var(--space-3); padding-top: var(--space-4); border-top: var(--stroke-rule) solid var(--ink); }
  .offers form { margin-top: auto; padding-top: var(--space-3); }
  .rate { margin: 0; font-size: var(--size-head); line-height: 1.08; }
  .saving { margin: 0; font-weight: 600; }
</style>
