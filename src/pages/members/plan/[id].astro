---
import { actions } from 'astro:actions';
import Masthead from '../../../components/Masthead.astro';
import Notice from '../../../components/Notice.astro';
import PlanLetter from '../../../components/PlanLetter.astro';
import { hostFirstName } from '../../../data/authors.ts';
import Members from '../../../layouts/Members.astro';
import { formAction, formatDay } from '../../../lib/format.ts';

export const prerender = false;

const me = Astro.locals.member;
if (!me) return Astro.redirect('/sign-in');

const started = Astro.getActionResult(actions.startPlan);
if (started?.data) return Astro.redirect('/members/plan?started');

const id = Number(Astro.params.id);
const { open, answered } = await Astro.locals.plans.ofMember(me.id);
if (open?.id === id) return Astro.redirect('/members/plan');
const plan = answered.find((p) => p.id === id);
if (!plan) return new Response(null, { status: 404, statusText: 'Not found' });

const host = plan.reply.by ?? hostFirstName;
const isLatest = answered[0]?.id === plan.id;
---

<Members title="Your plan, answered">
  <Masthead label="" title={`Your plan of ${formatDay(plan.sentAt)}`} narrow>
    <span slot="label"><a href="/members/plan">Your plan</a> / Answered</span>
    <p>Answered by {host} on {formatDay(plan.reply.at)}. Your sections first, then the answer.</p>
  </Masthead>

  {started?.error && <Notice tone="error">{started.error.message}</Notice>}

  <article class="wrap block" aria-label="Your plan and the answer">
    <PlanLetter plan={plan} level={2} />
  </article>

  <section class="wrap block" aria-label="What next">
    <div class="next">
    {
      open ? (
        <p><a href="/members/plan">Back to the plan you are writing now</a></p>
      ) : isLatest ? (
        <>
          <p>When you are ready, write the next one. It starts from this plan, so you only change what has moved. The question for {hostFirstName} starts blank.</p>
          <form method="POST" action={formAction(Astro.url, actions.startPlan)}>
            <button class="btn" type="submit">Start the next plan</button>
          </form>
        </>
      ) : (
        <p><a href="/members/plan">All your plans</a></p>
      )
    }
    </div>
  </section>
</Members>

<style>
  .block { display: grid; gap: var(--space-6); padding-block: clamp(48px, 6vw, 80px) 0; }
  .next { display: grid; gap: var(--space-4); max-width: 60ch; }
  .next p, .next form { margin: 0; }
</style>
