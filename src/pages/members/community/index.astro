---
import Masthead from '../../../components/Masthead.astro';
import Notice from '../../../components/Notice.astro';
import ThreadList from '../../../components/ThreadList.astro';
import { channelBySlug, channelPath } from '../../../data/community.ts';
import Members from '../../../layouts/Members.astro';
import { formatMoment } from '../../../lib/format.ts';

export const prerender = false;

const RECENT = 10;
const board = Astro.locals.community;
const [summaries, recent] = await Promise.all([board.channels(), board.recent(RECENT)]);
const count = (n: number) => (n === 1 ? '1 thread' : `${n} threads`);
---

<Members title="Community">
  <Masthead label="Community" title="Ask the room." narrow>
    <p>Members only. Be specific about your numbers, generous with what worked, and keep client names out of it.</p>
  </Masthead>

  {Astro.url.searchParams.has('gone') && <Notice tone="error">That thread was removed, so your change could not be made.</Notice>}

  <section class="wrap block" aria-labelledby="channels-title">
    <h2 class="head" id="channels-title">Channels</h2>
    <ul class="channels" role="list">
      {
        summaries.map(({ slug, threads, latest }) => (
          <li>
            <a class="channel-name" href={channelPath(slug)}>{channelBySlug(slug)?.name}</a>
            <p class="channel-about">{channelBySlug(slug)?.about}</p>
            <p class="small channel-meta">
              {threads === 0 ? 'Nothing yet. Start the first thread.' : `${count(threads)} · latest: ${latest?.title ?? ''}, ${latest ? formatMoment(latest.lastPostAt) : ''}`}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap block" aria-labelledby="recent-title">
    <h2 class="head" id="recent-title">Recent</h2>
    {recent.length === 0 ? <p class="empty">No threads yet. Pick a channel and start one.</p> : <ThreadList threads={recent} showChannel />}
  </section>
</Members>

<style>
  .block { display: grid; gap: var(--space-5); padding-block: clamp(48px, 6vw, 80px) 0; }
  .channels { list-style: none; margin: 0; padding: 0; border-top: var(--stroke-rule) solid var(--ink); }
  .channels li { display: grid; gap: var(--space-2); padding-block: var(--space-4); border-bottom: var(--stroke-hair) solid var(--ink); }
  .channel-name { font: 400 var(--size-head)/1.15 var(--display-font); letter-spacing: var(--display-tracking); font-synthesis: none; text-decoration: none; }
  .channel-name:hover { text-decoration: underline; text-underline-offset: .15em; text-decoration-thickness: 1px; }
  .channel-about, .channel-meta { margin: 0; max-width: 68ch; overflow-wrap: anywhere; }
  .empty { margin: 0; padding-block: var(--space-5); border-block: var(--stroke-hair) solid var(--ink); }
  @media (min-width: 900px) {
    .channels li { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: var(--space-8); }
    .channel-name { grid-row: span 2; }
  }
</style>
