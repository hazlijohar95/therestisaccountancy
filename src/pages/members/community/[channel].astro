---
import { actions, isInputError } from 'astro:actions';
import Masthead from '../../../components/Masthead.astro';
import Notice from '../../../components/Notice.astro';
import Pager from '../../../components/Pager.astro';
import ThreadList from '../../../components/ThreadList.astro';
import { channelBySlug, LIMITS, PAGE_SIZE, threadPath } from '../../../data/community.ts';
import Members from '../../../layouts/Members.astro';
import { postedFields } from '../../../lib/form.ts';
import { formAction } from '../../../lib/format.ts';
import { pageCount, pageHref, pagingOf } from '../../../lib/paging.ts';
import { getCommunity } from '../../../server/instance.ts';

export const prerender = false;

const started = Astro.getActionResult(actions.startThread);
if (started?.data) return Astro.redirect(`${threadPath(started.data.threadId)}#post-${started.data.postId}`);

const channel = channelBySlug(Astro.params.channel ?? '');
if (!channel) return new Response(null, { status: 404, statusText: 'Not found' });

const fieldErrors = started?.error && isInputError(started.error) ? started.error.fields : {};
const failure = started?.error && !isInputError(started.error) ? started.error.message : (fieldErrors.channel?.[0] ?? null);
const posted = started?.error ? await postedFields(Astro.request) : () => '';
const paging = pagingOf(Astro.url, PAGE_SIZE.threads);
const { items, total } = getCommunity().threads(channel.slug, { limit: paging.size, offset: paging.offset });
const pages = pageCount(total, paging.size);
if (paging.page > pages) return Astro.redirect(pageHref(Astro.url, pages));
const notice = Astro.url.searchParams.has('removed') ? 'Thread removed.' : Astro.url.searchParams.has('deleted') ? 'Post deleted. It was the last one, so the thread is gone too.' : null;
---

<Members title={channel.name}>
  <Masthead label="" title={channel.name} narrow>
    <a slot="label" href="/members/community">Community</a>
    <p>{channel.about}</p>
  </Masthead>

  {notice && <Notice>{notice}</Notice>}
  {failure && <Notice tone="error">{failure}</Notice>}

  <section class="wrap block" aria-labelledby="start-title">
    <details class="start" open={started?.error ? true : undefined}>
      <summary class="btn"><span id="start-title">Start a thread</span></summary>
      <form method="POST" action={formAction(Astro.url, actions.startThread)} class="form">
        <input type="hidden" name="channel" value={channel.slug} />
        <div class="field">
          <label for="title">Title</label>
          <input class="input" id="title" name="title" required minlength={LIMITS.title.min} maxlength={LIMITS.title.max} value={posted('title')} aria-invalid={fieldErrors.title ? 'true' : undefined} />
          <span class="hint">A question or a headline. Others decide from this whether to open it.</span>
          {fieldErrors.title?.[0] && <span class="error">{fieldErrors.title[0]}</span>}
        </div>
        <div class="field">
          <label for="body">Post</label>
          <textarea class="input" id="body" name="body" rows="8" required maxlength={LIMITS.body.max} aria-invalid={fieldErrors.body ? 'true' : undefined}>{posted('body')}</textarea>
          <span class="hint">Plain text. Leave a blank line between paragraphs. Links starting with https:// become clickable.</span>
          {fieldErrors.body?.[0] && <span class="error">{fieldErrors.body[0]}</span>}
        </div>
        <button class="btn" type="submit">Post thread</button>
      </form>
    </details>
  </section>

  <section class="wrap block" aria-labelledby="threads-title">
    <h2 class="head" id="threads-title">Threads</h2>
    {items.length === 0 ? <p class="empty">No threads here yet. Start the first one.</p> : <ThreadList threads={items} />}
    <Pager url={Astro.url} page={paging.page} pages={pages} label="Thread pages" />
  </section>
</Members>

<style>
  .block { display: grid; gap: var(--space-5); padding-block: clamp(48px, 6vw, 80px) 0; }
  .start summary { list-style: none; cursor: pointer; width: fit-content; }
  .start summary::-webkit-details-marker { display: none; }
  .start[open] summary { margin-bottom: var(--space-6); }
  .form { display: grid; gap: var(--space-5); max-width: 720px; }
  .form .btn { justify-self: start; }
  textarea.input { min-height: 12rem; resize: vertical; line-height: 1.5; }
  .error { color: var(--alert); font-weight: 600; }
  .empty { margin: 0; padding-block: var(--space-5); border-block: var(--stroke-hair) solid var(--ink); }
</style>
