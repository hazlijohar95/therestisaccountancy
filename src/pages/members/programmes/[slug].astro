---
import { programmeBySlug } from '../../../data/programmes.ts';
import Members from '../../../layouts/Members.astro';
import { lessonPath, lessonsOf } from '../../../server/lessons.ts';

export const prerender = false;

const member = Astro.locals.member;
const programme = programmeBySlug(Astro.params.slug ?? '');
if (!member) return Astro.redirect('/sign-in');
if (!programme) return new Response(null, { status: 404, statusText: 'Not found' });

const done = await Astro.locals.club.completedLessons(member.id);
const lessons = await lessonsOf(programme.slug);
const modules = programme.topics.map((topic, i) => ({ topic, lessons: lessons.filter((l) => l.data.module === i + 1) }));
const count = (n: number) => String(n).padStart(2, '0');
---

<Members title={programme.name}>
  <section class="night">
    <div class="wrap masthead">
      <p class="label top"><a href="/members">Overview</a> / Programme</p>
      <h1 class="headline serif">{programme.name}</h1>
      <p class="lead">{programme.promise} {lessons.filter((l) => done.has(l.id)).length} of {lessons.length} published lessons done.</p>
    </div>
  </section>
  <section class="wrap modules" aria-label="Modules">
    {
      modules.map(({ topic, lessons }, i) => (
        <article>
          <span class="serif n">{count(i + 1)}</span>
          <div>
            <h2 class="head">{topic}</h2>
            {lessons.length === 0 ? (
              <p class="small">Being written.</p>
            ) : (
              <ol>
                {lessons.map((lesson) => (
                  <li>
                    <a href={lessonPath(lesson)}>{lesson.data.title}</a>
                    <span class="small">{lesson.data.minutes} min{done.has(lesson.id) ? ' · Done' : ''}</span>
                  </li>
                ))}
              </ol>
            )}
          </div>
        </article>
      ))
    }
  </section>
</Members>

<style>
  .masthead { display: grid; gap: var(--space-5); padding-block: clamp(32px, 4vw, 48px) clamp(48px, 6vw, 80px); }
  .top { margin: 0 0 var(--space-4); padding-bottom: var(--space-4); border-bottom: var(--stroke-hair) solid var(--ink); }
  .top a { text-decoration: none; }
  .headline { margin: 0; font-size: clamp(2.75rem, 1.2rem + 5vw, 5.5rem); line-height: .98; letter-spacing: -.035em; }
  .lead { margin: 0; }
  .modules { padding-block: clamp(48px, 6vw, 96px); }
  article { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-5); border-top: var(--stroke-hair) solid var(--ink); }
  article:first-child { border-top: var(--stroke-rule) solid var(--ink); }
  .n { font-size: 1.25rem; line-height: 1.4; }
  article .head { margin: 0 0 var(--space-3); font-size: clamp(1.35rem, 1.15rem + .8vw, 1.75rem); }
  article p { margin: 0; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: flex; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-3); border-top: var(--stroke-hair) solid var(--ink); }
  li a { font-weight: 600; }
</style>
