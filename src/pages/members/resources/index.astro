---
import Masthead from '../../../components/Masthead.astro';
import TemplateList from '../../../components/TemplateList.astro';
import { programmes } from '../../../data/programmes.ts';
import Members from '../../../layouts/Members.astro';
import { allResources } from '../../../server/resources.ts';

export const prerender = false;

if (!Astro.locals.member) return Astro.redirect('/sign-in');

const all = await allResources();
const groups = programmes.map((programme) => ({ programme, items: all.filter((r) => r.data.programme === programme.slug) })).filter((g) => g.items.length > 0);
const count = (n: number) => String(n).padStart(2, '0');
---

<Members title="Templates">
  <Masthead label="Templates" title="Ready to use with your own clients." narrow>
    <p>Checklists, letters, scripts and worksheets, written alongside the programmes. Copy one into Word or Google Docs, fill in everything in brackets, and make it yours before a client sees it.</p>
  </Masthead>
  <section class="wrap library" aria-label="Templates by programme">
    {
      groups.length === 0 ? (
        <p class="empty">No templates yet. They appear here as each programme's are written.</p>
      ) : (
        groups.map(({ programme, items }) => (
          <section class="group" aria-labelledby={`t-${programme.slug}`}>
            <div class="rail">
              <span class="serif n">{count(programmes.indexOf(programme) + 1)}</span>
              <div>
                <h2 class="head" id={`t-${programme.slug}`}>{programme.name}</h2>
                <p class="small">{programme.promise} <a href={`/members/programmes/${programme.slug}`}>Open the programme</a></p>
              </div>
            </div>
            <TemplateList items={items} withModule />
          </section>
        ))
      )
    }
  </section>
</Members>

<style>
  .library { display: grid; gap: clamp(48px, 6vw, 80px); padding-block: clamp(48px, 6vw, 96px) 0; }
  .group { display: grid; gap: var(--space-4); }
  .rail { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: var(--space-4); align-content: start; }
  .n { font-size: 1.25rem; line-height: 1.4; }
  .rail .head { margin: 0 0 var(--space-2); font-size: clamp(1.35rem, 1.15rem + .8vw, 1.75rem); }
  .rail p { margin: 0; }
  .empty { margin: 0; padding-block: var(--space-5); border-block: var(--stroke-hair) solid var(--ink); }
  @media (min-width: 1000px) {
    .group { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: var(--space-8); }
    .rail { padding-top: var(--space-4); border-top: var(--stroke-rule) solid var(--ink); }
  }
</style>
