---
import ListingEntry from '../components/ListingEntry.astro';
import PageHead from '../components/PageHead.astro';
import Section from '../components/Section.astro';
import { isServiceSlug, isState, services, states } from '../data/directory.ts';
import Page from '../layouts/Page.astro';
import { numberWord } from '../lib/format.ts';
import { directorySummary } from '../server/listings.ts';

export const prerender = false;

const asked = Astro.url.searchParams;
const askedState = asked.get('state') ?? '';
const askedService = asked.get('service') ?? '';
const state = isState(askedState) ? askedState : undefined;
const service = isServiceSlug(askedService) ? askedService : undefined;
const filtered = state !== undefined || service !== undefined;
const found = await Astro.locals.listings.directory({ state, service });
const { total, matches, anywhere } = found;
const summary = directorySummary(found, { state, service });
const nothing = filtered && matches.length === 0 && anywhere.length === 0;

const checks = [
  { term: 'We check', detail: 'That each accountant here is a member of the club, and that the practice is real and theirs: its name, its town and any website.' },
  { term: 'We do not check', detail: 'The quality of their work. The club does not vouch for anyone listed, and does not check qualifications, registrations or insurance.' },
  { term: 'They declare', detail: 'That they hold the qualifications, registrations and professional indemnity cover that the services they list require.' },
  { term: 'Before you engage', detail: 'Ask to see what they hold. Agree the work and the fee in writing, and keep the engagement letter.' },
  { term: 'Who stays listed', detail: 'Members only. A practice leaves the directory when its accountant leaves the club.' },
];
---

<Page title="Find an accountant" description="Accountants in practice across Malaysia who are members of The Rest Is Accountancy. Pick your state and the work you need, then contact them directly.">
  <PageHead
    label="Find an accountant"
    title="Find an accountant for your business."
    lead="Every practice here is run by a member of The Rest Is Accountancy, a club for accountants in practice. Pick your state and the work you need, then contact them directly. Your enquiry goes straight to them."
  />

  <section class="sec wrap" id="practices" aria-labelledby="practices-title">
    <div class="rail">
      <span class="no serif">N°1</span>
      <h2 class="head" id="practices-title">Practices</h2>
      {
        total > 0 && (
          <form class="filter" method="get" action="/directory#practices" role="search" aria-label="Filter the practices">
            <div class="field">
              <label for="state">State</label>
              <select class="input" id="state" name="state">
                <option value="">All of Malaysia</option>
                {states.map((s) => <option selected={s === state}>{s}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="service">The work you need</label>
              <select class="input" id="service" name="service">
                <option value="">Any service</option>
                {services.map((s) => <option value={s.slug} selected={s.slug === service}>{s.label}</option>)}
              </select>
            </div>
            <div class="go">
              <button class="btn" type="submit">Show practices</button>
              {filtered && <a href="/directory#practices">Clear the filter</a>}
            </div>
          </form>
        )
      }
    </div>
    <div class="results">
      {
        total === 0 ? (
          <p class="empty">No practices are listed yet. Members of the club are adding theirs, so check back soon.</p>
        ) : (
          <>
            <p class="count serif">{summary}</p>
            {nothing && (
              <p class="empty">
                Try another state or service, or <a href="/directory#practices">clear the filter</a> to see all {numberWord(total)}.
              </p>
            )}
            {matches.length > 0 && (
              <ol class="entries" aria-label={state ? `Practices in ${state}` : 'Practices'}>
                {matches.map((listing) => <li><ListingEntry listing={listing} /></li>)}
              </ol>
            )}
            {anywhere.length > 0 && (
              <>
                <p class="label group" id="anywhere-title">Based elsewhere, taking clients anywhere in Malaysia</p>
                <ol class="entries" aria-labelledby="anywhere-title">
                  {anywhere.map((listing) => <li><ListingEntry listing={listing} /></li>)}
                </ol>
              </>
            )}
          </>
        )
      }
    </div>
  </section>

  <Section id="checks" no={2} title="What does the club check?" intro="Enough for you to know who you are dealing with. Not their work.">
    <dl class="facts">{checks.map(({ term, detail }) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}</dl>
    <p class="small aside">Are you an accountant? Members of the club can list their practice here. <a href="/membership">About membership</a>.</p>
  </Section>
</Page>

<style>
  .no { display: block; font-size: clamp(3.5rem, 2.4rem + 3.6vw, 6.5rem); line-height: .82; letter-spacing: -.06em; }
  .rail .head { margin: var(--space-5) 0 var(--space-3); }
  .rail p { margin: 0; max-width: 38ch; }
  .filter { display: grid; gap: var(--space-4); max-width: 420px; margin-top: var(--space-5); }
  .go { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .results { display: grid; align-content: start; gap: var(--space-5); }
  .count { margin: 0; font-size: var(--size-head); line-height: 1.15; text-wrap: balance; }
  .empty { margin: 0; padding-block: var(--space-5); border-block: var(--stroke-hair) solid var(--ink); max-width: 60ch; }
  .entries { margin: 0; padding: 0; list-style: none; border-top: var(--stroke-rule) solid var(--ink); }
  .entries > li { border-bottom: var(--stroke-hair) solid var(--ink); }
  .group { margin: var(--space-6) 0 0; }
  .aside { margin: var(--space-6) 0 0; max-width: 60ch; }
  @media (min-width: 1000px) { .rail { position: sticky; top: calc(var(--bar) + 40px); align-self: start; } }
</style>
