---
import type { GetStaticPaths } from 'astro';
import Closing from '../../components/Closing.astro';
import PageHead from '../../components/PageHead.astro';
import PostList from '../../components/PostList.astro';
import Section from '../../components/Section.astro';
import Signup from '../../components/Signup.astro';
import { columnPath, columns } from '../../data/columns.ts';
import Page from '../../layouts/Page.astro';
import { allPosts } from '../../server/posts.ts';

export const getStaticPaths = (async ({ paginate }) => paginate(await allPosts(), { pageSize: 20 })) satisfies GetStaticPaths;

const { page } = Astro.props;
const first = page.currentPage === 1;
---

<Page signup={!first} title={first ? 'Newsletter' : `Newsletter, page ${page.currentPage}`} description="The Rest Is Accountancy’s newsletter: essays, the podcast, the weekly brief and software tested on practice work. Free.">
  <PageHead label="Newsletter" title="The rest, written down." lead="Essays from the hosts, every episode of the podcast, the week’s practice news and software tried on real work. Free to read, free by email." />
  {
    first && (
      <section class="wrap capture">
        <Signup source="newsletter" title="Get it by email." />
      </section>
    )
  }
  <Section id="columns" no={1} title="What is in it?" intro="Six columns. Each post sits in one.">
    <ul class="ruled columns">
      {columns.map((column) => <li><a class="serif" href={columnPath(column)}>{column.name}</a><span class="small">{column.tagline}</span></li>)}
    </ul>
  </Section>
  <Section id="posts" no={2} title="What is new?" intro={page.data.length ? 'Newest first.' : 'The first posts are on their way. Subscribe and they will reach you.'}>
    {page.data.length > 0 && <PostList posts={page.data} />}
    {
      page.lastPage > 1 && (
        <nav class="pager" aria-label="Newsletter pages">
          {page.url.prev ? <a href={page.url.prev} rel="prev">Newer</a> : <span />}
          <span class="small">Page {page.currentPage} of {page.lastPage}</span>
          {page.url.next ? <a href={page.url.next} rel="next">Older</a> : <span />}
        </nav>
      )
    }
  </Section>
  <Closing title="Read it here. Work it through in the club." lead="Each post’s topic is a programme. Members take it from reading to doing, with the hosts and each other." />
</Page>

<style>
  .capture { padding-block: clamp(40px, 5vw, 64px); }
  .columns li { display: grid; gap: var(--space-1); }
  .columns a { font-size: var(--size-head); line-height: 1.15; text-decoration: none; }
  .columns a:hover { text-decoration: underline; text-decoration-thickness: var(--stroke-hair); }
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-4); padding-block: var(--space-4); }
  .pager a { font-weight: 600; }
  .pager a[rel="next"] { justify-self: end; }
</style>
