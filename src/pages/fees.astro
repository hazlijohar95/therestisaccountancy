---
import { actions, isInputError } from 'astro:actions';
import PageHead from '../components/PageHead.astro';
import Section from '../components/Section.astro';
import { confidence, FEE_FIGURES, feeChoices, feeFigures, feeState, GROUP_MIN, PUBLISH_MIN, standardClient, type ChoiceKey } from '../data/fees.ts';
import Page from '../layouts/Page.astro';
import { postedFields } from '../lib/form.ts';
import { capitalised, formAction, formatDay, numberWord } from '../lib/format.ts';
import type { Edition, Spread } from '../server/fees.ts';

export const prerender = false;

const answered = Astro.getActionResult(actions.answerFeeSurvey);
if (answered?.data) return Astro.redirect('/fees?answered#answer');

const fieldErrors: Partial<Record<string, string[]>> = answered?.error && isInputError(answered.error) ? answered.error.fields : {};
const failure = answered?.error && !isInputError(answered.error) ? answered.error.message : null;
const posted = answered?.error ? await postedFields(Astro.request) : () => '';
const errorOf = (name: string) => fieldErrors[name]?.[0];

const { fees, member } = Astro.locals;
const [current, editions] = await Promise.all([fees.current(), fees.editions()]);
const published = editions.filter((e) => e.status === 'published');
const host = member?.role === 'admin';
const asked = Number(Astro.url.searchParams.get('edition'));
/* Hosts can open any year here to see what publishing it would show. Everyone else sees only published years. */
const chosen = editions.find((e) => e.edition === asked && (e.status === 'published' || host)) ?? published[0];
const report = chosen ? await fees.report(chosen.edition) : null;
const otherYears = published.filter((e) => e.edition !== report?.edition);
const thanked = Astro.url.searchParams.has('answered');

const rm = (n: number) => `RM ${Math.round(n).toLocaleString('en-MY')}`;
const middleHalf = (s: Spread) => `${rm(s.p25)}–${Math.round(s.p75).toLocaleString('en-MY')}`;
const place = (s: Spread, scale: number) => {
  const at = (n: number) => `${((n / scale) * 100).toFixed(2)}%`;
  return `--lo: ${at(s.p25)}; --mid: ${at(s.median)}; --hi: ${at(s.p75)}`;
};

const soFar = (e: Edition) =>
  e.responses === 0
    ? `Nobody has answered the ${e.edition} survey yet.`
    : `${capitalised(e.responses === 1 ? 'one person has' : `${numberWord(e.responses)} people have`)} answered the ${e.edition} survey so far.`;
const until = (e: Edition) => (e.responses >= PUBLISH_MIN ? 'once a host has read every answer' : `once ${PUBLISH_MIN} have answered and a host has read every answer`);
const practice: readonly ChoiceKey[] = ['stage', 'years', 'team', 'niche', 'pricing'];
const open = current.status !== 'published';

const resultsIntro = !report
  ? 'Not out yet.'
  : report.publishedAt
    ? `From ${report.responses} answers, published ${formatDay(report.publishedAt)}.`
    : `A preview of ${report.responses} answers. Not published, so only hosts can see it.`;
---

<Page title="Fee survey" description="What accountants in Malaysia charge: an anonymous yearly survey of hourly rates, bookkeeping fees and tax return fees, with the results free to read.">
  <PageHead
    label="Fee survey"
    title="What do accountants in Malaysia charge?"
    lead="Few accountants know what anyone else charges, so most set their fees blind. Once a year the club asks practitioners what they charge, anonymously, and publishes what it learns for anyone to read."
  >
    {open && !thanked && <a class="btn" href="#answer">Answer the {current.edition} survey</a>}
  </PageHead>

  <Section id="results" no={1} title={report ? `The ${report.edition} results` : 'The results'} intro={resultsIntro}>
    {
      report ? (
        <div class="report">
          {report.figures.map((f) => {
            const copy = feeFigures[f.figure];
            return (
              <section class="figure" aria-labelledby={`figure-${f.figure}`}>
                <h3 class="label" id={`figure-${f.figure}`}>{copy.label}</h3>
                {f.everyone === null ? (
                  <p class="none">Fewer than {GROUP_MIN} people gave this fee, so it is not shown.</p>
                ) : (
                  <>
                    <p class="headline">
                      <span class="big serif">{rm(f.everyone.median)}</span>
                      <span>{copy.per}, the median of {f.everyone.n} answers.</span>
                    </p>
                    <div class="scroll">
                      <table class="ledger spreads">
                        <caption class="sr">{copy.label} by group. {f.everyone.n} answered.</caption>
                        <thead>
                          <tr>
                            <th scope="col">Group</th>
                            <th scope="col">Answers</th>
                            <th scope="col">Median</th>
                            <th scope="col" class="half">
                              Middle half
                              <span class="axis" aria-hidden="true"><span>RM 0</span><span>{rm(f.scale)}</span></span>
                            </th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr class="everyone">
                            <th scope="row">Everyone</th>
                            <td>{f.everyone.n}</td>
                            <td>{rm(f.everyone.median)}</td>
                            <td class="half">{middleHalf(f.everyone)}<span class="bar" style={place(f.everyone, f.scale)} aria-hidden="true" /></td>
                          </tr>
                        </tbody>
                        {f.cuts.map((cut) => (
                          <tbody>
                            <tr class="cut"><th scope="colgroup" colspan="4">{cut.title}</th></tr>
                            {cut.groups.map((g) =>
                              g.spread ? (
                                <tr>
                                  <th scope="row">{g.label}</th>
                                  <td>{g.spread.n}</td>
                                  <td>{rm(g.spread.median)}</td>
                                  <td class="half">{middleHalf(g.spread)}<span class="bar" style={place(g.spread, f.scale)} aria-hidden="true" /></td>
                                </tr>
                              ) : (
                                <tr class="few">
                                  <th scope="row">{g.label}</th>
                                  <td colspan="3">Fewer than {GROUP_MIN} answers</td>
                                </tr>
                              ),
                            )}
                          </tbody>
                        ))}
                      </table>
                    </div>
                  </>
                )}
              </section>
            );
          })}
          <dl class="facts">
            <div><dt>The client</dt><dd>{standardClient} Every fee is for this one client, so answers compare like with like.</dd></div>
            <div><dt>Median</dt><dd>The middle answer. Half charge more, half charge less.</dd></div>
            <div><dt>Middle half</dt><dd>From the 25th to the 75th percentile, where half of all answers fall. Each line draws it on one scale from RM 0, with a tick at the median.</dd></div>
            <div><dt>Small groups</dt><dd>A group of fewer than {GROUP_MIN} is not shown, so no one answer can be picked out.</dd></div>
            <div><dt>Checked</dt><dd>A host reads every answer before the results go up and deletes any that are plainly made up.</dd></div>
          </dl>
          {
            otherYears.length > 0 && (
              <nav class="years small" aria-label="Other years">
                <span>Other years</span>
                {otherYears.map((e) => <a href={`/fees?edition=${e.edition}#results`}>{e.edition}</a>)}
              </nav>
            )
          }
        </div>
      ) : (
        <div class="waiting">
          <p class="count"><span class="big serif">{current.responses}</span><span>{current.responses === 1 ? 'answer' : 'answers'} so far</span></p>
          <span class="progress" style={`--done: ${Math.min(100, (current.responses / PUBLISH_MIN) * 100).toFixed(2)}%`} aria-hidden="true" />
          <p>{soFar(current)} The results go up here {until(current)}.</p>
          <p>Anyone can fill in a form like this, so a person checks the answers before the club puts its name to them. A group of fewer than {GROUP_MIN} is never shown, so no one answer can be picked out.</p>
        </div>
      )
    }
  </Section>

  <Section
    id="answer"
    no={2}
    title={thanked ? `The ${current.edition} survey` : open ? `Answer the ${current.edition} survey` : `The ${current.edition} survey has closed`}
    intro="Two minutes. The form asks for no name or email, and the club keeps nothing that says who you are."
  >
    {
      thanked ? (
        <div class="thanks" role="status">
          <p class="head serif">Thank you. Your answers are in.</p>
          <p>
            The {current.edition} results will appear on this page, under <a href="#results">the results</a>, {until(current)}. {soFar(current)}
          </p>
          <p class="small">Know someone who sets fees? Send them this page. The more who answer, the more groups have enough answers to show.</p>
        </div>
      ) : !open ? (
        <p class="closed">The {current.edition} survey closed when its results went up. The {current.edition + 1} survey opens on 1 January.</p>
      ) : (
        <form method="POST" action={`${formAction(Astro.url, actions.answerFeeSurvey)}#answer`} class="survey">
          {report && report.edition !== current.edition && <p class="small">{soFar(current)}</p>}
          {failure && <p class="error" role="alert">{failure}</p>}

          <div class="part">
            <h3 class="label">Your practice</h3>
            {practice.map((key) => {
              const error = errorOf(key);
              return (
                <fieldset class="choice" aria-describedby={error ? `${key}-error` : undefined}>
                  <legend>{feeChoices[key].label}</legend>
                  <div class="options">
                    {feeChoices[key].options.map((o) => (
                      <label class="option">
                        <input type="radio" name={key} value={o.slug} required checked={posted(key) === o.slug} />
                        <span>{o.label}</span>
                      </label>
                    ))}
                  </div>
                  {error && <span class="error" id={`${key}-error`}>{error}</span>}
                </fieldset>
              );
            })}
            <div class="field">
              <label for="state">{feeState.label}</label>
              <select class="input" id="state" name="state" required aria-invalid={errorOf('state') ? 'true' : undefined} aria-describedby={errorOf('state') ? 'state-error' : undefined}>
                <option value="" disabled selected={!posted('state')}>Choose a state</option>
                {feeState.options.map((s) => <option selected={posted('state') === s}>{s}</option>)}
              </select>
              {errorOf('state') && <span class="error" id="state-error">{errorOf('state')}</span>}
            </div>
          </div>

          <div class="part">
            <h3 class="label">Your fees</h3>
            <div class="client">
              <p class="label">The client</p>
              <p>{standardClient}</p>
              <p class="small">Answer each fee for this client, so every answer is about the same work. Leave out any you do not charge, but give at least one.</p>
              {errorOf('fees') && <p class="error" role="alert">{errorOf('fees')}</p>}
            </div>
            {FEE_FIGURES.map((figure) => {
              const copy = feeFigures[figure];
              const error = errorOf(figure);
              const ids = [`${figure}-hint`, error ? `${figure}-error` : null].filter(Boolean).join(' ');
              return (
                <div class="field">
                  <label for={figure}>{copy.question}</label>
                  <div class="unit" data-unit="RM">
                    <input class="input" id={figure} name={figure} type="number" inputmode="numeric" min={copy.min} max={copy.max} step="1" value={posted(figure)} aria-describedby={ids} aria-invalid={error ? 'true' : undefined} />
                  </div>
                  <span class="hint" id={`${figure}-hint`}>{copy.hint}</span>
                  {error && <span class="error" id={`${figure}-error`}>{error}</span>}
                </div>
              );
            })}
            <fieldset class="choice" aria-describedby={errorOf('confidence') ? 'confidence-hint confidence-error' : 'confidence-hint'}>
              <legend>{confidence.label}</legend>
              <span class="hint" id="confidence-hint">{confidence.hint}</span>
              <div class="scale">
                {confidence.scale.map((n) => (
                  <label class="point">
                    <input type="radio" name="confidence" value={n} required checked={posted('confidence') === String(n)} />
                    <span>{n}</span>
                  </label>
                ))}
              </div>
              {errorOf('confidence') && <span class="error" id="confidence-error">{errorOf('confidence')}</span>}
            </fieldset>
          </div>

          <div class="trap" aria-hidden="true">
            <label for="fees-trap">Leave this empty</label>
            <input id="fees-trap" name="trap" type="text" tabindex="-1" autocomplete="off" data-1p-ignore data-lpignore="true" />
          </div>
          <button class="btn" type="submit">Send my answers</button>
        </form>
      )
    }
  </Section>
</Page>

<style>
  .report { display: grid; gap: var(--space-8); }
  .figure { display: grid; gap: var(--space-4); }
  .figure h3, .none { margin: 0; }
  .headline { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); margin: 0; }
  .big { font-size: clamp(3rem, 2rem + 4vw, 5.5rem); line-height: .9; letter-spacing: -.04em; font-variant-numeric: lining-nums tabular-nums; }
  .scroll { overflow-x: auto; }

  .spreads { border-top: var(--stroke-rule) solid var(--ink); }
  .spreads th[scope="row"] { font-weight: 400; }
  .spreads .half { width: 42%; text-align: start; }
  .axis { display: flex; justify-content: space-between; min-width: 8rem; margin-top: var(--space-1); font-weight: 400; }
  .everyone th[scope="row"], .everyone td { font-weight: 600; }
  .cut th { padding-top: var(--space-5); font: 600 var(--size-label)/1.3 var(--font-sans); text-align: start; }
  .few td { text-align: start; }

  /* The middle half as a rule on a hairline axis from RM 0, with a tick at the median. Positions come from the row. */
  .bar { position: relative; display: block; min-width: 8rem; height: 14px; margin-top: var(--space-2); background: linear-gradient(var(--ink), var(--ink)) center / 100% var(--stroke-hair) no-repeat; }
  .bar::before { content: ""; position: absolute; top: 50%; left: var(--lo); width: calc(var(--hi) - var(--lo)); height: var(--stroke-rule); translate: 0 -50%; background: var(--ink); }
  .bar::after { content: ""; position: absolute; inset-block: 0; left: var(--mid); width: var(--stroke-rule); translate: -50% 0; background: var(--ink); }

  .facts { max-width: 760px; }
  .years { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); font-weight: 600; }

  .waiting { display: grid; gap: var(--space-4); max-width: 30em; }
  .waiting p { margin: 0; }
  .count { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3); }
  .progress { display: block; height: var(--stroke-heavy); background: linear-gradient(var(--ink), var(--ink)) left / var(--done) 100% no-repeat, linear-gradient(var(--ink), var(--ink)) center / 100% var(--stroke-hair) no-repeat; }

  .thanks { display: grid; gap: var(--space-4); max-width: 30em; padding-block: var(--space-5); border-block: var(--stroke-rule) solid var(--ink); }
  .thanks p { margin: 0; }
  .closed { margin: 0; max-width: 30em; }

  .survey { display: grid; gap: var(--space-8); max-width: 640px; }
  .survey > p { margin: 0; }
  .part { display: grid; gap: var(--space-6); }
  .part > h3 { margin: 0; padding-bottom: var(--space-3); border-bottom: var(--stroke-rule) solid var(--ink); }
  .choice { display: grid; gap: var(--space-2); min-width: 0; margin: 0; padding: 0; border: 0; }
  .choice legend { margin-bottom: var(--space-2); padding: 0; font: 600 var(--size-small)/1.3 var(--font-sans); }
  .options { display: grid; }
  .option { display: flex; align-items: center; gap: var(--space-3); min-height: 44px; cursor: pointer; }
  .option input { flex: none; width: 1.25rem; height: 1.25rem; margin: 0; accent-color: var(--ink); }
  .scale { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 52px); gap: var(--space-2); }
  .point { position: relative; cursor: pointer; }
  .point input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .point span { display: grid; place-items: center; width: 100%; height: 52px; border: var(--edge) solid var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; transition: background-color var(--motion-quick), color var(--motion-quick); }
  .point input:checked + span { background: var(--ink); color: var(--bg); }
  @media (forced-colors: active) { .point input:checked + span { forced-color-adjust: none; background: SelectedItem; color: SelectedItemText; } .bar::before, .bar::after { background: CanvasText; } }
  .point input:focus-visible + span { outline: var(--stroke-heavy) solid var(--ink); outline-offset: 3px; }
  .client { display: grid; gap: var(--space-2); padding-block: var(--space-4); border-block: var(--stroke-hair) solid var(--ink); }
  .client p { margin: 0; }
  .error { color: var(--alert); font-size: var(--size-small); font-weight: 600; }
  .survey .btn { justify-self: start; }
  .trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
