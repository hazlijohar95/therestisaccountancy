---
import { actions } from 'astro:actions';
import { INVITE_DAYS, MEMBER_INVITES } from '../../data/social.ts';
import Social from '../../layouts/Social.astro';
import { formAction, formatDay } from '../../lib/format.ts';
import { addressed, signInPath, socialPath } from '../../server/paths.ts';
import type { InviteState } from '../../server/social-invites.ts';

export const prerender = false;

/* A member's invite links. Each works once, for INVITE_DAYS; the link shows once, since only its hash is kept. */
const to = (path: string) => socialPath(Astro.url, path);
const { member, profile, socialInvites } = Astro.locals;
if (!member) return Astro.redirect(signInPath(Astro.url, '/invites'));
if (!profile) return Astro.redirect(to('/edit'));

const revoked = Astro.getActionResult(actions.revokeInvite);
if (revoked?.data) return Astro.redirect(to('/invites?done=revoked'));
const created = Astro.getActionResult(actions.createInvite);
const failure = created?.error?.message ?? revoked?.error?.message ?? null;

const allowance = await socialInvites.allowance(member.id);
const mine = await socialInvites.mine(member.id);
const done = Astro.url.searchParams.get('done');
const here = addressed(Astro.url);
here.search = '';
const action = (which: { toString(): string }) => formAction(here, which);
const STATE: Record<InviteState, string> = { live: 'Unused', used: 'Used', expired: 'Ran out', revoked: 'Revoked' };
const left = (n: number) => (n === 1 ? '1 invite left' : `${n} invites left`);
---

<Social title="Invites" noindex>
  <div class="page narrow">
    <div class="page-head">
      <div>
        <p class="kicker">Invites</p>
        <h1 class="title">Bring someone in.</h1>
        <p class="lead">Social is invite-only. Invite people you know from the profession: their profile says you invited them.</p>
      </div>
    </div>
    {done === 'revoked' && <p class="note" role="status">Revoked. The link no longer works, and the invite is yours again.</p>}
    {failure && <p class="error" role="alert">{failure}</p>}
    {
      created?.data && (
        <div class="invite-link">
          <p>
            <b>Your invite link.</b> Send it to one person. It works once, for {INVITE_DAYS} days, and shows only now: revoke it and make another if you lose it.
          </p>
          <label class="label-text" for="invite-link">Invite link</label>
          <input class="input" id="invite-link" readonly value={created.data.link} autofocus />
          <div class="actions">
            <button class="btn sm" type="button" data-copy="invite-link" hidden>Copy link</button>
          </div>
          <p class="small" data-copy-status aria-live="polite"></p>
        </div>
      )
    }
    <section class="panel card" aria-labelledby="make-title">
      <h2 class="head" id="make-title">{allowance.eligible ? left(allowance.left) : 'Invites open once you are ticked'}</h2>
      {
        allowance.eligible ? (
          <>
            <p>You have {MEMBER_INVITES} in all. A used one is spent; revoke one nobody has used and it comes back, as does one that runs out.</p>
            {allowance.left > 0 && (
              <form method="POST" action={action(actions.createInvite)}>
                <button class="btn" type="submit">Make an invite link</button>
              </form>
            )}
          </>
        ) : (
          <>
            <p>Every account here is one we know, so invites come from members with at least one ticked credential: a body, a licence, your work email or your workplace.</p>
            <a class="btn sm" href={to('/verify')}>Get ticked</a>
          </>
        )
      }
    </section>
    {
      mine.length > 0 && (
        <section class="panel card" aria-labelledby="sent-title">
          <h2 class="head" id="sent-title">Your links</h2>
          <ul class="queue">
            {mine.map((invite) => (
              <li class="queue-item">
                <div class="facts">
                  <p>
                    <b>{STATE[invite.state]}</b>
                    {invite.state === 'used' && invite.usedBy && (
                      <>
                        {' '}
                        by <a href={to(`/@${invite.usedBy}`)}>@{invite.usedBy}</a>
                      </>
                    )}
                    {invite.state === 'live' && ` · works until ${formatDay(invite.expiresAt)}`}
                  </p>
                </div>
                <span class="ago">Made {formatDay(invite.createdAt)}</span>
                {invite.state === 'live' && (
                  <div class="actions">
                    <form method="POST" action={action(actions.revokeInvite)}>
                      <input type="hidden" name="invite" value={invite.id} />
                      <button class="btn sm ghost" type="submit">
                        Revoke<span class="sr-only">: the link made {formatDay(invite.createdAt)}</span>
                      </button>
                    </form>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Social>

<script>
  import { wireCopyButtons } from '../../lib/copy.ts';

  wireCopyButtons();
</script>
