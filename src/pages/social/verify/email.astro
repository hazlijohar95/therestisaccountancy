---
import { actions } from 'astro:actions';
import Tick from '../../../components/social/Tick.astro';
import Social from '../../../layouts/Social.astro';
import { formAction } from '../../../lib/format.ts';
import { addressed, signInPath, socialPath, socialPathOf } from '../../../server/paths.ts';

export const prerender = false;

/*
 * The page a work-email link opens. Opening it confirms nothing: mail scanners open links too. The member who asked
 * confirms with a button, signed in, so a link sent to someone else's address can never tick a stranger's claim.
 */
const to = (path: string) => socialPath(Astro.url, path);
const confirmed = Astro.getActionResult(actions.confirmWorkEmail);
if (confirmed?.data) return Astro.redirect(to('/verify?step=work&done=confirmWorkEmail'));

const token = Astro.url.searchParams.get('token') ?? '';
const { member, socialClaims } = Astro.locals;
const pending = token ? await socialClaims.workEmail(token) : null;
const mine = member !== null && pending?.memberId === member.id;
const back = `${socialPathOf(Astro.url)}${Astro.url.search}`;
if (!pending) Astro.response.status = 404;
---

<Social title="Confirm your work email" noindex>
  <div class="page narrow">
    <section class="panel card" aria-labelledby="title">
      <p class="kicker">Work email</p>
      {
        !pending ? (
          <>
            <h1 class="head" id="title">This link no longer works.</h1>
            <p>It has been used, a newer one was sent, or seven days have passed. Send a new one from Get ticked.</p>
            <a class="btn" href={to('/verify?step=work')}>Get ticked</a>
          </>
        ) : !member ? (
          <>
            <h1 class="head" id="title">Sign in to confirm.</h1>
            <p>
              {pending.name}
              {pending.handle && ` (@${pending.handle})`} asked to show they work at <b>{pending.domain}</b>. If that is you, sign in and confirm.
            </p>
            <a class="btn" href={signInPath(Astro.url, back)}>Sign in</a>
            <p class="small">Not you? Close this page. Nothing changes.</p>
          </>
        ) : !mine ? (
          <>
            <h1 class="head" id="title">This link is for another account.</h1>
            <p>You are signed in as {member.name}. Sign in as the person who asked for it, or close this page. Nothing changes.</p>
          </>
        ) : (
          <form method="POST" action={formAction(addressed(Astro.url), actions.confirmWorkEmail)}>
            <h1 class="head" id="title">Confirm you work at {pending.domain}.</h1>
            <div class="result">
              <Tick source="email" state="pending" />
              <p>Your profile shows “Works at {pending.domain}”. It never shows the address.</p>
            </div>
            <input type="hidden" name="token" value={token} />
            {confirmed?.error && <p class="error" role="alert">{confirmed.error.message}</p>}
            <div class="panel-foot">
              <a class="btn ghost" href={to('/verify?step=work')}>Not now</a>
              <button class="btn" type="submit">Confirm</button>
            </div>
          </form>
        )
      }
    </section>
  </div>
</Social>
