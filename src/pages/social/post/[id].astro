---
import { actions, isInputError } from 'astro:actions';
import PostText from '../../../components/PostText.astro';
import Avatar from '../../../components/social/Avatar.astro';
import Flair from '../../../components/social/Flair.astro';
import PostCard from '../../../components/social/PostCard.astro';
import ReportDialog from '../../../components/social/ReportDialog.astro';
import { FLOOR_LIMITS, POST_JURISDICTIONS, ROOMS } from '../../../data/social.ts';
import Social from '../../../layouts/Social.astro';
import { postedFields } from '../../../lib/form.ts';
import { formAction, formatMoment } from '../../../lib/format.ts';
import { addressed, signInPath, socialPath, socialPathOf } from '../../../server/paths.ts';
import type { ThreadSort } from '../../../server/social-floor.ts';

export const prerender = false;

const to = (path: string) => socialPath(Astro.url, path);
const { member, socialFloor } = Astro.locals;
const postId = Number(Astro.params.id);
const params = Astro.url.searchParams;
const sort: ThreadSort = params.get('sort') === 'new' ? 'new' : 'top';
const here = to(`/post/${postId}`);

const results = {
  reply: Astro.getActionResult(actions.floorReply),
  editPost: Astro.getActionResult(actions.editFloorPost),
  editReply: Astro.getActionResult(actions.editFloorReply),
  removePost: Astro.getActionResult(actions.removeFloorPost),
  removeReply: Astro.getActionResult(actions.removeFloorReply),
  accept: Astro.getActionResult(actions.acceptReply) ?? Astro.getActionResult(actions.unacceptReply),
  useful: Astro.getActionResult(actions.markUseful) ?? Astro.getActionResult(actions.unmarkUseful),
  report: Astro.getActionResult(actions.report),
};
/* Writes land on a fresh page, so a refresh never sends them twice. Toggles render in place and keep focus. */
if (results.reply?.data) return Astro.redirect(`${here}?sort=new#reply-${results.reply.data.id}`);
if (results.editPost?.data) return Astro.redirect(here);
if (results.editReply?.data) return Astro.redirect(`${here}#reply-${results.editReply.data.reply}`);
if (results.removePost?.data) return Astro.redirect(to('/?done=deleted'));
if (results.removeReply?.data) return Astro.redirect(`${here}?done=reply-deleted#replies`);

const view = Number.isInteger(postId) && postId > 0 ? await socialFloor.thread(member?.id ?? null, postId, sort) : null;
if (!view) Astro.response.status = 404;
if (view?.state === 'locked') Astro.response.status = 403;

const editing = params.get('edit');
const posted = results.reply?.error || results.editPost?.error || results.editReply?.error ? await postedFields(Astro.request) : () => '';
const replyError = results.reply?.error && isInputError(results.reply.error) ? results.reply.error.fields.body?.[0] : undefined;
const editPostErrors = results.editPost?.error && isInputError(results.editPost.error) ? results.editPost.error.fields : {};
const editReplyError = results.editReply?.error && isInputError(results.editReply.error) ? results.editReply.error.fields.body?.[0] : undefined;
const failure =
  Object.values(results)
    .map((result) => (result?.error && !isInputError(result.error) ? result.error.message : null))
    .find(Boolean) ?? null;
const focus = results.useful?.data ? `useful-${results.useful.data.target}-${results.useful.data.id}` : results.accept?.data ? `accept-${results.accept.data.reply}` : null;
const status = results.useful?.data ? (results.useful.data.marked ? 'Marked useful.' : 'Unmarked.') : results.accept?.data ? (results.accept.data.accepted ? 'Marked as the answer.' : 'No longer the answer.') : null;
const action = (which: { toString(): string }) => formAction(addressed(Astro.url), which);
const roomName = (id: string) => ROOMS.find((room) => room.id === id)?.name ?? '';
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const sortHref = (next: ThreadSort) => `${here}${next === 'new' ? '?sort=new' : ''}#replies`;
---

<Social title={view?.state === 'open' ? view.post.title : view ? 'Practitioners’ room' : 'Not found'} description={view?.state === 'open' ? view.post.body.slice(0, 160) || undefined : undefined} section="floor">
  <div class="page thread">
    <a class="back" href={to('/')}>
      <svg aria-hidden="true"><use href="#i-back" /></svg>
      Floor
    </a>
    {
      !view ? (
        <div class="card empty">
          <h1 class="head">That post isn’t here any more.</h1>
          <a class="btn sm" href={to('/')}>Back to the Floor</a>
        </div>
      ) : view.state === 'locked' ? (
        <div class="card empty">
          <h1 class="head">This post is in the practitioners’ room.</h1>
          <p>Practitioners talk shop there. It needs a ticked practising licence to read.</p>
          {member ? <a class="btn sm" href={to('/verify?step=licence')}>Get ticked</a> : <a class="btn sm" href={signInPath(Astro.url, socialPathOf(Astro.url))}>Sign in</a>}
        </div>
      ) : (
        <>
          {params.get('posted') === '1' && (
            <p class="note" role="status" data-posted>
              Posted to the Floor.
            </p>
          )}
          {params.get('done') === 'reply-deleted' && (
            <p class="note" role="status">
              Reply deleted.
            </p>
          )}
          {results.report?.data && (
            <p class="note" role="status">
              Report sent. A person on the team reads every one.
            </p>
          )}
          {status && (
            <p class="sr-only" role="status">
              {status}
            </p>
          )}
          {failure && (
            <p class="error" role="alert">
              {failure}
            </p>
          )}
          {editing === 'post' && view.post.editable ? (
            <form class="post edit-form" method="POST" action={action(actions.editFloorPost)} novalidate>
              <h1 class="head">Edit your post</h1>
              <input type="hidden" name="post" value={view.post.id} />
              <div class="field">
                <label for="edit-title">Title</label>
                <input class="input" id="edit-title" name="title" required maxlength={FLOOR_LIMITS.title} value={(results.editPost?.error && posted('title')) || view.post.title} aria-invalid={editPostErrors.title ? 'true' : undefined} aria-describedby={editPostErrors.title ? 'edit-title-error' : undefined} autofocus />
                {editPostErrors.title && <span class="error" id="edit-title-error">{editPostErrors.title[0]}</span>}
              </div>
              <div class="field">
                <label for="edit-body">Details · optional</label>
                <textarea class="input" id="edit-body" name="body" rows="6" maxlength={FLOOR_LIMITS.body} aria-invalid={editPostErrors.body ? 'true' : undefined} aria-describedby={editPostErrors.body ? 'edit-body-error' : undefined}>{(results.editPost?.error && posted('body')) || view.post.body}</textarea>
                {editPostErrors.body && <span class="error" id="edit-body-error">{editPostErrors.body[0]}</span>}
              </div>
              <div class="row2">
                <div class="field">
                  <label for="edit-room">Room</label>
                  <select class="input" id="edit-room" name="room">
                    {ROOMS.filter((room) => !room.locked || view.viewer.practitioner).map((room) => (
                      <option value={room.id} selected={room.id === view.post.room}>
                        {room.name}
                      </option>
                    ))}
                  </select>
                </div>
                <div class="field">
                  <label for="edit-jurisdiction">Jurisdiction</label>
                  <select class="input" id="edit-jurisdiction" name="jurisdiction">
                    {POST_JURISDICTIONS.map((j) => (
                      <option value={j} selected={j === view.post.jurisdiction}>
                        {j}
                      </option>
                    ))}
                  </select>
                </div>
              </div>
              <div class="row-end">
                <span class="small">Edits close {FLOOR_LIMITS.editMinutes} minutes after posting.</span>
                <span class="actions">
                  <a class="btn ghost" href={here}>Cancel</a>
                  <button class="btn" type="submit">Save</button>
                </span>
              </div>
            </form>
          ) : (
            <PostCard post={view.post} full signedIn={member !== null} focus={focus}>
              {(view.post.editable || view.post.mine || view.viewer.admin) && (
                <div class="owner-actions">
                  {view.post.editable && (
                    <a class="act" href={`${here}?edit=post`}>
                      <svg aria-hidden="true">
                        <use href="#i-edit" />
                      </svg>
                      Edit
                    </a>
                  )}
                  <details class="remove">
                    <summary class="act">{view.post.mine ? 'Delete' : 'Remove'}</summary>
                    <form method="POST" action={action(actions.removeFloorPost)}>
                      <input type="hidden" name="post" value={view.post.id} />
                      <p class="small">{view.post.mine ? 'Delete this post? Its replies go with it.' : 'Remove this post from the Floor? Its replies go with it.'}</p>
                      <button class="btn sm danger" type="submit">
                        {view.post.mine ? 'Delete post' : 'Remove post'}
                      </button>
                    </form>
                  </details>
                </div>
              )}
              {member && !view.post.mine && <ReportDialog target="post" id={view.post.id} about="this post" />}
            </PostCard>
          )}

          <section class="replies" id="replies" aria-labelledby="replies-title">
            <header class="replies-head">
              <h2 class="head" id="replies-title">
                {plural(view.replies.length, 'reply', 'replies')}
              </h2>
              <nav class="chips" aria-label="Sort replies">
                <a class="chip" href={sortHref('top')} aria-current={sort === 'top' ? 'page' : undefined}>
                  Top
                </a>
                <a class="chip" href={sortHref('new')} aria-current={sort === 'new' ? 'page' : undefined}>
                  Newest
                </a>
              </nav>
            </header>
            {view.replies.length === 0 && (
              <div class="empty card">
                <p>No replies yet. Be the first.</p>
              </div>
            )}
            {view.replies.map((reply) => {
              const usefulId = `useful-reply-${reply.id}`;
              const acceptId = `accept-${reply.id}`;
              const canAccept = view.post.mine && !reply.mine;
              return (
                <article class:list={['reply', { pinned: reply.accepted, corrects: reply.correction }]} id={`reply-${reply.id}`} aria-label={`Reply from ${reply.author.name}`}>
                  {reply.accepted && (
                    <p class="pin-label">
                      <svg aria-hidden="true">
                        <use href="#tk" />
                      </svg>
                      {reply.author.sealed ? 'Ticked answer' : 'Accepted answer'}
                    </p>
                  )}
                  <div class="by">
                    <a class="author" href={to(`/@${reply.author.handle}`)}>
                      <Avatar name={reply.author.name} track={reply.author.track} sealed={reply.author.sealed} size="sm" />
                      <span class="name-line">
                        {reply.author.name}
                        {reply.author.sealed && (
                          <svg class="seal" role="img" aria-label="Ticked">
                            <use href="#seal" />
                          </svg>
                        )}
                      </span>
                    </a>
                    <Flair track={reply.author.track} />
                    <span class="ago">
                      <time datetime={reply.createdAt}>{formatMoment(reply.createdAt)}</time>
                      {reply.editedAt && ' · edited'}
                    </span>
                  </div>
                  {reply.correction && (
                    <p class="correction">
                      <svg aria-hidden="true">
                        <use href="#i-flag" />
                      </svg>
                      <span>Correction from a member with the seal</span>
                    </p>
                  )}
                  {editing === `reply-${reply.id}` && reply.editable ? (
                    <form class="edit-form" method="POST" action={action(actions.editFloorReply)} novalidate>
                      <input type="hidden" name="reply" value={reply.id} />
                      <label class="label-text" for={`edit-reply-${reply.id}`}>
                        Edit your reply
                      </label>
                      <textarea class="input" id={`edit-reply-${reply.id}`} name="body" rows="4" maxlength={FLOOR_LIMITS.body} aria-invalid={editReplyError ? 'true' : undefined} aria-describedby={editReplyError ? `edit-reply-${reply.id}-error` : undefined} autofocus>{(results.editReply?.error && posted('body')) || reply.body}</textarea>
                      {editReplyError && (
                        <span class="error" id={`edit-reply-${reply.id}-error`}>
                          {editReplyError}
                        </span>
                      )}
                      <div class="actions">
                        <a class="btn sm ghost" href={`${here}#reply-${reply.id}`}>
                          Cancel
                        </a>
                        <button class="btn sm" type="submit">
                          Save
                        </button>
                      </div>
                    </form>
                  ) : (
                    <PostText text={reply.body} />
                  )}
                  <div class="foot-row">
                    {member && !reply.mine ? (
                      <form method="POST" action={action(reply.usefulByViewer ? actions.unmarkUseful : actions.markUseful)}>
                        <input type="hidden" name="target" value="reply" />
                        <input type="hidden" name="id" value={reply.id} />
                        <button class="act" type="submit" id={usefulId} aria-pressed={reply.usefulByViewer ? 'true' : 'false'} autofocus={focus === usefulId ? true : undefined}>
                          <svg aria-hidden="true">
                            <use href="#i-up" />
                          </svg>
                          {reply.useful} useful
                        </button>
                      </form>
                    ) : (
                      <span class="act">
                        <svg aria-hidden="true">
                          <use href="#i-up" />
                        </svg>
                        {reply.useful} useful
                      </span>
                    )}
                    {canAccept && (
                      <form method="POST" action={action(reply.accepted ? actions.unacceptReply : actions.acceptReply)}>
                        <input type="hidden" name="reply" value={reply.id} />
                        <button class="act" type="submit" id={acceptId} aria-pressed={reply.accepted ? 'true' : 'false'} autofocus={focus === acceptId ? true : undefined}>
                          <svg aria-hidden="true">
                            <use href="#tk" />
                          </svg>
                          Mark as the answer
                        </button>
                      </form>
                    )}
                    <span class="spacer" />
                    {reply.editable && (
                      <a class="act" href={`${here}?edit=reply-${reply.id}#reply-${reply.id}`}>
                        Edit<span class="sr-only"> your reply</span>
                      </a>
                    )}
                    {(reply.mine || view.viewer.admin) && (
                      <details class="remove">
                        <summary class="act">
                          {reply.mine ? 'Delete' : 'Remove'}
                          <span class="sr-only"> reply from {reply.author.name}</span>
                        </summary>
                        <form method="POST" action={action(actions.removeFloorReply)}>
                          <input type="hidden" name="reply" value={reply.id} />
                          <button class="btn sm danger" type="submit">
                            {reply.mine ? 'Delete reply' : 'Remove reply'}
                          </button>
                        </form>
                      </details>
                    )}
                    {member && !reply.mine && <ReportDialog target="reply" id={reply.id} about={`the reply from ${reply.author.name}`} />}
                  </div>
                </article>
              );
            })}

            {view.viewer.hasHandle ? (
              <form class="reply-form card" method="POST" action={action(actions.floorReply)} novalidate>
                <input type="hidden" name="post" value={view.post.id} />
                <label for="reply-body" class="label-text">
                  Your reply
                </label>
                <textarea class="input" id="reply-body" name="body" rows="4" maxlength={FLOOR_LIMITS.body} placeholder="What you’d do, and why." aria-invalid={replyError ? 'true' : undefined} aria-describedby={replyError ? 'reply-body-error' : undefined} autofocus={replyError ? true : undefined}>{results.reply?.error ? posted('body') : ''}</textarea>
                {replyError && (
                  <span class="error" id="reply-body-error">
                    {replyError}
                  </span>
                )}
                {view.viewer.sealed && (
                  <label class="check">
                    <input type="checkbox" name="correction" checked={results.reply?.error && posted('correction') === 'on' ? true : undefined} />
                    <span>
                      <b>This corrects the post</b>
                      It shows in red on the post, as a correction from a member with the seal.
                    </span>
                  </label>
                )}
                <div class="row-end">
                  <span class="small">Cite the standard or section if you lean on one.</span>
                  <button class="btn" type="submit">
                    Reply
                  </button>
                </div>
              </form>
            ) : (
              <div class="reply-form card">
                <p class="small">
                  {member ? (
                    <>
                      <a href={to('/edit')}>Claim your handle</a> to reply.
                    </>
                  ) : (
                    <>
                      <a href={signInPath(Astro.url, socialPathOf(Astro.url))}>Sign in</a> or <a href={to('/sign-up')}>sign up free</a> to reply.
                    </>
                  )}
                </p>
              </div>
            )}
          </section>
          <p class="small">
            In {roomName(view.post.room)}. Ticks confirm credentials. They never vouch for advice.
          </p>
        </>
      )
    }
  </div>
</Social>

<script>
  import { DRAFT_KEY } from '../../../lib/drafts.ts';

  /* The post landed, so the draft it came from is done with. */
  if (document.querySelector('[data-posted]')) {
    try {
      localStorage.removeItem(DRAFT_KEY);
    } catch {
      /* Storage can be blocked. Nothing to clear then. */
    }
  }
</script>
