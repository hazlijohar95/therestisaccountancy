---
import { actions, isInputError } from 'astro:actions';
import { REQUEST_LIMITS } from '../../data/social.ts';
import Social from '../../layouts/Social.astro';
import { formAction } from '../../lib/format.ts';
import { postedFields } from '../../lib/form.ts';
import { addressed, signInPath, socialPath } from '../../server/paths.ts';

export const prerender = false;

/* Social is invite-only. Without an invite, people ask here, and the team reads every request. */
const to = (path: string) => socialPath(Astro.url, path);
if (Astro.locals.profile) return Astro.redirect(to(`/@${Astro.locals.profile.handle}`));

const result = Astro.getActionResult(actions.requestToJoin);
const fieldErrors = result?.error && isInputError(result.error) ? result.error.fields : {};
const refusal = result?.error && !isInputError(result.error) ? result.error : null;
/* Already asked: said as news, not as a mistake. */
const waiting = refusal?.code === 'CONFLICT' ? refusal.message : null;
const failure = refusal && !waiting ? refusal.message : null;
const errors = { name: fieldErrors.name?.[0], email: fieldErrors.email?.[0], about: fieldErrors.about?.[0], link: fieldErrors.link?.[0] };
const typed = result?.error ? await postedFields(Astro.request) : () => '';
const first = (['name', 'email', 'about', 'link'] as const).find((field) => errors[field]);
const invalid = (field: keyof typeof errors) => (errors[field] ? 'true' : undefined);
const describedBy = (field: keyof typeof errors, hint?: string) => [hint, errors[field] ? `${field}-error` : undefined].filter(Boolean).join(' ') || undefined;
---

<Social title="Request to join" description="The Rest Is Accountancy Social is free and invite-only. Ask to join and the team reads every request.">
  <div class="page narrow">
    {
      result?.data ? (
        <section class="panel card" aria-labelledby="done-title">
          <p class="kicker">Request sent</p>
          <h1 class="head" id="done-title">Thanks. We will be in touch.</h1>
          <p>Someone on the team reads every request. We email <b>{result.data.email}</b> either way.</p>
          <p class="small">If a member sends you an invite in the meantime, it works straight away.</p>
          <a class="btn sm ghost" href={to('/')}>Read the Floor</a>
        </section>
      ) : (
        <>
          <div class="page-head">
            <div>
              <p class="kicker">Request to join</p>
              <h1 class="title">Ask to join.</h1>
              <p class="lead">Social is free and invite-only, so every account here is one we know. Anyone can read. To post, use an invite, or ask here.</p>
            </div>
          </div>
          {waiting && (
            <p class="note" role="status">
              {waiting}
            </p>
          )}
          <form class="panel card" method="POST" action={formAction(addressed(Astro.url), actions.requestToJoin)} novalidate>
            <div class="field">
              <label for="name">Your name</label>
              <input class="input" id="name" name="name" required maxlength="60" autocomplete="name" value={typed('name')} aria-invalid={invalid('name')} aria-describedby={describedBy('name')} autofocus={first === 'name' ? true : undefined} />
              {errors.name && <span class="error" id="name-error">{errors.name}</span>}
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input class="input" id="email" name="email" type="email" required autocomplete="email" value={typed('email')} aria-invalid={invalid('email')} aria-describedby={describedBy('email', 'email-hint')} autofocus={first === 'email' ? true : undefined} />
              <span class="hint" id="email-hint">We reply here. Nobody else sees it.</span>
              {errors.email && <span class="error" id="email-error">{errors.email}</span>}
            </div>
            <div class="field">
              <label for="about">Who you are, and where you post</label>
              <input class="input" id="about" name="about" required maxlength={REQUEST_LIMITS.about} value={typed('about')} placeholder="Audit senior in KL. I post on LinkedIn about MFRS." aria-invalid={invalid('about')} aria-describedby={describedBy('about', 'about-hint')} autofocus={first === 'about' ? true : undefined} />
              <span class="hint" id="about-hint">One line is plenty.</span>
              {errors.about && <span class="error" id="about-error">{errors.about}</span>}
            </div>
            <div class="field">
              <label for="link">A profile of yours · optional</label>
              <input class="input" id="link" name="link" type="url" inputmode="url" maxlength={REQUEST_LIMITS.link} value={typed('link')} placeholder="https://www.linkedin.com/in/…" aria-invalid={invalid('link')} aria-describedby={describedBy('link')} autofocus={first === 'link' ? true : undefined} />
              {errors.link && <span class="error" id="link-error">{errors.link}</span>}
            </div>
            <div class="trap" aria-hidden="true">
              <label for="request-trap">Leave this empty</label>
              <input id="request-trap" name="trap" type="text" tabindex="-1" autocomplete="off" data-1p-ignore data-lpignore="true" />
            </div>
            {failure && <p class="error" role="alert">{failure}</p>}
            <div class="panel-foot">
              <span class="small">Have an account? <a href={signInPath(Astro.url, '/me')}>Sign in</a>.</span>
              <button class="btn" type="submit">Send request</button>
            </div>
          </form>
        </>
      )
    }
  </div>
</Social>
