---
import { actions, isInputError } from 'astro:actions';
import Avatar from '../../components/social/Avatar.astro';
import Flair from '../../components/social/Flair.astro';
import PostCard from '../../components/social/PostCard.astro';
import ReportDialog from '../../components/social/ReportDialog.astro';
import Tick from '../../components/social/Tick.astro';
import { SERVICES, SHELF_KINDS, SHELF_LIMITS, TICK_SOURCES, VOUCHES_TO_TICK, type TickSource } from '../../data/social.ts';
import Social from '../../layouts/Social.astro';
import { postedFields } from '../../lib/form.ts';
import { formAction } from '../../lib/format.ts';
import { claimWhen, renewsIn, tickState } from '../../lib/ticks.ts';
import { addressed, signInPath, socialPath, socialPathOf } from '../../server/paths.ts';

export const prerender = false;

const handle = Astro.params.handle ?? '';
const { member, socialProfiles, socialClaims, socialFloor, socialProblems, socialCasebook, socialShelf } = Astro.locals;
const profile = await socialProfiles.profile(handle);
const followed = Astro.getActionResult(actions.follow) ?? Astro.getActionResult(actions.unfollow);
const vouched = Astro.getActionResult(actions.vouch);
const reported = Astro.getActionResult(actions.report);
const useful = Astro.getActionResult(actions.markUseful) ?? Astro.getActionResult(actions.unmarkUseful);
const saved = Astro.getActionResult(actions.saveItem) ?? Astro.getActionResult(actions.unsaveItem);
const shelved = Astro.getActionResult(actions.addShelfItem);
const unshelved = Astro.getActionResult(actions.removeShelfItem);
const to = (path: string) => socialPath(Astro.url, path);
if (profile && (shelved?.data || unshelved?.data)) return Astro.redirect(`${to(`/@${profile.handle}`)}?done=${shelved?.data ? 'shelved' : 'unshelved'}#shelf`);

if (profile && profile.handle !== handle) return Astro.redirect(to(`/@${profile.handle}`));
if (!profile) Astro.response.status = 404;

const own = member !== null && profile?.memberId === member.id;
const now = new Date();
const following = member && profile && !own ? await socialProfiles.isFollowing(member.id, profile.memberId) : false;
const counts = profile ? await socialProfiles.followCounts(profile.memberId) : null;
const ledger = profile ? await socialClaims.ledger(profile.memberId, member?.id ?? null) : { claims: [], accounts: [] };
const posts = profile ? await socialFloor.recentPosts(member?.id ?? null, profile.memberId) : [];
const record = profile ? await socialProblems.record(profile.memberId) : null;
const share = (n: number) => (record?.rated ? (n / record.rated) * 100 : 0);
const heat = profile ? await socialCasebook.heatmap(profile.memberId) : null;
const roles = profile ? await socialCasebook.roles(profile.memberId) : [];
const shelf = profile ? await socialShelf.shelf(profile.memberId, member?.id ?? null) : [];
const savedItems = own && member ? await socialShelf.saved(member.id) : [];
const checklist = own && member ? await socialProfiles.checklist(member.id) : null;
const steps = checklist
  ? [
      { label: 'Get ticked', done: checklist.ticked, href: to('/verify') },
      { label: 'Write a headline', done: checklist.headline, href: to('/edit') },
      { label: 'Log a casebook entry', done: checklist.casebook, href: to('/casebook/new') },
      { label: 'Answer a problem', done: checklist.answered, href: to('/problems') },
      { label: 'Copy your badge for your bio', done: checklist.badge, href: to('/badge') },
    ]
  : [];
const stepsDone = steps.filter((step) => step.done).length;
/* Halftone by count: one entry is the lightest dot, eight or more is solid. */
const level = (n: number) => (n === 0 ? 0 : n <= 1 ? 1 : n <= 3 ? 2 : n <= 5 ? 3 : n <= 7 ? 4 : 5);
const cell = (industry: string, service: string) => heat?.cells.find((c) => c.industry === industry && c.service === service) ?? { entries: 0, cosigned: 0 };
const latestYear = now.getFullYear() + 1;
const firstYear = roles.length ? Math.min(...roles.map((r) => r.from)) : latestYear;
const span = Math.max(1, latestYear - firstYear);
const saveFocus = saved?.data ? `save-${saved.data.item}` : null;
const shelfPosted = shelved?.error ? await postedFields(Astro.request) : () => '';
const shelfErrors = shelved?.error && isInputError(shelved.error) ? shelved.error.fields : {};
const done = Astro.url.searchParams.get('done');

const usefulFocus = useful?.data ? `useful-${useful.data.target}-${useful.data.id}` : null;
/* Only members with the seal vouch, and never for themselves. Others see the count. */
const canVouch = !own && (Astro.locals.profile?.sealed ?? false);
const sources = [...new Set<TickSource>([...(ledger.accounts.length ? ['account' as const] : []), ...ledger.claims.map((c) => c.source)])];
const action = (which: { toString(): string }) => formAction(addressed(Astro.url), which);
const followError = followed?.error?.message ?? null;
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
---

<Social title={profile ? `${profile.name} (@${profile.handle})` : 'Not found'} description={profile?.headline || undefined} section="list">
  {
    profile && counts ? (
      <div class="page profile">
        <div>
          <section class="hero card" aria-labelledby="name">
            <div class="cover" />
            <div class="inner">
              <Avatar name={profile.name} track={profile.track} sealed={profile.sealed} size="lg" />
              <h1 class="display" id="name">
                {profile.name}
                {profile.sealed && (
                  <svg class="seal" role="img" aria-label="Ticked">
                    <use href="#seal" />
                  </svg>
                )}
              </h1>
              <span class="handle">@{profile.handle}</span>
              {profile.headline ? <p class="headline">{profile.headline}</p> : own && <p class="headline small">Add a headline. One line on what you post about.</p>}
              <div class="traits">
                <Flair track={profile.track} />
                {profile.sector && <span class="tag">{profile.sector}</span>}
                {profile.jurisdictions.map((j) => <span class="jur">{j}</span>)}
                {profile.city && <span class="tag">{profile.city}</span>}
                {profile.topics.map((t) => <span class="tag">{t}</span>)}
              </div>
              <p class="counts">
                <span><b>{plural(counts.followers, 'follower', 'followers')}</b></span>
                <span>Following <b>{counts.following}</b></span>
              </p>
              <div class="actions">
                {own ? (
                  <>
                    <a class="btn sm" href={to('/edit')}>
                      <svg aria-hidden="true"><use href="#i-edit" /></svg>
                      Edit profile
                    </a>
                    {profile.sealed && <a class="btn sm ghost" href={to('/badge')}>Get your badge</a>}
                    <a class="btn sm ghost" href={to('/casebook/new')}>
                      <svg aria-hidden="true"><use href="#i-plus" /></svg>
                      Add to casebook
                    </a>
                  </>
                ) : member ? (
                  <form method="POST" action={action(following ? actions.unfollow : actions.follow)}>
                    <input type="hidden" name="handle" value={profile.handle} />
                    <button class:list={['btn sm', { ghost: following }]} type="submit">
                      {following ? (
                        <>
                          Following<span class="sr-only">. Select to unfollow.</span>
                        </>
                      ) : (
                        'Follow'
                      )}
                    </button>
                  </form>
                ) : (
                  <a class="btn sm" href={signInPath(Astro.url, socialPathOf(Astro.url))}>Sign in to follow</a>
                )}
                {member && !own && <ReportDialog target="profile" handle={profile.handle} about={`@${profile.handle}`} class="btn sm ghost" />}
              </div>
              {followError && <p class="error" role="alert">{followError}</p>}
              {reported?.error && <p class="error" role="alert">{reported.error.message}</p>}
              {reported?.data && <p class="note" role="status">Report sent. A person on the team reads every one.</p>}
              {followed?.data && <p class="sr-only" role="status">{followed.data.following ? `Following ${profile.name}.` : 'Unfollowed.'}</p>}
            </div>
          </section>

          <section class="section card" aria-labelledby="claims-title">
            <header>
              <h2 class="head" id="claims-title">Ticked claims</h2>
              <span class="small"><a href={to('/ticks')}>What a tick means</a></span>
            </header>
            {vouched?.error && <p class="error" role="alert">{vouched.error.message}</p>}
            {vouched?.data && <p class="sr-only" role="status">{vouched.data.ticked ? 'Vouched. That was the third: it is ticked.' : 'Vouched.'}</p>}
            <div class="claims-wrap">
              {ledger.claims.length + ledger.accounts.length === 0 ? (
                <div class="empty">
                  <p>No claims yet.</p>
                  {own && <a class="btn sm" href={to('/verify')}>Get ticked</a>}
                </div>
              ) : (
                <>
                  <table class="claims">
                    <caption class="sr-only">Claims about {profile.name}, and how each was checked</caption>
                    <tbody>
                      {ledger.accounts.map((a) => (
                        <tr data-state="ticked">
                          <td><Tick source="account" state="ticked" /></td>
                          <td class="what">{a.platform} · @{a.handle}</td>
                          <td class="src">{TICK_SOURCES.account.name}</td>
                          <td class="when">Proven</td>
                        </tr>
                      ))}
                      {ledger.claims.map((c) => {
                        const due = renewsIn(c, now);
                        const vouchable = canVouch && c.kind === 'experience' && !c.vouchedByViewer;
                        return (
                          <tr data-state={c.review.state}>
                            <td><Tick source={c.source} state={tickState(c)} vouches={c.vouches} /></td>
                            <td class="what">{c.label}</td>
                            <td class="src">
                              {TICK_SOURCES[c.source].name}
                              {c.kind === 'experience' && c.vouches > 0 && ` · ${c.vouches}`}
                            </td>
                            <td class="when">
                              {c.kind === 'experience' && c.review.state === 'ticked' ? `Vouched by ${c.vouches}` : claimWhen(c)}
                              {due !== null && (
                                <>
                                  <br />
                                  <span class="due-chip">Renews in {due} {due === 1 ? 'day' : 'days'}</span>
                                </>
                              )}
                              {vouchable && (
                                <form method="POST" action={action(actions.vouch)}>
                                  <input type="hidden" name="claim" value={c.id} />
                                  <button class="btn sm ghost" type="submit">
                                    Vouch<span class="sr-only"> for {c.label}</span>
                                  </button>
                                </form>
                              )}
                              {canVouch && c.kind === 'experience' && c.vouchedByViewer && (
                                <>
                                  <br />
                                  You vouched
                                </>
                              )}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                  <div class="claims-foot">
                    {sources.map((source) => (
                      <span>
                        <Tick source={source} state={source === 'self' ? 'self' : 'ticked'} />
                        {TICK_SOURCES[source].name}
                      </span>
                    ))}
                  </div>
                </>
              )}
            </div>
            {own && <p class="small">Self-declared claims are ticked once {VOUCHES_TO_TICK} members with the seal vouch for them. <a href={to('/verify')}>Add or renew claims</a>.</p>}
          </section>

          <section class="section card" id="casebook" aria-labelledby="casebook-title">
            <header>
              <h2 class="head" id="casebook-title">Casebook</h2>
              <span class="small">Bands and years only. No client names.</span>
            </header>
            {heat && heat.entries > 0 ? (
              <div class="heat-wrap">
                <div class="heat" role="table" aria-label="Engagements by industry and type of work">
                  <div class="hr" role="row">
                    <span role="columnheader"><span class="sr-only">Industry</span></span>
                    {SERVICES.map((service) => <span class="ch" role="columnheader">{service}</span>)}
                  </div>
                  {heat.industries.map((industry) => (
                    <div class="hr" role="row">
                      <span class="rh" role="rowheader">{industry}</span>
                      {SERVICES.map((service) => {
                        const c = cell(industry, service);
                        return (
                          <span class={`cell ht-${level(c.entries)}`} role="cell" tabindex={c.entries ? 0 : undefined} aria-label={`${industry}, ${service}: ${plural(c.entries, 'engagement', 'engagements')}, ${c.cosigned} co-signed`}>
                            {c.cosigned > 0 && <span class="cs" aria-hidden="true"><svg><use href="#tk" /></svg></span>}
                            {c.entries > 0 && <span class="tip" aria-hidden="true">{plural(c.entries, 'engagement', 'engagements')} · {c.cosigned} co-signed</span>}
                          </span>
                        );
                      })}
                    </div>
                  ))}
                </div>
                <div class="heat-legend" aria-hidden="true">
                  <span class="scale">Fewer {[1, 2, 3, 4, 5].map((l) => <i class={`ht-${l}`} />)} More</span>
                  <span class="scale"><span class="cs-key"><svg><use href="#tk" /></svg></span> Co-signed by a colleague with the seal</span>
                </div>
                <div class="heat-stats">
                  <div><b>{heat.entries}</b><small>{heat.entries === 1 ? 'engagement' : 'engagements'}</small></div>
                  <div><b>{heat.cosigned}</b><small>co-signed</small></div>
                  <div><b>{heat.industries.length}</b><small>{heat.industries.length === 1 ? 'industry' : 'industries'}</small></div>
                </div>
              </div>
            ) : (
              <div class="empty">
                <p class="head">No entries yet.</p>
                <p>Log work by type, industry and size band. No client names.</p>
                {own && <a class="btn sm" href={to('/casebook/new')}><svg aria-hidden="true"><use href="#i-plus" /></svg> Add an entry</a>}
              </div>
            )}
            {roles.length > 0 && (
              <div class="timeline">
                <div class="axis" aria-hidden="true">
                  <span>{firstYear}</span>
                  <span>{Math.round(firstYear + span / 2)}</span>
                  <span>Now</span>
                </div>
                <ol class="tl-list" aria-label="Roles">
                  {roles.map((role) => (
                    <li class="tl-row">
                      <div class="bar" aria-hidden="true">
                        <div class:list={[{ now: role.to === null }]} style={`--x: ${((role.from - firstYear) / span) * 100}%; --w: ${(((role.to ?? latestYear) - role.from) / span) * 100}%`} />
                      </div>
                      <p class="tl-label">
                        <b>{role.title}</b> · {role.employer} <span class="pixel">{role.from}–{role.to ?? 'now'}</span>
                      </p>
                    </li>
                  ))}
                </ol>
              </div>
            )}
            {own && heat && heat.entries > 0 && <a class="small" href={to('/casebook/new')}>Add an entry or a role</a>}
          </section>

          {own && (
            <section class="section card" id="saved" aria-labelledby="saved-title">
              <header>
                <h2 class="head" id="saved-title">Saved</h2>
                <span class="small">Only you see this.</span>
              </header>
              {savedItems.length ? (
                <ul class="saved-list">
                  {savedItems.map((item) => (
                    <li>
                      <svg class="ic" aria-hidden="true"><use href="#i-file" /></svg>
                      <span>
                        <a href={item.url} rel="noopener noreferrer nofollow ugc"><b>{item.title}</b></a>
                        <br />
                        <a href={to(`/@${item.owner.handle}`)}>{item.owner.name}</a> · {item.kind}
                      </span>
                      <form method="POST" action={action(actions.unsaveItem)}>
                        <input type="hidden" name="item" value={item.id} />
                        <button class="btn sm ghost" type="submit">Remove<span class="sr-only"> {item.title} from Saved</span></button>
                      </form>
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="empty">
                  <p>Nothing saved yet. Save templates and explainers from anyone’s shelf.</p>
                  <a class="btn sm ghost" href={to('/list')}>Browse The List</a>
                </div>
              )}
            </section>
          )}

          <section class="section card" id="shelf" aria-labelledby="shelf-title">
            <header>
              <h2 class="head" id="shelf-title">Shelf</h2>
              <span class="small">{own ? 'Work you share in public. Link to it; we never host the file.' : 'Work they share in public.'}</span>
            </header>
            {done === 'shelved' && <p class="note" role="status">Added to your shelf.</p>}
            {done === 'unshelved' && <p class="note" role="status">Taken off your shelf.</p>}
            {saved?.error && <p class="error" role="alert">{saved.error.message}</p>}
            {saved?.data && <p class="sr-only" role="status">{saved.data.saved ? 'Saved to your profile.' : 'Removed from Saved.'}</p>}
            {shelf.length ? (
              <div class="shelf">
                {shelf.map((item) => (
                  <article class="item" aria-labelledby={`item-${item.id}`}>
                    <span class="ic" aria-hidden="true"><svg><use href="#i-file" /></svg></span>
                    <p class="kicker">{item.kind}</p>
                    <h3 id={`item-${item.id}`}><a href={item.url} rel="noopener noreferrer nofollow ugc">{item.title}</a></h3>
                    <div class="nums">
                      <span><svg aria-hidden="true"><use href="#i-down" /></svg> {plural(item.saves, 'save', 'saves')}</span>
                    </div>
                    {item.mine ? (
                      <details class="remove">
                        <summary class="act">Take down<span class="sr-only"> {item.title}</span></summary>
                        <form method="POST" action={action(actions.removeShelfItem)}>
                          <input type="hidden" name="item" value={item.id} />
                          <p class="small">It leaves everyone’s Saved list too.</p>
                          <button class="btn sm danger" type="submit">Take it down</button>
                        </form>
                      </details>
                    ) : member ? (
                      <form method="POST" action={action(item.savedByViewer ? actions.unsaveItem : actions.saveItem)}>
                        <input type="hidden" name="item" value={item.id} />
                        <button class="btn sm ghost" type="submit" id={`save-${item.id}`} aria-pressed={item.savedByViewer ? 'true' : 'false'} autofocus={saveFocus === `save-${item.id}` ? true : undefined}>
                          {item.savedByViewer ? <><svg aria-hidden="true"><use href="#tk" /></svg> Saved</> : 'Save'}
                          <span class="sr-only"> {item.title}</span>
                        </button>
                      </form>
                    ) : null}
                  </article>
                ))}
              </div>
            ) : (
              <div class="empty"><p>{own ? 'Nothing on your shelf yet.' : 'Nothing shared yet.'}</p></div>
            )}
            {own && (
              <details class="add-shelf" open={shelved?.error ? true : undefined}>
                <summary class="btn sm ghost"><svg aria-hidden="true"><use href="#i-plus" /></svg> Add to your shelf</summary>
                <form method="POST" action={action(actions.addShelfItem)} novalidate>
                  {shelved?.error && !isInputError(shelved.error) && <p class="error" role="alert">{shelved.error.message}</p>}
                  <div class="row2">
                    <div class="field">
                      <label for="s-title">Title</label>
                      <input class="input" id="s-title" name="title" maxlength={SHELF_LIMITS.title} value={shelfPosted('title')} aria-invalid={shelfErrors.title ? 'true' : undefined} aria-describedby={shelfErrors.title ? 's-title-error' : undefined} />
                      {shelfErrors.title && <span class="error" id="s-title-error">{shelfErrors.title[0]}</span>}
                    </div>
                    <div class="field">
                      <label for="s-kind">What it is</label>
                      <select class="input" id="s-kind" name="kind">
                        {SHELF_KINDS.map((kind) => <option selected={shelfPosted('kind') === kind ? true : undefined}>{kind}</option>)}
                      </select>
                    </div>
                  </div>
                  <div class="field">
                    <label for="s-url">Link</label>
                    <input class="input" id="s-url" name="url" type="url" inputmode="url" maxlength={SHELF_LIMITS.url} placeholder="https://" value={shelfPosted('url')} aria-invalid={shelfErrors.url ? 'true' : undefined} aria-describedby={shelfErrors.url ? 's-url-error' : 's-url-hint'} />
                    {shelfErrors.url ? <span class="error" id="s-url-error">{shelfErrors.url[0]}</span> : <span class="hint" id="s-url-hint">An https link to where it is public: a drive folder, a post, a video.</span>}
                  </div>
                  <button class="btn sm" type="submit">Add to shelf</button>
                </form>
              </details>
            )}
          </section>

          <section class="section card" aria-labelledby="posts-title">
            <header>
              <h2 class="head" id="posts-title">Recent posts</h2>
            </header>
            {useful?.error && <p class="error" role="alert">{useful.error.message}</p>}
            {posts.length ? (
              <div class="recent">
                {posts.map((post) => <PostCard post={post} signedIn={member !== null} focus={usefulFocus} />)}
              </div>
            ) : (
              <div class="empty">
                <p>{own ? 'You have not posted yet.' : 'No posts yet.'}</p>
                {own && <a class="btn sm" href={to('/')}>Ask the Floor</a>}
              </div>
            )}
          </section>
        </div>

        <aside class="side" aria-label="About ticks">
          {checklist && stepsDone < steps.length && (
            <div class="card checklist">
              <p class="kicker">Set up your profile</p>
              <p class="small"><b>{stepsDone} of {steps.length}</b> done.</p>
              <div class="meter" role="img" aria-label={`${stepsDone} of ${steps.length} done`}>
                <i class="ht-5" style={`width: ${(stepsDone / steps.length) * 100}%`} />
              </div>
              <ul class="check-list">
                {steps.map((step) => (
                  <li class:list={[{ done: step.done }]}>
                    {step.done ? (
                      <>
                        <span class="ck" aria-hidden="true"><svg><use href="#tk" /></svg></span>
                        <span><span class="sr-only">Done: </span>{step.label}</span>
                      </>
                    ) : (
                      <>
                        <span class="ck" aria-hidden="true" />
                        <a href={step.href}>{step.label}</a>
                      </>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {record && (
            <div class="card record">
              <p class="kicker">Judgment record</p>
              {record.rated ? (
                <>
                  <div class="big">
                    <b>{Math.round(share(record.sound))}%</b>
                    <span class="small">
                      of {plural(record.rated, 'rated answer', 'rated answers')} judged sound by members with the seal
                      {record.answers > record.rated && `, out of ${plural(record.answers, 'answer', 'answers')}`}
                    </span>
                  </div>
                  <div class="meter" role="img" aria-label={`${record.sound} sound, ${record.partly} partly sound, ${record.unsound} unsound`}>
                    <i class="ht-5" style={`width: ${share(record.sound)}%`} />
                    <i class="hatch" style={`width: ${share(record.partly)}%`} />
                    <i style="flex: 1" />
                  </div>
                  <div class="heat-legend" aria-hidden="true">
                    <span class="scale"><i class="ht-5" /> Sound</span>
                    <span class="scale"><i class="hatch" /> Partly</span>
                    <span class="scale"><i class="empty-box" /> Unsound</span>
                  </div>
                </>
              ) : (
                <p class="small">
                  {record.answers
                    ? `${plural(record.answers, 'answer', 'answers')}. None rated yet.`
                    : own
                      ? 'No answers yet. Answer a problem and members with the seal rate your reasoning.'
                      : 'No answers yet.'}
                </p>
              )}
              <a class="small" href={to('/problems')}>{own && !record.answers ? 'Answer this week’s problem' : 'Open problems'}</a>
            </div>
          )}
          <div class="card">
            <p class="kicker">Find them on</p>
            <ul class="links">
              {ledger.accounts.length === 0 && <li>No accounts proven yet.</li>}
              {ledger.accounts.map((a) => (
                <li>
                  <Tick source="account" state="ticked" />
                  <a href={a.url} rel="noopener noreferrer me">{a.platform} · @{a.handle}</a>
                  <span class="pixel">proven</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="card disclaim">
            <p class="kicker">Read this</p>
            <p>Ticks confirm credentials. They never vouch for advice.</p>
            <p>Every tick is re-checked each year. A lapsed one is struck in red.</p>
          </div>
        </aside>
      </div>
    ) : (
      <div class="page">
        <div class="card empty">
          <h1 class="head">Not on the List.</h1>
