---
import { actions } from 'astro:actions';
import Social from '../../../layouts/Social.astro';
import { formAction, listOf } from '../../../lib/format.ts';
import { addressed, socialPath, socialPathOf } from '../../../server/paths.ts';

export const prerender = false;

const to = (path: string) => socialPath(Astro.url, path);
const token = Astro.params.token ?? '';
const { member, profile, socialNominations } = Astro.locals;
const here = socialPathOf(Astro.url);

const claimed = Astro.getActionResult(actions.claimNomination);
if (claimed?.data) return Astro.redirect(to('/verify?step=account&done=addAccount'));
const declined = Astro.getActionResult(actions.declineNomination);
if (declined?.data) return Astro.redirect(to(`${here}?done=declined`));

const invitation = await socialNominations.invitation(token);
const done = Astro.url.searchParams.get('done') === 'declined' && !invitation;
if (!invitation && !done) Astro.response.status = 404;
const confirming = Astro.url.searchParams.get('confirm') === 'decline' || Boolean(declined?.error);
const failure = claimed?.error?.message ?? declined?.error?.message ?? null;
const action = (which: { toString(): string }) => {
  const url = new URL(addressed(Astro.url));
  url.search = '';
  return formAction(url, which);
};
const topics = invitation?.topics.length ? listOf(invitation.topics) : 'accountancy';
const people = (n: number) => `${n} ${n === 1 ? 'person' : 'people'}`;
const signUp = `/sign-up?invite=${encodeURIComponent(token)}`;
---

<Social title="Your invite" description="People in accountancy want to follow you on The Rest Is Accountancy Social." noindex>
  <div class="page narrow">
    {
      done ? (
        <section class="claim card" aria-labelledby="claim-title">
          <p class="kicker">Invite</p>
          <h1 class="title" id="claim-title">Deleted.</h1>
          <p class="lead">We removed the nomination and won’t invite you again.</p>
          <a class="btn" href={to('/')}>Go to the Floor</a>
        </section>
      ) : invitation ? (
        <section class="claim card" aria-labelledby="claim-title">
          <span class="tape slap" aria-hidden="true">you’re on the list</span>
          <p class="kicker">Invite · {invitation.platform}</p>
          <h1 class="title" id="claim-title">@{invitation.handle}, people want to follow you here.</h1>
          <p class="lead">
            {people(invitation.nominators)} nominated you for your posts on {topics}.
          </p>
          <div class="claim-grid">
            <div>
              <p class="kicker">Public right now</p>
              <p><b>Nothing.</b> Your listing stays private until you claim it.</p>
            </div>
            <div>
              <p class="kicker">If you claim it</p>
              <ul class="plain-list">
                <li>Your handle shows on The List.</li>
                <li>You add ticks for your credentials.</li>
                <li>You can leave any time.</li>
              </ul>
            </div>
          </div>
          {failure && <p class="error" role="alert">{failure}</p>}
          {confirming ? (
            <div class="confirm" role="group" aria-labelledby="decline-title">
              <p id="decline-title"><b>Delete this nomination?</b> We won’t invite you again.</p>
              <div class="confirm-actions">
                <form method="POST" action={action(actions.declineNomination)}>
                  <input type="hidden" name="token" value={token} />
                  <button class="btn sm danger" type="submit" autofocus>Delete nomination</button>
                </form>
                <a class="btn sm ghost" href={to(here)}>Keep it</a>
              </div>
            </div>
          ) : (
            <div class="actions">
              {!member ? (
                <a class="btn" href={to(signUp)}>Claim and get ticked</a>
              ) : profile ? (
                <form method="POST" action={action(actions.claimNomination)}>
                  <input type="hidden" name="token" value={token} />
                  <button class="btn" type="submit">Claim and get ticked</button>
                </form>
              ) : (
                <a class="btn" href={to('/edit')}>Claim your handle first</a>
              )}
              <a class="btn ghost" href={to(`${here}?confirm=decline`)}>Not for me</a>
            </div>
          )}
          {member && !profile && <p class="small">Pick your handle, then open this link again to claim the invite.</p>}
          {!member && <p class="small">You sign up with your name and email. We never see your {invitation.platform} password.</p>}
        </section>
      ) : (
        <div class="card empty">
          <h1 class="head">This invite has been used or withdrawn.</h1>
          <p>If you were sent it and it never worked, write to the team.</p>
          <a class="btn sm" href={to('/')}>Go to the Floor</a>
        </div>
      )
    }
  </div>
</Social>
