---
import { TICK_SOURCES, TRACKS, trackNames } from '../../data/social.ts';
import Social from '../../layouts/Social.astro';

export const prerender = false;

const rules = [
  ['Credentials, not advice.', 'A tick says the claim is true. It says nothing about whether a post is right.'],
  ['Checked every year.', 'Memberships and licences lapse. We re-check before each one expires.'],
  ['Lapsed shows in red.', 'A lapsed tick is struck through, not hidden. People can still post.'],
  ['Exact status.', 'Student, Affiliate, Member, Fellow. We never round up.'],
  ['Our marks only.', 'Bodies own their logos. We write the name and draw our own tick.'],
  ['Nominated is not public.', 'A nomination stays private until the person claims it. They can remove it.'],
  ['We keep less.', 'We store the result, not your documents. We never ask for an IC number.'],
  ['Report anything.', 'Wrong claim, fake account, or you want off the List. One button on every profile.'],
] as const;
---

<Social title="What a tick means" description="One seal, many ticks. Every mark says how we know a claim is true." section="verify">
  <div class="page">
    <div class="page-head">
      <div>
        <p class="kicker">What a tick means</p>
        <h1 class="title">One seal. Many ticks.</h1>
        <p class="lead">Like a tickmark legend on a working paper. Every mark says how we know.</p>
      </div>
    </div>
    <section class="big-seal card" aria-labelledby="seal-title">
      <svg class="seal" aria-hidden="true"><use href="#seal" /></svg>
      <div>
        <h2 class="head" id="seal-title">The seal sits next to a name.</h2>
        <p>It appears once an account is proven and one more claim is ticked. The flair says where they are in the profession.</p>
        <div class="chips">{TRACKS.map((track) => <span class="flair" data-track={track}>{trackNames[track]}</span>)}</div>
      </div>
    </section>
    <section class="section" aria-labelledby="legend-title">
      <header><h2 class="head" id="legend-title">The tickmark legend</h2></header>
      <div class="legend">
        {
          Object.values(TICK_SOURCES).map((source) => (
            <div class="card">
              <span class="tick" data-state={source.glyph === 't-self' ? 'self' : 'ticked'}>
                <svg aria-hidden="true"><use href={`#${source.glyph}`} /></svg>
              </span>
              <h3>{source.name}</h3>
              <p class="small">{source.means}</p>
            </div>
          ))
        }
        <div class="card">
          <span class="tick" data-state="lapsed"><svg aria-hidden="true"><use href="#t-register" /></svg></span>
          <h3>Lapsed</h3>
          <p class="small">Was ticked. Not renewed. Struck in red until it is.</p>
        </div>
      </div>
    </section>
    <section class="section" aria-labelledby="rules-title">
      <header><h2 class="head" id="rules-title">The rules</h2></header>
      <div class="rules">
        {
          rules.map(([rule, detail]) => (
            <div>
              <h3>{rule}</h3>
              <p>{detail}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Social>
