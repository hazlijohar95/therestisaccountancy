---
import { actions, isInputError } from 'astro:actions';
import PostText from '../../../components/PostText.astro';
import Avatar from '../../../components/social/Avatar.astro';
import Flair from '../../../components/social/Flair.astro';
import Tick from '../../../components/social/Tick.astro';
import { PROBLEM_LIMITS, RATINGS } from '../../../data/social.ts';
import Social from '../../../layouts/Social.astro';
import { postedFields } from '../../../lib/form.ts';
import { formAction, formatMoment, tally } from '../../../lib/format.ts';
import { addressed, signInPath, socialPath, socialPathOf } from '../../../server/paths.ts';
import type { RatingCounts } from '../../../server/social-problems.ts';

export const prerender = false;

/* /problems is the open problem; /problems/12 is number 12, open or in the archive. */
const to = (path: string) => socialPath(Astro.url, path);
const { member, socialProblems } = Astro.locals;
const raw = Astro.params.number;
const number = raw === undefined ? null : /^[1-9]\d{0,8}$/.test(raw) ? Number(raw) : Number.NaN;
const here = to(number === null ? '/problems' : `/problems/${number}`);

const answered = Astro.getActionResult(actions.answerProblem);
const rated = Astro.getActionResult(actions.rateAnswer);
/* An answer lands on a fresh page, so a refresh never sends it twice. A rating renders in place and keeps focus. */
if (answered?.data) return Astro.redirect(`${here}?answered=1#answers`);

const view = Number.isNaN(number) ? null : await socialProblems.view(member?.id ?? null, number);
const past = await socialProblems.archive();
const next = view ? null : await socialProblems.nextOpens();
const streak = member ? await socialProblems.streak(member.id) : null;
if (number !== null && !view) Astro.response.status = 404;

const team = member?.role === 'admin';
const posted = answered?.error ? await postedFields(Astro.request) : () => '';
const fields = answered?.error && isInputError(answered.error) ? answered.error.fields : {};
const failure = [answered, rated].map((result) => (result?.error && !isInputError(result.error) ? result.error.message : null)).find(Boolean) ?? null;
const focus = rated?.data ? `rate-${rated.data.answer}-${rated.data.button}` : null;
const status = rated?.data ? (rated.data.rating ? `Rated ${rated.data.rating}.` : 'Rating taken back.') : null;
const action = (which: { toString(): string }) => formAction(addressed(Astro.url), which);
const params = Astro.url.searchParams;

const problem = view?.problem ?? null;
const open = problem?.state === 'open';
const closed = problem?.state === 'closed';
const optionText = (key: string) => problem?.options.find((option) => option.key === key)?.text ?? key;
const ratedLine = (ratings: RatingCounts) => {
  const total = ratings.sound + ratings.partly + ratings.unsound;
  return total ? `Rated by members with the seal: ${ratings.sound} sound, ${ratings.partly} partly, ${ratings.unsound} unsound.` : 'Not rated.';
};
const streakNote = streak
  ? open && !view?.mine
    ? 'Answer this week’s problem to keep it going.'
    : 'Answer the next problem to keep it going.'
  : open && !view?.mine
    ? 'Answer this week’s problem to start one.'
    : 'Answer the next problem to start one.';
---

<Social title={problem ? `#${problem.number} ${problem.title}` : 'Problems'} description={problem ? problem.ask : 'One problem a week. Answers stay hidden until you answer, and members with the seal rate the reasoning.'} section="problems">
  <div class="page problems">
    <div>
      {
        view && problem ? (
          <>
            {params.get('written') === '1' && team && (
              <p class="note" role="status">
                Saved. It opens {formatMoment(problem.opensAt)}, Malaysian time.
              </p>
            )}
            {status && (
              <p class="sr-only" role="status">
                {status}
              </p>
            )}
            {failure && (
              <p class="error" role="alert">
                {failure}
              </p>
            )}
            <article class="problem card" aria-labelledby="problem-title">
              {open && <span class="tape">problem of the week</span>}
              <p class="no">
                #{problem.number} · {problem.tag} · {problem.jurisdiction} ·{' '}
                {open ? (
                  <>
                    closes <time datetime={problem.closesAt}>{formatMoment(problem.closesAt)}</time>
                  </>
                ) : closed ? (
                  `closed · ${tally(problem.answers, 'answer')}`
                ) : (
                  <>
                    opens <time datetime={problem.opensAt}>{formatMoment(problem.opensAt)}</time>
                  </>
                )}
              </p>
              <h1 class="title" id="problem-title">
                {problem.title}
              </h1>
              <ol class="scenario">
                {problem.scenario.map((line) => (
                  <li>{line}</li>
                ))}
              </ol>
              <p class="ask">{problem.ask}</p>
              {view.revealed ? (
                <>
                  <ul class="options results" aria-label="How members answered">
                    {view.spread.map((s) => (
                      <li class:list={['opt', { mine: view.mine?.pick === s.key }]}>
                        <i class:list={['fill', s.key === view.most ? 'ht-5' : 'hatch']} style={`--w: ${s.percent}%`} aria-hidden="true" />
                        <span class="k">{s.key}</span>
                        <span>
                          {optionText(s.key)}
                          {view.mine?.pick === s.key && <span class="sr-only">. Your pick.</span>}
                        </span>
                        <b class="pct" data-to={s.percent} aria-hidden="true">
                          {s.percent}%
                        </b>
                        <span class="sr-only">{s.percent} percent</span>
                      </li>
                    ))}
                  </ul>
                  {view.mine ? (
                    <p class="note">
                      <Tick source="register" state="ticked" />
                      <span>
                        You picked {view.mine.pick}.{' '}
                        {view.most === view.mine.pick ? 'Most members picked it too.' : `Most members picked ${view.most}. Read why below.`}
                      </span>
                    </p>
                  ) : (
                    view.most && (
                      <p class="note plain">
                        <Tick source="self" state="self" />
                        <span>Closed. The answers are open to read. {view.most} was the most common pick.</span>
                      </p>
                    )
                  )}
                </>
              ) : open && view.viewer.hasHandle ? (
                <form method="POST" action={action(actions.answerProblem)} novalidate>
                  <input type="hidden" name="number" value={problem.number} />
                  <fieldset class="options" aria-describedby={fields.pick ? 'pick-error' : undefined}>
                    <legend class="sr-only">Your answer</legend>
                    {problem.options.map((option) => (
                      <label class="opt">
                        <input class="sr-only" type="radio" name="pick" value={option.key} required checked={posted('pick') === option.key ? true : undefined} />
                        <span class="k">{option.key}</span>
                        <span>{option.text}</span>
                      </label>
                    ))}
                  </fieldset>
                  {fields.pick && (
                    <span class="error" id="pick-error">
                      {fields.pick[0]}
                    </span>
                  )}
                  <div class="reason field">
                    <label for="why">Your reasoning · optional</label>
                    <textarea class="input" id="why" name="reasoning" rows="4" maxlength={PROBLEM_LIMITS.reasoning} placeholder="Two or three sentences. Your peers rate the reasoning, not the letter." aria-invalid={fields.reasoning ? 'true' : undefined} aria-describedby={fields.reasoning ? 'why-error' : undefined}>{posted('reasoning')}</textarea>
                    {fields.reasoning && (
                      <span class="error" id="why-error">
                        {fields.reasoning[0]}
                      </span>
                    )}
                  </div>
                  <div class="lockline">
                    <svg aria-hidden="true">
                      <use href="#i-lock" />
                    </svg>
                    <span>Everyone’s answers stay hidden until you answer. You answer once.</span>
                    <button class="btn" type="submit">
                      Lock in my answer
                    </button>
                  </div>
                </form>
              ) : (
                <>
                  <ol class="options static">
                    {problem.options.map((option) => (
                      <li class="opt">
                        <span class="k">{option.key}</span>
                        <span>{option.text}</span>
                      </li>
                    ))}
                  </ol>
                  {open && (
                    <p class="lockline">
                      <svg aria-hidden="true">
                        <use href="#i-lock" />
                      </svg>
                      {member ? (
                        <span>
                          <a href={to('/edit')}>Claim your handle</a> to answer. Answers stay hidden until you do.
                        </span>
                      ) : (
                        <span>
                          <a href={signInPath(Astro.url, socialPathOf(Astro.url))}>Sign in</a> or <a href={to('/sign-up')}>sign up free</a> to answer. Answers stay hidden until you do.
                        </span>
                      )}
                    </p>
                  )}
                </>
              )}
            </article>

            {view.revealed && (
              <section class="section" id="answers" aria-labelledby="answers-title">
                <header>
                  <h2 class="head" id="answers-title">
                    {closed ? 'Answers' : 'Answers so far'}
                  </h2>
                  <span class="small">{tally(view.answers.length, 'answer')}</span>
                </header>
                {params.get('answered') === '1' && (
                  <p class="note" role="status">
                    Locked in. Here is how everyone answered.
                  </p>
                )}
                {open && !view.viewer.sealed && (
                  <p class="note plain">
                    <Tick source="self" state="self" />
                    <span>
                      Members with the seal rate answers. <a href={to('/verify')}>Get ticked</a> to rate.
                    </span>
                  </p>
                )}
                <div class="answers">
                  {view.answers.map((answer) => (
                    <article class="answer" id={`answer-${answer.id}`} data-mine={answer.mine ? '' : undefined} aria-label={answer.mine ? 'Your answer' : `Answer from ${answer.author.name}`}>
                      <div class="by">
                        <a class="author" href={to(`/@${answer.author.handle}`)}>
                          <Avatar name={answer.author.name} track={answer.author.track} sealed={answer.author.sealed} size="sm" />
                          <span class="name-line">
                            {answer.author.name}
                            {answer.author.sealed && (
                              <svg class="seal" role="img" aria-label="Ticked">
                                <use href="#seal" />
                              </svg>
                            )}
                          </span>
                        </a>
                        <Flair track={answer.author.track} />
                        <span class="pick">
                          <span class="sr-only">Picked </span>
                          {answer.pick}
                        </span>
                      </div>
                      {answer.reasoning ? <PostText text={answer.reasoning} /> : <p class="small">No reasoning given.</p>}
                      {view.canRate && !answer.mine ? (
                        <div class="rate" role="group" aria-label={`Rate the answer from ${answer.author.name}`}>
                          <span class="kicker label" aria-hidden="true">
                            Rate
                          </span>
                          {RATINGS.map((rating) => {
                            const pressed = answer.viewerRating === rating.id;
                            const chip = `rate-${answer.id}-${rating.id}`;
                            return (
                              <form method="POST" action={action(actions.rateAnswer)}>
                                <input type="hidden" name="answer" value={answer.id} />
                                <input type="hidden" name="button" value={rating.id} />
                                <button class="chip" type="submit" name="rating" value={pressed ? 'none' : rating.id} id={chip} data-k={rating.id} aria-pressed={pressed ? 'true' : 'false'} autofocus={focus === chip ? true : undefined}>
                                  {rating.label} · {answer.ratings[rating.id]}
                                </button>
                              </form>
                            );
                          })}
                        </div>
                      ) : (
                        <p class="small rated-line">
                          <Tick source="vouch" state="ticked" />
                          <span>{answer.mine && open ? `${ratedLine(answer.ratings)} Ratings close with the problem.` : ratedLine(answer.ratings)}</span>
                        </p>
                      )}
                    </article>
                  ))}
                </div>
              </section>
            )}
          </>
        ) : number !== null ? (
          <div class="card empty">
            <h1 class="head">No problem with that number.</h1>
            <a class="btn sm" href={to('/problems')}>
              This week’s problem
            </a>
          </div>
        ) : (
          <>
            <div class="page-head">
              <div>
                <p class="kicker">Problems</p>
                <h1 class="title">One problem a week.</h1>
                <p class="lead">A short case with a judgment call. Answers stay hidden until you answer, and members with the seal rate the reasoning.</p>
              </div>
            </div>
            <div class="card empty">
              {next ? (
                <p class="head">
                  The next problem opens <time datetime={next}>{formatMoment(next)}</time>.
                </p>
              ) : past.length ? (
                <p class="head">No problem is open this week.</p>
              ) : (
                <p class="head">The first problem opens soon.</p>
              )}
              {team ? (
                <a class="btn sm" href={to('/problems/new')}>
                  {past.length || next ? 'Write a problem' : 'Write the first problem'}
                </a>
              ) : past.length ? (
                <p>Read how members answered the last ones.</p>
              ) : member ? (
                <>
                  <p>Claim your handle now and you can answer it the week it opens.</p>
                  <a class="btn sm" href={to('/me')}>
                    Go to your profile
                  </a>
                </>
              ) : (
                <>
                  <p>Sign up free and you can answer it the week it opens.</p>
                  <a class="btn sm" href={to('/sign-up')}>
                    Sign up
                  </a>
                </>
              )}
            </div>
          </>
        )
      }
    </div>

    <aside class="side" aria-label="About problems">
      {
        streak !== null && (
          <div class="card streak">
            <p class="kicker">Your streak</p>
            <p class="streak-num">{streak ? tally(streak, 'week') : 'No streak yet'}</p>
            <p class="small">{streakNote}</p>
          </div>
        )
      }
      <div class="card how">
        <p class="kicker">How it works</p>
        <ol>
          <li>One scenario a week. No client data, ever.</li>
          <li>Pick an answer and explain it.</li>
          <li>See everyone else’s once you lock in.</li>
          <li>Members with the seal rate the reasoning. It builds your judgment record.</li>
        </ol>
      </div>
      {
        past.length > 0 && (
          <div>
            <p class="kicker side-label" id="past-title">
              Past problems
            </p>
            <ul class="past card" aria-labelledby="past-title">
              {past.map((entry) => (
                <li>
                  <a href={to(`/problems/${entry.number}`)} aria-current={entry.number === problem?.number ? 'page' : undefined}>
                    <span class="num">#{entry.number}</span>
                    <span>
                      <b>{entry.title}</b>
                      <br />
                      <span class="pixel">{entry.tag}</span>
                    </span>
                    <span class="num">
                      {entry.answers}
                      <span class="sr-only"> answers</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            {closed && (
              <a class="small back-week" href={to('/problems')}>
                This week’s problem
              </a>
            )}
          </div>
        )
      }
      {
        team && (
          <a class="btn sm ghost" href={to('/problems/new')}>
            Write a problem
          </a>
        )
      }
    </aside>
  </div>
</Social>

<script>
  /* The spread grows in once, from nothing to where the server drew it. Without a script, or with reduced motion, it is simply there. */
  const fills = document.querySelectorAll<HTMLElement>('.results .fill');
  const counts = document.querySelectorAll<HTMLElement>('.results .pct');
  if (fills.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const fill of fills) fill.classList.add('from-zero');
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        for (const fill of fills) fill.classList.remove('from-zero');
        const start = performance.now();
        const step = (time: number) => {
          const k = Math.min(1, (time - start) / 900);
          for (const count of counts) count.textContent = `${Math.round(Number(count.dataset.to) * (1 - (1 - k) ** 3))}%`;
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }),
    );
  }
</script>
