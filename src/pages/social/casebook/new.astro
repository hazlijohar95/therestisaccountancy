---
import { actions, isInputError } from 'astro:actions';
import Tick from '../../../components/social/Tick.astro';
import { AREAS, BANDS, CASEBOOK_LIMITS, casebookYears, EMPLOYER_KINDS, ENGAGEMENT_ROLES, FRAMEWORKS, INDUSTRIES, ROLE_LIMITS, SERVICES } from '../../../data/social.ts';
import Social from '../../../layouts/Social.astro';
import { postedValues } from '../../../lib/form.ts';
import { formAction } from '../../../lib/format.ts';
import { identifying } from '../../../lib/guard.ts';
import { addressed, signInPath, socialPath } from '../../../server/paths.ts';

export const prerender = false;

const to = (path: string) => socialPath(Astro.url, path);
const { member, profile, socialCasebook } = Astro.locals;
if (!member) return Astro.redirect(signInPath(Astro.url, '/casebook/new'));

const results = {
  entry: Astro.getActionResult(actions.addEntry),
  removeEntry: Astro.getActionResult(actions.removeEntry),
  role: Astro.getActionResult(actions.addRole),
  removeRole: Astro.getActionResult(actions.removeRole),
};
const here = to('/casebook/new');
if (results.entry?.data) return Astro.redirect(`${here}?done=added#entries`);
if (results.removeEntry?.data) return Astro.redirect(`${here}?done=entry-removed#entries`);
if (results.role?.data) return Astro.redirect(`${here}?done=role-added#roles`);
if (results.removeRole?.data) return Astro.redirect(`${here}?done=role-removed#roles`);

const entries = profile ? await socialCasebook.entries(member.id) : [];
const roles = profile ? await socialCasebook.roles(member.id) : [];
const posted = await postedValues(Astro.request);
const entryErrors = results.entry?.error && isInputError(results.entry.error) ? results.entry.error.fields : {};
const roleErrors = results.role?.error && isInputError(results.role.error) ? results.role.error.fields : {};
const failure = [results.entry, results.role].map((r) => (r?.error && !isInputError(r.error) ? r.error.message : null)).find(Boolean) ?? null;
const action = (which: { toString(): string }) => formAction(addressed(Astro.url), which);
const years = casebookYears(new Date());
const thisYear = Number(years[0]) + 1;
const entryAgain = results.entry?.error !== undefined;
const roleAgain = results.role?.error !== undefined;
const pick = (name: string, fallback: string) => (entryAgain ? posted.one(name) || fallback : fallback);
const draft = {
  service: pick('service', SERVICES[0]),
  industry: pick('industry', INDUSTRIES[0]),
  band: pick('band', BANDS[0]),
  framework: pick('framework', FRAMEWORKS[0]),
  year: pick('year', years[0] ?? ''),
  role: pick('role', ENGAGEMENT_ROLES[0]),
  areas: entryAgain ? posted.all('areas') : [],
  note: entryAgain ? posted.one('note') : '',
  cosigner: entryAgain ? posted.one('cosigner') : '',
};
const warnings = identifying(draft.note);
const selects = [
  { name: 'service', label: 'Type of work', options: SERVICES },
  { name: 'industry', label: 'Industry', options: INDUSTRIES },
  { name: 'band', label: 'Size band', options: BANDS },
  { name: 'framework', label: 'Framework', options: FRAMEWORKS },
  { name: 'year', label: 'Year it ended', options: years, hint: 'Ended a year ago or more.' },
  { name: 'role', label: 'Your role', options: ENGAGEMENT_ROLES },
] as const;
const COSIGN_LINE = { pending: 'Waiting on', signed: 'Co-signed by', declined: 'Declined by' } as const;
const done = Astro.url.searchParams.get('done');
const DONE = {
  added: 'Added to your casebook.',
  'entry-removed': 'Entry removed.',
  'role-added': 'Role added to your timeline.',
  'role-removed': 'Role removed.',
} as const;
const doneNote = Object.entries(DONE).find(([key]) => key === done)?.[1] ?? null;
---

<Social title="Casebook" noindex>
  <div class="page">
    <div class="page-head">
      <div>
        <p class="kicker">Casebook</p>
        <h1 class="title">Log the work, not the client.</h1>
        <p class="lead">Bands and years only. A colleague with the seal co-signs it.</p>
      </div>
    </div>
    {
      !profile ? (
        <div class="card empty">
          <p class="head">Claim your handle first.</p>
          <p>Your casebook shows on your profile.</p>
          <a class="btn sm" href={to('/edit')}>
            Claim your handle
          </a>
        </div>
      ) : (
        <>
          {doneNote && (
            <p class="note" role="status">
              {doneNote}
            </p>
          )}
          {failure && (
            <p class="error" role="alert">
              {failure}
            </p>
          )}
          <div class="form-grid">
            <form class="panel card" method="POST" action={action(actions.addEntry)} novalidate data-entry-form>
              <div class="row2">
                {selects.map((field) => (
                  <div class="field">
                    <label for={`e-${field.name}`}>{field.label}</label>
                    <select class="input" id={`e-${field.name}`} name={field.name} data-preview={field.name}>
                      {field.options.map((option) => (
                        <option selected={draft[field.name] === option ? true : undefined}>{option}</option>
                      ))}
                    </select>
                    {'hint' in field && <span class="hint">{field.hint}</span>}
                  </div>
                ))}
              </div>
              <fieldset class="field plain-fieldset">
                <legend class="label-text">Key areas · optional</legend>
                <div class="chips">
                  {AREAS.map((area) => (
                    <label class="chip">
                      <input class="sr-only" type="checkbox" name="areas" value={area} checked={draft.areas.includes(area) ? true : undefined} data-preview="areas" />
                      {area}
                    </label>
                  ))}
                </div>
              </fieldset>
              <div class="field">
                <label for="e-note">What you learned · optional</label>
                <textarea class="input" id="e-note" name="note" rows="3" maxlength={CASEBOOK_LIMITS.note} placeholder="Pushed back on a stock provision that relied on one supplier quote." aria-describedby="e-guard" aria-invalid={warnings.length || entryErrors.note ? 'true' : undefined} data-preview="note">{draft.note}</textarea>
                <div class="guard" id="e-guard" aria-live="polite" data-guard>
                  {warnings.length ? (
                    warnings.map((warning) => (
                      <span class="warn">
                        <svg aria-hidden="true">
                          <use href="#i-flag" />
                        </svg>
                        <span>{warning}</span>
                      </span>
                    ))
                  ) : (
                    <span class="okline">
                      <Tick source="register" state="ticked" /> Nothing here points at a client.
                    </span>
                  )}
                </div>
              </div>
              <div class="field">
                <label for="e-cosign">Who can co-sign it · optional</label>
                <div class="prefix">
                  <input class="input" id="e-cosign" name="cosigner" value={draft.cosigner} autocomplete="off" spellcheck="false" aria-describedby="e-cosign-hint" data-preview="cosigner" />
                </div>
                <span class="hint" id="e-cosign-hint">
                  The handle of a colleague with the seal who worked on it or reviewed it. They confirm it in their notifications.
                </span>
              </div>
              <div class="panel-foot">
                <span class="small">It shows on your heatmap now. Co-signed once they confirm.</span>
                <button class="btn" type="submit">
                  Add to casebook
                </button>
              </div>
            </form>
            <aside class="aside-stack" aria-label="Preview">
              <p class="kicker">Preview</p>
              <article class="entry card">
                <p class="head">
                  <span data-show="service">{draft.service}</span> · <span data-show="industry">{draft.industry}</span>
                </p>
                <dl>
                  <dt>Band</dt>
                  <dd data-show="band">{draft.band}</dd>
                  <dt>Framework</dt>
                  <dd data-show="framework">{draft.framework}</dd>
                  <dt>Year</dt>
                  <dd data-show="year">{draft.year}</dd>
                  <dt>Role</dt>
                  <dd data-show="role">{draft.role}</dd>
                  <dt>Areas</dt>
                  <dd data-show="areas">{draft.areas.join(', ') || 'None picked'}</dd>
                </dl>
                <p class="cosign">
                  <Tick source="self" state="self" />
                  <span data-show="cosigner">{draft.cosigner ? `Waiting on @${draft.cosigner.replace(/^@/, '')} to co-sign` : 'Not co-signed'}</span>
                </p>
              </article>
            </aside>
          </div>

          <section class="section card" id="entries" aria-labelledby="entries-title">
            <header>
              <h2 class="head" id="entries-title">
                Your entries
              </h2>
              <a class="small" href={to('/me#casebook')}>
                See your heatmap
              </a>
            </header>
            {entries.length ? (
              <ul class="saved-list">
                {entries.map((entry) => (
                  <li>
                    <svg class="ic" aria-hidden="true">
                      <use href="#i-file" />
                    </svg>
                    <span>
                      <b>
                        {entry.service} · {entry.industry}
                      </b>
                      <br />
                      {entry.band} · {entry.year} · {entry.role}
                      {entry.cosign && entry.cosigner && ` · ${COSIGN_LINE[entry.cosign]} ${entry.cosigner.name}`}
                    </span>
                    <details class="remove">
                      <summary class="act">
                        Remove<span class="sr-only"> {entry.service} · {entry.industry}, {entry.year}</span>
                      </summary>
                      <form method="POST" action={action(actions.removeEntry)}>
                        <input type="hidden" name="entry" value={entry.id} />
                        <p class="small">Take it off your casebook? A co-sign goes with it.</p>
                        <button class="btn sm danger" type="submit">
                          Remove entry
                        </button>
                      </form>
                    </details>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="small">No entries yet. Your first one starts your heatmap.</p>
            )}
          </section>

          <section class="section card" id="roles" aria-labelledby="roles-title">
            <header>
              <h2 class="head" id="roles-title">
                Your roles
              </h2>
              <span class="small">The kind of employer, never its name.</span>
            </header>
            {roles.length > 0 && (
              <ul class="saved-list">
                {roles.map((role) => (
                  <li>
                    <svg class="ic" aria-hidden="true">
                      <use href="#i-list" />
                    </svg>
                    <span>
                      <b>{role.title}</b> · {role.employer}
                      <br />
                      {role.from} to {role.to ?? 'now'}
                    </span>
                    <details class="remove">
                      <summary class="act">
                        Remove<span class="sr-only"> {role.title}</span>
                      </summary>
                      <form method="POST" action={action(actions.removeRole)}>
                        <input type="hidden" name="role" value={role.id} />
                        <button class="btn sm danger" type="submit">
                          Remove role
                        </button>
                      </form>
                    </details>
                  </li>
                ))}
              </ul>
            )}
            <form method="POST" action={action(actions.addRole)} novalidate class="role-form">
              <div class="row2">
                <div class="field">
                  <label for="r-title">What you did</label>
                  <input class="input" id="r-title" name="title" maxlength={ROLE_LIMITS.title} placeholder="Audit senior to manager" value={roleAgain ? posted.one('title') : ''} aria-invalid={roleErrors.title ? 'true' : undefined} aria-describedby={roleErrors.title ? 'r-title-error' : undefined} />
                  {roleErrors.title && (
                    <span class="error" id="r-title-error">
                      {roleErrors.title.join(' ')}
                    </span>
                  )}
                </div>
                <div class="field">
                  <label for="r-employer">Kind of employer</label>
                  <select class="input" id="r-employer" name="employer">
                    {EMPLOYER_KINDS.map((kind) => (
                      <option selected={roleAgain && posted.one('employer') === kind ? true : undefined}>{kind}</option>
                    ))}
                  </select>
                </div>
                <div class="field">
                  <label for="r-from">From</label>
                  <input class="input" id="r-from" name="from" inputmode="numeric" min={ROLE_LIMITS.earliest} max={thisYear} placeholder={String(thisYear - 3)} value={roleAgain ? posted.one('from') : ''} aria-invalid={roleErrors.from ? 'true' : undefined} aria-describedby={roleErrors.from ? 'r-from-error' : undefined} />
                  {roleErrors.from && (
                    <span class="error" id="r-from-error">
                      {roleErrors.from[0]}
                    </span>
                  )}
                </div>
                <div class="field">
                  <label for="r-to">To · blank if you are still there</label>
                  <input class="input" id="r-to" name="to" inputmode="numeric" min={ROLE_LIMITS.earliest} max={thisYear} value={roleAgain ? posted.one('to') : ''} aria-invalid={roleErrors.to ? 'true' : undefined} aria-describedby={roleErrors.to ? 'r-to-error' : undefined} />
                  {roleErrors.to && (
                    <span class="error" id="r-to-error">
                      {roleErrors.to[0]}
                    </span>
                  )}
                </div>
              </div>
              <div class="panel-foot">
                <span class="small">Roles draw your timeline.</span>
                <button class="btn sm" type="submit">
                  Add role
                </button>
              </div>
            </form>
          </section>
        </>
      )
    }
  </div>
</Social>

<script>
  import { identifying } from '../../../lib/guard.ts';

  /* The preview and the guard follow what is typed. The server checks the same note again. */
  const form = document.querySelector<HTMLFormElement>('[data-entry-form]');
  const guard = document.querySelector<HTMLElement>('[data-guard]');
  const note = document.querySelector<HTMLTextAreaElement>('#e-note');
  const okLine = guard?.querySelector('.okline')?.cloneNode(true) ?? null;

  const show = (name: string, value: string) => {
    const target = document.querySelector<HTMLElement>(`[data-show="${name}"]`);
    if (target) target.textContent = value;
  };

  const update = () => {
    if (!form || !guard || !note) return;
    const data = new FormData(form);
    for (const name of ['service', 'industry', 'band', 'framework', 'year', 'role']) show(name, String(data.get(name) ?? ''));
    show('areas', data.getAll('areas').map(String).join(', ') || 'None picked');
    const cosigner = String(data.get('cosigner') ?? '').trim().replace(/^@/, '');
    show('cosigner', cosigner ? `Waiting on @${cosigner} to co-sign` : 'Not co-signed');

    const warnings = identifying(note.value);
    const shown = [...guard.querySelectorAll('.warn span')].map((span) => span.textContent);
    if (shown.join('|') === warnings.join('|') && (warnings.length > 0 || guard.querySelector('.okline'))) return;
    if (warnings.length) note.setAttribute('aria-invalid', 'true');
    else note.removeAttribute('aria-invalid');
    guard.replaceChildren(
      ...(warnings.length
        ? warnings.map((message) => {
            const warning = document.createElement('span');
            warning.className = 'warn';
            warning.innerHTML = '<svg aria-hidden="true"><use href="#i-flag"></use></svg>';
            const words = document.createElement('span');
            words.textContent = message;
            warning.appendChild(words);
            return warning;
          })
        : okLine
          ? [okLine.cloneNode(true)]
          : []),
    );
  };

  form?.addEventListener('input', update);
  form?.addEventListener('change', update);
</script>
