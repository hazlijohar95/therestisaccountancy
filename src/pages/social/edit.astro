---
import { actions, isInputError } from 'astro:actions';
import { HANDLE, JURISDICTIONS, PROFILE_LIMITS, SECTORS, socialHost, TOPICS } from '../../data/social.ts';
import Social from '../../layouts/Social.astro';
import { formAction } from '../../lib/format.ts';
import { addressed, signInPath, socialPath } from '../../server/paths.ts';

export const prerender = false;

const to = (path: string) => socialPath(Astro.url, path);
const { member, socialProfiles } = Astro.locals;
if (Astro.getActionResult(actions.signOut)?.data) return Astro.redirect(to('/'));
if (!member) return Astro.redirect(signInPath(Astro.url, '/edit'));

const saved = Astro.getActionResult(actions.saveProfile);
if (saved?.data) return Astro.redirect(to(`/@${saved.data.handle}`));

const profile = await socialProfiles.ownProfile(member.id);
const fieldErrors = saved?.error && isInputError(saved.error) ? saved.error.fields : {};
const refusal = saved?.error && !isInputError(saved.error) ? saved.error.message : null;
/* Before a handle is claimed, every refusal is about the handle, so it shows beside it. */
const errors = {
  handle: fieldErrors.handle?.[0] ?? (!profile ? (refusal ?? undefined) : undefined),
  headline: fieldErrors.headline?.[0],
  sector: fieldErrors.sector?.[0],
  city: fieldErrors.city?.[0],
};
const failure = profile ? refusal : null;
const first = (['handle', 'headline', 'sector', 'city'] as const).find((field) => errors[field]);
const invalid = (field: keyof typeof errors) => (errors[field] ? 'true' : undefined);
const describedBy = (field: keyof typeof errors, hint?: string) => [hint, errors[field] ? `${field}-error` : undefined].filter(Boolean).join(' ') || undefined;

/* A refused form is shown back as it was typed. Astro's actions read a clone of the request, so the body is unread here. */
const posted = saved?.error ? await Astro.request.formData().catch(() => null) : null;
const typed = (name: string, fallback: string) => {
  if (!posted) return fallback;
  const value = posted.get(name);
  return typeof value === 'string' ? value : '';
};
const ticked = (name: string, fallback: boolean) => (posted ? posted.has(name) : fallback);
const chosen = (name: string, fallback: readonly string[]): readonly string[] => (posted ? posted.getAll(name).filter((v) => typeof v === 'string') : fallback);
const sector = typed('sector', profile?.sector ?? '');
const jurisdictions = chosen('jurisdictions', profile?.jurisdictions ?? []);
const topics = chosen('topics', profile?.topics ?? []);
---

<Social title={profile ? 'Edit profile' : 'Claim your handle'} noindex>
  <div class="page narrow">
    <div class="page-head">
      <div>
        <p class="kicker">Your profile</p>
        <h1 class="title">{profile ? 'Edit profile.' : 'Claim your handle.'}</h1>
        {!profile && <p class="lead">Signed in as {member.name}. Pick the handle people find you by.</p>}
      </div>
    </div>
    <form class="panel card" method="POST" action={formAction(addressed(Astro.url), actions.saveProfile)} novalidate>
      {
        !profile && (
          <div class="field">
            <label for="handle">Handle</label>
            <div class="prefix">
              <input class="input" id="handle" name="handle" required minlength={HANDLE.min} maxlength={HANDLE.max} autocapitalize="none" spellcheck="false" value={typed('handle', '')} aria-invalid={invalid('handle')} aria-describedby={describedBy('handle', 'handle-hint')} autofocus={first === 'handle' ? true : undefined} />
            </div>
            <span class="hint" id="handle-hint">{HANDLE.min} to {HANDLE.max} lowercase letters, digits or underscores. Your page is {socialHost}/@handle. You cannot change it later.</span>
            {errors.handle && <span class="error" id="handle-error">{errors.handle}</span>}
          </div>
        )
      }
      <div class="field">
        <label for="headline">Headline</label>
        <textarea class="input" id="headline" name="headline" rows="2" maxlength={PROFILE_LIMITS.headline} placeholder="Tax agent. Explains Malaysian tax one case at a time." aria-invalid={invalid('headline')} aria-describedby={describedBy('headline', 'headline-hint')} autofocus={first === 'headline' ? true : undefined}>{typed('headline', profile?.headline ?? '')}</textarea>
        <span class="hint" id="headline-hint">Up to {PROFILE_LIMITS.headline} characters. One line on what you post about.</span>
        {errors.headline && <span class="error" id="headline-error">{errors.headline}</span>}
      </div>
      <div class="row2">
        <div class="field">
          <label for="sector">Where you work</label>
          <select class="input" id="sector" name="sector" aria-invalid={invalid('sector')} aria-describedby={describedBy('sector')} autofocus={first === 'sector' ? true : undefined}>
            <option value="" selected={sector === ''}>Not saying</option>
            {SECTORS.map((s) => <option value={s} selected={sector === s}>{s}</option>)}
          </select>
          {errors.sector && <span class="error" id="sector-error">{errors.sector}</span>}
        </div>
        <div class="field">
          <label for="city">City</label>
          <input class="input" id="city" name="city" maxlength={PROFILE_LIMITS.city} autocomplete="address-level2" value={typed('city', profile?.city ?? '')} aria-invalid={invalid('city')} aria-describedby={describedBy('city')} autofocus={first === 'city' ? true : undefined} />
          {errors.city && <span class="error" id="city-error">{errors.city}</span>}
        </div>
      </div>
      <fieldset class="plain-fieldset">
        <legend class="label-text">Jurisdictions you work in</legend>
        <div class="chips">
          {
            JURISDICTIONS.map((j) => (
              <label class="chip">
                <input class="sr-only" type="checkbox" name="jurisdictions" value={j} checked={jurisdictions.includes(j)} />
                {j}
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset class="plain-fieldset">
        <legend class="label-text">What you post about</legend>
        <div class="chips">
          {
            TOPICS.map((t) => (
              <label class="chip">
                <input class="sr-only" type="checkbox" name="topics" value={t} checked={topics.includes(t)} />
                {t}
              </label>
            ))
          }
        </div>
      </fieldset>
      <label class="check">
        <input type="checkbox" name="creator" checked={ticked('creator', profile?.creator ?? false)} />
        <span><b>I mainly make content</b><span class="hint">Shows the Creator flair until a credential is ticked.</span></span>
      </label>
      <label class="check">
        <input type="checkbox" name="listed" checked={ticked('listed', profile?.listed ?? true)} />
        <span><b>Show me on The List</b><span class="hint">Off, your page still works for anyone with the link.</span></span>
      </label>
      {failure && <p class="error" role="alert">{failure}</p>}
      <div class="panel-foot">
        <a class="btn ghost" href={to(profile ? `/@${profile.handle}` : '/')}>Cancel</a>
        <button class="btn" type="submit">{profile ? 'Save profile' : 'Claim handle'}</button>
      </div>
    </form>
    <form class="signout" method="POST" action={formAction(addressed(Astro.url), actions.signOut)}>
      <p class="small">Signed in as {member.email}. <button class="linkish" type="submit">Sign out</button></p>
    </form>
  </div>
</Social>

<style>
  .signout { margin-top: var(--space-5); }
</style>
