---
import { authorByHandle, authorPath, type Author } from '../data/authors.ts';
import { columnBySlug, columnPath } from '../data/columns.ts';
import { formatDay } from '../lib/format.ts';
import { postPath, type Post } from '../server/posts.ts';

/** The one list every index uses: the newsletter, a column, an author, a programme, the podcast. */
interface Props {
  posts: readonly Post[];
  /** On a column's own page its name on every row is noise. */
  showColumn?: boolean;
}

const { posts, showColumn = true } = Astro.props;
const byline = (post: Post) => post.data.authors.flatMap((h) => authorByHandle(h) ?? []) satisfies Author[];
---

<ol class="posts">
  {
    posts.map((post) => {
      const column = columnBySlug(post.data.column);
      return (
        <li class="post">
          <div class="meta small">
            {showColumn && column && <a class="label" href={columnPath(column)}>{column.name}</a>}
            <span>{formatDay(post.data.date)}</span>
            {post.data.access === 'members' && <span class="members">Members</span>}
          </div>
          <h3 class="title serif"><a href={postPath(post)}>{post.data.title}</a></h3>
          <p>{post.data.dek}</p>
          <p class="small">
            {byline(post).map((author, i) => (
              <>
                {i > 0 && ', '}
                <a href={authorPath(author)}>{author.name}</a>
              </>
            ))}
          </p>
        </li>
      );
    })
  }
</ol>

<style>
  .posts { display: grid; margin: 0; padding: 0; list-style: none; border-top: var(--stroke-rule) solid var(--ink); }
  .post { display: grid; gap: var(--space-2); padding-block: var(--space-5); border-bottom: var(--stroke-hair) solid var(--ink); }
  .post p, .title { margin: 0; }
  .meta { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); }
  .meta a { text-decoration: none; }
  .members { font-weight: 600; }
  .title { font-size: clamp(1.35rem, 1.15rem + .8vw, 1.75rem); line-height: 1.15; }
  .title a { text-decoration: none; }
  .title a:hover { text-decoration: underline; text-decoration-thickness: var(--stroke-hair); }
  .post p:not(.small) { max-width: 30em; }
</style>
