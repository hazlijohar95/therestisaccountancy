---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { covers } from '../data/covers.ts';
import { lines, type LineGroup } from '../data/lines.ts';

/*
 * The club in one band, halfway down the home page: what we make, as three ways in. Each tile takes the lines in its
 * group, so a new line shows here without a change.
 */
const ways: readonly { group: LineGroup; cover: ImageMetadata; href: `/${string}` }[] = [
  { group: 'Read', cover: covers.podcast, href: '/newsletter' },
  { group: 'Build', cover: covers.data, href: '/products' },
  { group: 'Learn', cover: covers.practice, href: '/programmes' },
];
const tiles = ways.map((way) => ({ ...way, links: lines.filter((line) => line.group === way.group) }));
---

<section class="wrap" aria-labelledby="ways-title">
  <div class="panel night">
    <h2 class="serif" id="ways-title">Ideas, tools and training for accountants who run a practice.</h2>
    <ul class="ways">
      {
        tiles.map((tile) => (
          <li>
            <a class="art" href={tile.href} tabindex="-1" aria-hidden="true">
              <Image src={tile.cover} alt="" widths={[320, 480, 640]} sizes="(min-width: 900px) 30vw, 90vw" loading="lazy" />
              <span class="word serif">{tile.group}</span>
            </a>
            <p class="links">{tile.links.map((link) => <a href={link.href}>{link.label} →</a>)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  section { padding-block: clamp(40px, 5vw, 72px); }
  .panel { display: grid; gap: clamp(32px, 4vw, 56px); padding: clamp(40px, 6vw, 88px) clamp(20px, 4vw, 56px); text-align: center; }
  h2 { justify-self: center; max-width: 20ch; margin: 0; font-size: var(--size-title); line-height: 1.02; text-wrap: balance; }
  .ways { display: grid; gap: var(--space-6); margin: 0; padding: 0; list-style: none; }
  .ways li { display: grid; gap: var(--space-3); }
  .art { position: relative; display: block; overflow: hidden; border: var(--stroke-hair) solid color-mix(in srgb, var(--ink) 25%, transparent); }
  .art img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; transition: scale var(--motion-settle) var(--motion-ease); }
  .word { position: absolute; inset: auto 0 0; padding: var(--space-6) var(--space-4) var(--space-4); background: linear-gradient(transparent, rgb(0 0 0 / .85)); font-size: clamp(2rem, 1.4rem + 2vw, 3rem); line-height: 1; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2) var(--space-5); margin: 0; }
  .links a { font: 600 var(--size-small)/1.4 var(--font-sans); text-decoration: none; }
  @media (hover: hover) {
    .links a:hover { text-decoration: underline; text-decoration-thickness: var(--stroke-hair); }
    li:has(a:hover) .art img { scale: 1.03; }
  }
  @media (prefers-reduced-motion: reduce) { .art img { transition: none; } li:has(a:hover) .art img { scale: none; } }
  @media (min-width: 900px) { .ways { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
