---
import { actions } from 'astro:actions';
import { ROOMS } from '../../data/social.ts';
import { formAction, formatMoment } from '../../lib/format.ts';
import { addressed, socialPath } from '../../server/paths.ts';
import type { PostCard } from '../../server/social-floor.ts';
import PostText from '../PostText.astro';
import Avatar from './Avatar.astro';
import Flair from './Flair.astro';

interface Props {
  post: PostCard;
  /** The thread page: the whole body, and the title as the page's heading. */
  full?: boolean;
  /** Signed in, so the useful mark is a button. */
  signedIn: boolean;
  /** The id of the control the last action used, which takes focus again after the page reloads. */
  focus?: string | null;
}

const { post, full = false, signedIn, focus = null } = Astro.props;
const to = (path: string) => socialPath(Astro.url, path);
const action = (which: { toString(): string }) => formAction(addressed(Astro.url), which);
const href = to(`/post/${post.id}`);
const usefulId = `useful-post-${post.id}`;
const room = ROOMS.find((r) => r.id === post.room)?.name ?? '';
const EXCERPT = 280;
const excerpt = post.body.length > EXCERPT ? `${post.body.slice(0, EXCERPT).trimEnd()}…` : post.body;
const replies = `${post.replies} ${post.replies === 1 ? 'reply' : 'replies'}`;
---

<article class="post" aria-labelledby={`post-${post.id}-title`}>
  <div class="by">
    <a class="author" href={to(`/@${post.author.handle}`)}>
      <Avatar name={post.author.name} track={post.author.track} sealed={post.author.sealed} size="sm" />
      <span class="name-line">
        {post.author.name}
        {
          post.author.sealed && (
            <svg class="seal" role="img" aria-label="Ticked">
              <use href="#seal" />
            </svg>
          )
        }
      </span>
    </a>
    <Flair track={post.author.track} />
    <span class="jur" title="Jurisdiction">{post.jurisdiction}</span>
    <span class="ago"><time datetime={post.createdAt}>{formatMoment(post.createdAt)}</time> · {room}{post.editedAt && ' · edited'}</span>
  </div>
  {
    full ? (
      <h1 class="post-title" id={`post-${post.id}-title`}>{post.title}</h1>
    ) : (
      <h2 id={`post-${post.id}-title`}>
        <a class="post-link" href={href}>{post.title}</a>
      </h2>
    )
  }
  {post.body && (full ? <PostText text={post.body} /> : <p class="excerpt">{excerpt}</p>)}
  {
    post.correction && (
      <p class="correction">
        <svg aria-hidden="true"><use href="#i-flag" /></svg>
        <span>
          Corrected. A member with the seal flagged a mistake. <a href={`${href}#reply-${post.correction.replyId}`}>Read the correction</a>.
        </span>
      </p>
    )
  }
  <div class="foot-row">
    {
      post.answer && (
        <a class="answered" href={`${href}#reply-${post.answer.replyId}`}>
          <svg class="tick" aria-hidden="true"><use href="#tk" /></svg>
          Answered by a ticked {post.answer.credential}
        </a>
      )
    }
    <span class="spacer"></span>
    {
      signedIn && !post.mine ? (
        <form method="POST" action={action(post.usefulByViewer ? actions.unmarkUseful : actions.markUseful)}>
          <input type="hidden" name="target" value="post" />
          <input type="hidden" name="id" value={post.id} />
          <button class="act" type="submit" id={usefulId} aria-pressed={post.usefulByViewer ? 'true' : 'false'} autofocus={focus === usefulId ? true : undefined}>
            <svg aria-hidden="true"><use href="#i-up" /></svg>
            {post.useful} useful
          </button>
        </form>
      ) : (
        <span class="act">
          <svg aria-hidden="true"><use href="#i-up" /></svg>
          {post.useful} useful
        </span>
      )
    }
    {
      full ? (
        <span class="act">
          <svg aria-hidden="true"><use href="#i-reply" /></svg>
          {replies}
        </span>
      ) : (
        <a class="act" href={`${href}#replies`}>
          <svg aria-hidden="true"><use href="#i-reply" /></svg>
          {replies}
        </a>
      )
    }
    <slot />
  </div>
</article>
