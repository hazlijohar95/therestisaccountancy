---
import { actions } from 'astro:actions';
import { reasonsFor, REPORT_NOTE_MAX, type ReportTarget } from '../../data/social.ts';
import { formAction } from '../../lib/format.ts';
import { addressed } from '../../server/paths.ts';

/** A Report button and its dialog. The button opens the native dialog by command, with no script where browsers support it. */
interface Props {
  target: ReportTarget;
  /** A post or reply's id. */
  id?: number;
  /** A profile's handle. */
  handle?: string;
  /** What the report is about, read after "Report": "this post", "@aina". */
  about: string;
  class?: string;
}

const { target, id, handle, about, class: className = 'act' } = Astro.props;
const dialog = `report-${target}-${id ?? handle ?? ''}`;
const reasons = reasonsFor(target);
---

<button class={className} type="button" commandfor={dialog} command="show-modal">
  <svg aria-hidden="true"><use href="#i-flag" /></svg>
  Report<span class="sr-only"> {about}</span>
</button>
<dialog class="modal card" id={dialog} aria-labelledby={`${dialog}-title`}>
  <form method="POST" action={formAction(addressed(Astro.url), actions.report)}>
    <input type="hidden" name="target" value={target} />
    {id !== undefined && <input type="hidden" name="id" value={id} />}
    {handle !== undefined && <input type="hidden" name="handle" value={handle} />}
    <p class="kicker">Report {about}</p>
    <h2 class="head" id={`${dialog}-title`}>What’s wrong?</h2>
    <fieldset class="radios">
      <legend class="sr-only">Reason</legend>
      {
        reasons.map((reason, i) => (
          <label class="radio">
            <input type="radio" name="reason" value={reason.id} checked={i === 0} />
            {reason.label}
          </label>
        ))
      }
    </fieldset>
    <div class="field">
      <label for={`${dialog}-note`}>Anything we should know · optional</label>
      <textarea class="input" id={`${dialog}-note`} name="note" rows="3" maxlength={REPORT_NOTE_MAX}></textarea>
    </div>
    <div class="row-end">
      <span class="small">A person on the team reads every report.</span>
      <button class="btn" type="submit">Send report</button>
    </div>
  </form>
  <button class="icon-btn close" type="button" commandfor={dialog} command="close" aria-label="Close dialog">
    <svg aria-hidden="true"><use href="#i-x" /></svg>
  </button>
</dialog>
