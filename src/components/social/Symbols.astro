---
/* The tick glyphs, the seal and the icons the social pages draw, once per page. Use one with <svg><use href="#id" /></svg>. */
---

<svg width="0" height="0" style="position: absolute" aria-hidden="true">
  <defs>
    <symbol id="tk" viewBox="0 0 24 24"><path d="M5.2 12.9c1.5 1 2.8 2.4 4 4.1 2.6-4.4 5.6-7.9 9.8-10.9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="t-register" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M7.6 12.7c1 .7 1.9 1.7 2.8 2.9 1.8-3.1 4-5.5 6.9-7.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="t-document" viewBox="0 0 24 24"><path d="M5.2 10.4c1.4.9 2.6 2.2 3.7 3.8 2.4-4 5.2-7.3 9.1-10" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 19.5h15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></symbol>
    <symbol id="t-vouch" viewBox="0 0 24 24"><path d="M5.2 10.4c1.4.9 2.6 2.2 3.7 3.8 2.4-4 5.2-7.3 9.1-10" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7" cy="19.6" r="1.7" fill="currentColor"/><circle cx="12" cy="19.6" r="1.7" fill="currentColor"/><circle cx="17" cy="19.6" r="1.7" fill="currentColor"/></symbol>
    <symbol id="t-email" viewBox="0 0 24 24"><path d="M3.5 5.2h7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M5.2 12.9c1.5 1 2.8 2.4 4 4.1 2.6-4.4 5.6-7.9 9.8-10.9" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="t-account" viewBox="0 0 24 24"><path d="M7 3.5H3.5v17H7M17 3.5h3.5v17H17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="square"/><path d="M8 12.6c1 .7 1.8 1.6 2.6 2.8 1.6-2.9 3.5-5.1 6-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="t-self" viewBox="0 0 24 24"><path d="M5.2 12.9c1.5 1 2.8 2.4 4 4.1 2.6-4.4 5.6-7.9 9.8-10.9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="2.6 2.8"/></symbol>
    <symbol id="seal" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10.4" style="fill:var(--color-tape);stroke:var(--seal-ring)" stroke-width="1.8"/><path d="M7.3 12.6c1.1.8 2.1 1.9 3 3.2 2-3.4 4.3-6 7.3-8.2" fill="none" style="stroke:var(--color-ink)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-floor" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></symbol>
    <symbol id="i-list" viewBox="0 0 24 24"><path d="M4 5h3v3H4zM4 10.5h3v3H4zM4 16h3v3H4zM10 6.5h10M10 12h10M10 17.5h7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></symbol>
    <symbol id="i-problem" viewBox="0 0 24 24"><path d="M4 4h16v12H9l-5 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M10 8.2a2 2 0 1 1 2.6 1.9c-.4.2-.6.5-.6.9v.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="13.6" r="1" fill="currentColor"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 4v16M4 12h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></symbol>
    <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></symbol>
    <symbol id="i-up" viewBox="0 0 24 24"><path d="M12 5l7 8h-4.5v6h-5v-6H5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
    <symbol id="i-edit" viewBox="0 0 24 24"><path d="M4 20l1-4.5L15.5 5a2.1 2.1 0 0 1 3 3L8 18.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
  </defs>
</svg>
