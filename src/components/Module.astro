---
/** A home page module: a ruled label that links to where the module's items come from, then the items. */
interface Props {
  id: string;
  label: string;
  href: string;
  intro?: string;
}

const { id, label, href, intro } = Astro.props;
---

<section class="wrap module" id={id} aria-labelledby={`${id}-label`}>
  <header>
    <h2 class="label" id={`${id}-label`}><a href={href}>{label}</a></h2>
    {intro && <p class="intro">{intro}</p>}
  </header>
  <slot />
</section>

<style>
  .module { display: grid; gap: var(--space-5); padding-block: clamp(40px, 5vw, 72px); }
  header { display: grid; gap: var(--space-2); padding-top: var(--space-3); border-top: var(--stroke-rule) solid var(--ink); }
  h2, .intro { margin: 0; }
  h2 a { text-decoration: none; }
  h2 a::after { content: " →"; }
  h2 a:hover { text-decoration: underline; text-decoration-thickness: var(--stroke-hair); }
  .intro { max-width: 40em; }
</style>
