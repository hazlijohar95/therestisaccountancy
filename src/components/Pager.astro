---
import { pageHref } from '../lib/paging.ts';

interface Props {
  url: URL;
  page: number;
  pages: number;
  label: string;
}
const { url, page, pages, label } = Astro.props;
---

{
  pages > 1 && (
    <nav class="pager" aria-label={label}>
      {page > 1 ? <a href={pageHref(url, page - 1)} rel="prev">Previous</a> : <span />}
      <span class="small">Page {page} of {pages}</span>
      {page < pages ? <a href={pageHref(url, page + 1)} rel="next">Next</a> : <span />}
    </nav>
  )
}

<style>
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-4); padding-block: var(--space-4); }
  .pager a { font-weight: 600; }
  .pager a[rel="next"] { justify-self: end; }
</style>
