---
import { room } from '../data/club.ts';

interface Props {
  no: number;
}
---

<section class="night" id="room" aria-labelledby="room-title">
  <div class="wrap in">
    <div class="reveal">
      <span class="label">N°{Astro.props.no} · {room.label}</span>
      <h2 class="headline serif" id="room-title">{room.title}</h2>
    </div>
    <div class="copy reveal">
      {room.paragraphs.map((text) => <p class="lead">{text}</p>)}
    </div>
    <div class="pair cols reveal">
      <div>
        <h3 class="label">Who is in it</h3>
        <ul class="ruled">{room.who.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h3 class="label">What people bring</h3>
        <ul class="ruled">{room.brings.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .in { display: grid; gap: clamp(40px, 5vw, 72px); padding-block: clamp(80px, 11vw, 168px); }
  .headline { margin: var(--space-5) 0 0; max-width: 14ch; font-size: clamp(2.6rem, 1.3rem + 4.4vw, 5.75rem); line-height: 1; letter-spacing: -.035em; text-wrap: balance; }
  .copy { display: grid; gap: var(--space-4); align-content: end; }
  .lead { margin: 0; }
  @media (min-width: 1000px) { .in { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-9); } .cols { grid-column: 1 / -1; } }
</style>
