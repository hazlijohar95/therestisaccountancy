---
import { join } from '../data/club.ts';

interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<section class="night" aria-label="Join the club">
  <div class="wrap in">
    <h2 class="headline serif">{title}</h2>
    <div class="side">
      {lead && <p class="lead">{lead}</p>}
      <div class="actions">
        <a class="btn" href={join.href}>{join.label}</a>
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .in { display: grid; gap: var(--space-7); align-items: end; padding-block: clamp(72px, 10vw, 144px); }
  .headline { margin: 0; max-width: 13ch; font-size: clamp(2.5rem, 1.3rem + 4vw, 5rem); line-height: 1; letter-spacing: -.035em; text-wrap: balance; }
  .side { display: grid; gap: var(--space-5); }
  .lead { margin: 0; max-width: 44ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  @media (min-width: 1000px) { .in { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); column-gap: var(--space-9); } }
</style>
