---
import { hero, join } from '../data/club.ts';
---

<section class="night" id="top" aria-labelledby="hero-title">
  <div class="wrap in">
    <p class="top label">{hero.eyebrow.map((text) => <span>{text}</span>)}</p>
    <h1 class="headline serif" id="hero-title">{hero.title.map((line) => <span class="line">{line} </span>)}</h1>
    <div class="foot">
      <div class="copy">
        <p class="lead">{hero.lead}</p>
        <div class="actions">
          <a class="btn" href={join.href}>{join.label}</a>
          <a class="btn ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
        </div>
      </div>
      <dl class="facts">
        {hero.brief.map(({ term, detail }) => <div><dt>{term}</dt><dd>{detail}</dd></div>)}
      </dl>
    </div>
  </div>
</section>

<style>
  .in { display: grid; align-content: space-between; gap: clamp(48px, 7vw, 104px); min-height: min(calc(100svh - var(--bar)), 940px); padding-block: clamp(24px, 3vw, 40px) clamp(48px, 6vw, 88px); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-4); margin: 0; padding-bottom: var(--space-4); border-bottom: var(--stroke-hair) solid var(--ink); }
  .headline { margin: 0; font-size: clamp(3rem, .9rem + 6.4vw, 7.25rem); line-height: .98; }
  .line { display: block; text-wrap: balance; }
  .foot { display: grid; gap: var(--space-8); align-items: end; }
  .copy { display: grid; gap: var(--space-6); }
  .lead { margin: 0; max-width: 44ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  @media (min-width: 960px) { .foot { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--space-9); } }
</style>
