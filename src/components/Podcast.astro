---
import Hosts from './Hosts.astro';
import { podcast } from '../data/club.ts';
import Logo from './Logo.astro';
import Section from './Section.astro';

interface Props {
  no: number;
}
---

<Section id="podcast" no={Astro.props.no} title={podcast.title} intro={podcast.intro}>
  <div class="pod">
    <div class="intro">
      <Logo brand="podcast" label="Stick to Accounting, Podcast Show" class="podcast-logo" />
      <p class="lead">{podcast.lead}</p>
      <p>{podcast.find}</p>
    </div>
    <Hosts />
  </div>
</Section>

<style>
  .pod { display: grid; gap: var(--space-7); }
  .intro { display: grid; justify-items: start; gap: var(--space-3); }
  .intro p { margin: 0; }
  .intro :global(.podcast-logo) { width: min(100%, 340px); margin-bottom: var(--space-4); }
</style>
