---
import catalog from '@therestisaccountancy/brand/logos/catalog.json';
import staLockup from '@therestisaccountancy/brand/logos/sta-lockup-mono.svg';
import staWordmark from '@therestisaccountancy/brand/logos/sta-wordmark-mono.svg';
import tria from '@therestisaccountancy/brand/logos/tria-wordmark-mono.svg';

interface Props {
  brand: 'club' | 'podcast';
  /** The accessible name. Without it the logo is decorative. */
  label?: string;
  class?: string;
}

const { brand, label, class: className } = Astro.props;

const aspectOf = (file: string): number => {
  const entry = catalog.find((e) => e.file === `assets/logos/${file}`);
  if (!entry) throw new Error(`${file} is not in the brand's logo catalog`);
  return entry.aspect;
};

const logo =
  brand === 'club'
    ? { aspect: aspectOf('tria-wordmark-mono.svg'), vars: `--logo: url("${tria.src}")` }
    : { aspect: aspectOf('sta-lockup-mono.svg'), vars: `--logo: url("${staLockup.src}"); --logo-narrow: url("${staWordmark.src}")` };
---

<span
  class:list={['logo', className]}
  style={`--aspect: ${logo.aspect}; ${logo.vars}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
></span>
