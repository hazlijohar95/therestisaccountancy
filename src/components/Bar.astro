---
import { join, signIn, site } from '../data/club.ts';
import { menu } from '../data/lines.ts';
import Logo from './Logo.astro';

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (here === href || here.startsWith(`${href}/`) ? 'page' : undefined);
---

<header class="bar night">
  <div class="wrap in">
    <div class="start">
      <a class="icon open" href="#site-map" aria-label="Menu" aria-controls="site-menu" data-menu-open>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18M3 12h18M3 17.5h18" /></svg>
      </a>
      <a class="icon search" href="/search" aria-label="Search" aria-current={current('/search')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5L21 21" /></svg>
      </a>
    </div>
    <a class="home" href="/"><Logo brand="club" label={site.name} /></a>
    <div class="end">
      <a class="sign-in" href={signIn.href}>{signIn.label}</a>
      <a class="btn cta" href={join.href}>{join.label}</a>
    </div>
  </div>
  <dialog class="drawer night" id="site-menu" aria-label="Site menu">
    <button class="icon close" type="button" aria-label="Close menu" data-menu-close>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
    </button>
    <nav aria-label="Site">
      <ul class="primary">
        {menu.primary.map((link) => <li><a href={link.href} aria-current={current(link.href)}>{link.label}</a></li>)}
      </ul>
      <a class="btn" href={join.href}>{join.label}</a>
      <ul class="secondary">
        {menu.secondary.map((link) => <li><a href={link.href} aria-current={current(link.href)}>{link.label}</a></li>)}
      </ul>
    </nav>
  </dialog>
</header>

<style>
  .bar { position: sticky; top: 0; z-index: 40; border-bottom: var(--stroke-hair) solid var(--ink); }
  .in { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-4); min-height: var(--bar); }
  .home { width: 168px; color: inherit; }
  .end { justify-self: end; display: flex; align-items: center; gap: var(--space-5); }

  .icon { display: grid; place-items: center; inline-size: 40px; block-size: 40px; padding: 0; color: inherit; background: none; border: 0; cursor: pointer; }
  .icon svg { inline-size: 24px; block-size: 24px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .start { justify-self: start; display: flex; gap: var(--space-2); margin-inline-start: -8px; }

  .sign-in { font: 600 var(--size-small)/1 var(--font-sans); text-decoration: none; padding-block: var(--space-3); background: linear-gradient(currentColor, currentColor) left calc(100% - 6px) / 0 var(--stroke-hair) no-repeat; transition: background-size var(--motion-quick) var(--motion-ease); }
  @media (hover: hover) { .sign-in:hover { background-size: 100% var(--stroke-hair); } }
  .cta { min-height: 40px; padding: .55em 1.05em; font-size: var(--size-small); }

  .drawer { margin: 0; inset: 0 auto 0 0; inline-size: min(300px, 86vw); max-inline-size: none; block-size: 100dvh; max-block-size: none; padding: var(--space-3) var(--space-5) var(--space-6); border: 0; border-inline-end: var(--stroke-hair) solid var(--ink); overflow-y: auto; overscroll-behavior: contain; }
  .drawer[open] { display: flex; flex-direction: column; }
  .drawer::backdrop { background: rgb(0 0 0 / .6); }
  .close { margin-inline-start: -8px; }
  .drawer nav { display: flex; flex: 1; flex-direction: column; margin-top: var(--space-4); }
  .drawer ul { margin: 0; padding: 0; list-style: none; }
  .drawer a:not(.btn) { display: block; text-decoration: none; }
  .primary a { padding-block: var(--space-2); border-bottom: var(--stroke-hair) dashed color-mix(in srgb, var(--ink) 35%, transparent); font: 400 1.125rem/1.35 var(--font-sans); }
  .primary li:first-child a { border-bottom-style: solid; }
  .drawer a[aria-current="page"] { font-weight: 600; }
  .drawer .btn { align-self: start; margin-top: var(--space-5); }
  .drawer .secondary { display: grid; gap: var(--space-2); margin-top: auto; padding-top: var(--space-7); }
  .secondary a { font: 400 1rem/1.5 var(--font-sans); color: color-mix(in srgb, var(--ink) 75%, transparent); }
  @media (hover: hover) { .drawer a:not(.btn):hover { text-decoration: underline; text-decoration-thickness: var(--stroke-hair); text-underline-offset: 4px; } }

  @media (prefers-reduced-motion: no-preference) {
    .drawer, .drawer::backdrop { transition: translate var(--motion-settle) var(--motion-ease), opacity var(--motion-settle) var(--motion-ease), overlay var(--motion-settle) allow-discrete, display var(--motion-settle) allow-discrete; }
    .drawer:not([open]) { translate: -100% 0; }
    .drawer:not([open])::backdrop { opacity: 0; }
    @starting-style {
      .drawer[open] { translate: -100% 0; }
      .drawer[open]::backdrop { opacity: 0; }
    }
  }

  @media (max-width: 819px) { .sign-in { display: none; } }
  @media (max-width: 559px) { .home { width: 124px; } .cta, .search { display: none; } }
</style>

<script>
  /* Without this script the menu link goes to the footer's site map. With it, the menu opens as a modal drawer. */
  const dialog = document.getElementById('site-menu');
  const open = document.querySelector('[data-menu-open]');
  if (dialog instanceof HTMLDialogElement && open instanceof HTMLAnchorElement) {
    open.addEventListener('click', (event) => {
      event.preventDefault();
      dialog.showModal();
    });
    dialog.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
    /* A click on the backdrop lands on the dialog itself, outside its box. */
    dialog.addEventListener('click', (event) => {
      const box = dialog.getBoundingClientRect();
      if (event.target === dialog && (event.clientX > box.right || event.clientX < box.left || event.clientY < box.top || event.clientY > box.bottom)) dialog.close();
    });
  }
</script>
