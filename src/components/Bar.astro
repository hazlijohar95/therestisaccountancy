---
import { join, signIn, site } from '../data/club.ts';
import { company, lines } from '../data/lines.ts';
import Logo from './Logo.astro';

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const menu = [...lines, company.membership, company.directory, company.about, signIn];
const current = (href: string) => (here === href || here.startsWith(`${href}/`) ? 'page' : undefined);
---

<header class="bar night">
  <div class="wrap in">
    <a class="home" href="/"><Logo brand="club" label={site.name} /></a>
    <nav class="wide" aria-label="Site">
      {lines.map((link) => <a href={link.href} aria-current={current(link.href)}>{link.label}</a>)}
    </nav>
    <a class="sign-in" href={signIn.href}>{signIn.label}</a>
    <a class="btn cta" href={join.href}>{join.label}</a>
    <details class="menu">
      <summary class="btn ghost">Menu</summary>
      <nav class="drawer" aria-label="Site">
        {menu.map((link) => <a href={link.href} aria-current={current(link.href)}>{link.label}</a>)}
        <a class="btn" href={join.href}>{join.label}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .bar { position: sticky; top: 0; z-index: 40; border-bottom: var(--stroke-hair) solid var(--ink); }
  .in { display: flex; align-items: center; gap: var(--space-5); min-height: var(--bar); }
  .home { flex: none; width: 168px; color: inherit; }
  .wide { display: flex; gap: var(--space-5); margin-inline-start: auto; }
  .wide a, .sign-in { font: 600 var(--size-small)/1 var(--font-sans); text-decoration: none; padding-block: var(--space-3); background: linear-gradient(currentColor, currentColor) left calc(100% - 6px) / 0 var(--stroke-hair) no-repeat; transition: background-size var(--motion-quick) var(--motion-ease); }
  .wide a[aria-current="page"] { background-size: 100% var(--stroke-hair); }
  @media (hover: hover) { .wide a:hover, .sign-in:hover { background-size: 100% var(--stroke-hair); } }
  @media (forced-colors: active) { .wide a[aria-current="page"] { text-decoration: underline; text-decoration-thickness: var(--stroke-hair); text-underline-offset: 6px; } }
  .sign-in { padding-inline-start: var(--space-5); border-inline-start: var(--stroke-hair) solid var(--ink); }
  .cta, .menu summary { min-height: 40px; padding: .55em 1.05em; font-size: var(--size-small); }

  .menu { display: none; }
  .menu summary { list-style: none; cursor: pointer; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu[open] summary { background: var(--ink); color: var(--bg); }
  .drawer { position: absolute; inset: 100% 0 auto; display: grid; max-block-size: calc(100dvh - var(--bar)); overflow-y: auto; overscroll-behavior: contain; padding: var(--space-2) var(--gutter) var(--space-6); background: var(--bg); border-bottom: var(--stroke-hair) solid var(--ink); }
  .drawer a:not(.btn) { padding-block: var(--space-4); border-bottom: var(--stroke-hair) solid var(--ink); font: 400 var(--size-head)/1.1 var(--display-font); letter-spacing: var(--display-tracking); font-synthesis: none; text-decoration: none; }
  .drawer a[aria-current="page"]::after { content: " \00B7"; }
  .drawer .btn { justify-self: start; margin-top: var(--space-5); }

  @media (max-width: 1099px) {
    .wide, .sign-in { display: none; }
    .cta { margin-inline-start: auto; }
    .menu { display: block; }
  }
  @media (max-width: 519px) { .home { width: 124px; } .cta { display: none; } .menu { margin-inline-start: auto; } }
</style>

<script>
  /* The menu closes when focus leaves it or on Escape, so it never sits over what the keyboard reaches next. */
  const menu = document.querySelector('.bar .menu');
  if (menu instanceof HTMLDetailsElement) {
    menu.addEventListener('focusout', (event) => {
      /* No relatedTarget is a mouse press that focused nothing, as Safari's on a link does. Closing then would swallow the click. */
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  }
</script>
