---
import Logo from './Logo.astro';

interface Props {
  name: string;
  number: string;
  role?: string;
  /** Follows the pointer, as a card held to the light would. */
  tilt?: boolean;
}

const { name, number, role = 'Member', tilt = true } = Astro.props;
---

<div class="stage" data-tilt={tilt ? '' : undefined}>
  <div class="member">
    <Logo brand="club" /><span></span>
    <div class="who">
      <div><span>{role}</span><b data-card-name>{name}</b></div>
      <div class="no"><span>No.</span><br />{number}</div>
    </div>
  </div>
</div>

<script>
  for (const stage of document.querySelectorAll<HTMLElement>('[data-tilt]')) {
    const card = stage.firstElementChild;
    if (!(card instanceof HTMLElement) || !matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) continue;
    stage.addEventListener('pointermove', (event) => {
      const r = card.getBoundingClientRect();
      const px = Math.min(Math.max((event.clientX - r.left) / r.width, 0), 1);
      const py = Math.min(Math.max((event.clientY - r.top) / r.height, 0), 1);
      card.style.setProperty('--ry', `${(px - 0.5) * 16}deg`);
      card.style.setProperty('--rx', `${(0.5 - py) * 12}deg`);
      card.style.setProperty('--gx', `${px * 100}%`);
      card.style.setProperty('--gy', `${py * 100}%`);
    });
    stage.addEventListener('pointerleave', () => {
      for (const property of ['--rx', '--ry', '--gx', '--gy']) card.style.removeProperty(property);
    });
  }
</script>

<style>
  .stage { display: grid; place-items: center; }
</style>
