---
import { authorByHandle, authorPath, type Author } from '../data/authors.ts';
import { columnBySlug, columnPath } from '../data/columns.ts';
import { postPath, type Post } from '../server/posts.ts';

/** One post as a card on the home page. The lead story is set larger and keeps its dek; the rest are compact. */
interface Props {
  post: Post;
  lead?: boolean;
}

const { post, lead = false } = Astro.props;
const column = columnBySlug(post.data.column);
const byline = post.data.authors.flatMap((h) => authorByHandle(h) ?? []) satisfies Author[];
---

<article class:list={['story', { lead }]}>
  {column && <a class="label column" href={columnPath(column)}>{column.name}</a>}
  <h3 class="title serif"><a href={postPath(post)}>{post.data.title}</a></h3>
  <p class="dek">{post.data.dek}</p>
  <p class="label by">
    {byline.map((author, i) => (
      <>
        {i > 0 && ', '}
        <a href={authorPath(author)}>{author.name}</a>
      </>
    ))}
    {post.data.access === 'members' && <span> · Members</span>}
  </p>
</article>

<style>
  .story { display: grid; align-content: start; gap: var(--space-2); }
  .story p, .title { margin: 0; }
  .story a { text-decoration: none; }
  .title { font-size: clamp(1.25rem, 1.1rem + .6vw, 1.6rem); line-height: 1.15; text-wrap: balance; }
  .lead .title { font-size: clamp(2rem, 1.2rem + 2.8vw, 3.5rem); line-height: 1.02; }
  .lead .dek { font-size: var(--size-lead); }
  .title a:hover, .by a:hover, .column:hover { text-decoration: underline; text-decoration-thickness: var(--stroke-hair); }
  .dek { max-width: 32em; }
  .story:not(.lead) .dek { font-size: var(--size-small); }
</style>
