---
/** The night band that opens every members' and admin page: a ruled label, a serif headline, and an optional lead. */
interface Props {
  label: string;
  title: string;
  narrow?: boolean;
}
const { label, title, narrow = false } = Astro.props;
---

<section class="night">
  <div class="wrap masthead">
    <p class="label top"><slot name="label">{label}</slot></p>
    <h1 class:list={['headline', 'serif', { narrow }]}>{title}</h1>
    {Astro.slots.has('default') && <div class="lead"><slot /></div>}
  </div>
</section>

<style>
  .masthead { display: grid; gap: var(--space-4); padding-block: clamp(32px, 4vw, 48px) clamp(48px, 6vw, 80px); }
  .top { margin: 0 0 var(--space-4); padding-bottom: var(--space-4); border-bottom: var(--stroke-hair) solid var(--ink); }
  .headline { margin: 0; font-size: var(--size-page); line-height: 1; text-wrap: balance; overflow-wrap: anywhere; }
  .narrow { max-width: 18ch; }
  .lead { max-width: 30em; }
  .lead :global(p) { margin: 0; }
</style>
