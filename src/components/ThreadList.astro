---
import { channelBySlug, threadPath } from '../data/community.ts';
import { formatMoment } from '../lib/format.ts';
import type { Thread } from '../server/community.ts';

interface Props {
  threads: Thread[];
  showChannel?: boolean;
}
const { threads, showChannel = false } = Astro.props;
const replies = (n: number) => (n === 0 ? 'No replies yet' : n === 1 ? '1 reply' : `${n} replies`);
---

<ol class="threads" role="list">
  {
    threads.map((t) => (
      <li>
        <a class="thread-title" href={threadPath(t.id)}>
          {t.title}
        </a>
        <p class="thread-meta small">
          {[
            t.pinned ? 'Pinned' : null,
            t.locked ? 'Locked' : null,
            showChannel ? channelBySlug(t.channel)?.name : null,
            t.author?.name ?? 'Former member',
            replies(t.replies),
            `Active ${formatMoment(t.lastPostAt)}`,
          ]
            .filter(Boolean)
            .join(' · ')}
        </p>
      </li>
    ))
  }
</ol>

<style>
  .threads { list-style: none; margin: 0; padding: 0; border-top: var(--stroke-rule) solid var(--ink); }
  .threads li { display: grid; gap: var(--space-2); padding-block: var(--space-4); border-bottom: var(--stroke-hair) solid var(--ink); }
  .thread-title { font: 400 var(--size-head)/1.15 var(--display-font); letter-spacing: var(--display-tracking); font-synthesis: none; text-decoration: none; overflow-wrap: anywhere; }
  .thread-title:hover { text-decoration: underline; text-underline-offset: .15em; text-decoration-thickness: 1px; }
  .thread-meta { margin: 0; }
</style>
