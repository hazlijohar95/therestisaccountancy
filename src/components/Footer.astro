---
import { join, nav, signIn, site } from '../data/club.ts';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const links = [...nav, join, signIn, { href: '/privacy', label: 'Privacy' }];
---

<footer>
  <div class="wrap in">
    <a href="/" class="home"><Logo brand="club" label={site.name} class="footer-logo" /></a>
    <nav aria-label="Footer">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <p class="small">{site.tagline} © {year} {site.name}.</p>
  </div>
</footer>

<style>
  .in { display: grid; gap: var(--space-5); padding-block: var(--space-8); }
  .home { color: inherit; justify-self: start; }
  .in :global(.footer-logo) { width: 220px; }
  nav { display: flex; flex-wrap: wrap; gap: 0 var(--space-5); }
  nav a { font: 600 var(--size-small)/1 var(--font-sans); text-decoration: none; padding-block: var(--space-3); background: linear-gradient(currentColor, currentColor) left calc(100% - 6px) / 0 var(--stroke-hair) no-repeat; transition: background-size var(--motion-settle) var(--motion-ease); }
  nav a:hover { background-size: 100% var(--stroke-hair); }
  p { margin: 0; padding-top: var(--space-5); border-top: var(--stroke-hair) solid var(--ink); }
  @media (min-width: 1000px) { .in { grid-template-columns: auto minmax(0, 1fr); align-items: center; } nav { justify-content: end; } p { grid-column: 1 / -1; } }
</style>
