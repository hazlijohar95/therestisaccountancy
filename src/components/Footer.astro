---
import { join, signIn, site } from '../data/club.ts';
import { footerGroups } from '../data/lines.ts';
import Logo from './Logo.astro';
import Signup from './Signup.astro';

interface Props {
  signup?: boolean;
}

const { signup = true } = Astro.props;
const year = new Date().getFullYear();
const idOf = (group: string) => `footer-${group.toLowerCase().replaceAll(' ', '-')}`;
---

<footer>
  <div class="wrap in">
    {signup && <Signup source="footer" />}
    <div class="map" id="site-map">
      <a href="/" class="home"><Logo brand="club" label={site.name} class="footer-logo" /></a>
      {
        footerGroups.map(({ group, links }) => (
          <nav aria-labelledby={idOf(group)}>
            <h2 class="label" id={idOf(group)}>{group}</h2>
            {links.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
        ))
      }
      <nav aria-labelledby="footer-club">
        <h2 class="label" id="footer-club">Club</h2>
        <a href={join.href}>{join.label}</a>
        <a href={signIn.href}>{signIn.label}</a>
      </nav>
    </div>
    <p class="small">{site.tagline} © {year} {site.name}.</p>
  </div>
</footer>

<style>
  .in { display: grid; gap: var(--space-7); padding-block: var(--space-8); }
  .map { display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: var(--space-6) var(--space-5); padding-top: var(--space-7); border-top: var(--stroke-hair) solid var(--ink); }
  .home { grid-column: 1 / -1; color: inherit; justify-self: start; }
  .in :global(.footer-logo) { width: 220px; }
  nav { display: grid; align-content: start; gap: var(--space-1); }
  h2 { margin: 0 0 var(--space-2); }
  nav a { justify-self: start; font: 600 var(--size-small)/1 var(--font-sans); text-decoration: none; padding-block: var(--space-2); background: linear-gradient(currentColor, currentColor) left calc(100% - 3px) / 0 var(--stroke-hair) no-repeat; transition: background-size var(--motion-quick) var(--motion-ease); }
  @media (hover: hover) { nav a:hover { background-size: 100% var(--stroke-hair); } }
  p { margin: 0; padding-top: var(--space-5); border-top: var(--stroke-hair) solid var(--ink); }
</style>
