---
interface Props {
  id: string;
  no: number;
  title: string;
  intro?: string;
}

const { id, no, title, intro } = Astro.props;
---

<section class="sec wrap" id={id} aria-labelledby={`${id}-title`}>
  <div class="rail reveal">
    <span class="no serif">N°{no}</span>
    <h2 class="head" id={`${id}-title`}>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>
  <div class="reveal"><slot /></div>
</section>

<style>
  .no { display: block; font-size: clamp(3.5rem, 2.4rem + 3.6vw, 6.5rem); line-height: .82; letter-spacing: -.06em; }
  .head { margin: var(--space-5) 0 var(--space-3); }
  p { margin: 0; max-width: 38ch; }
  @media (min-width: 1000px) { .rail { position: sticky; top: calc(var(--bar) + 40px); align-self: start; } }
</style>
