---
interface Props {
  label: string;
  title: string;
  lead?: string;
}

const { label, title, lead } = Astro.props;
---

<section class="night" aria-labelledby="page-title">
  <div class="wrap in">
    <p class="label top">{label}</p>
    <h1 class="headline serif" id="page-title">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {Astro.slots.has('default') && <div class="actions"><slot /></div>}
  </div>
</section>

<style>
  .in { display: grid; gap: var(--space-6); padding-block: clamp(32px, 4vw, 48px) clamp(56px, 8vw, 112px); }
  .top { margin: 0 0 var(--space-6); padding-bottom: var(--space-4); border-bottom: var(--stroke-hair) solid var(--ink); }
  .headline { margin: 0; max-width: 16ch; font-size: clamp(2.75rem, 1.2rem + 5.2vw, 6rem); line-height: .98; letter-spacing: -.035em; text-wrap: balance; }
  .lead { margin: 0; max-width: 52ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
</style>
