{
  "name": "@therestisaccountancy/brand",
  "version": "0.2.0",
  "private": true,
  "description": "The Rest Is Accountancy and Stick to Accounting brand system: React logo components, typed tokens, CSS components, logo files and self-hosted fonts. No runtime fetches.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./logo": {
      "types": "./dist/logo/index.d.ts",
      "default": "./dist/logo/index.js"
    },
    "./css": "./css/brand.css",
    "./css/tokens": "./css/tokens.css",
    "./css/fonts": "./css/fonts.css",
    "./tokens.json": "./tokens/tokens.json",
    "./logos/catalog.json": "./assets/logos/catalog.json",
    "./logos/*": "./assets/logos/*",
    "./fonts/*": "./assets/fonts/*",
    "./devices/*": "./assets/devices/*"
  },
  "files": [
    "dist",
    "css",
    "tokens",
    "assets",
    "llms.txt"
  ],
  "scripts": {
    "build": "npm run build:tokens && npm run build:ts",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build:logos": "npm run build:ts && node scripts/build-logos.mjs",
    "extract:logos": "python3 -I scripts/extract-logos.py",
    "fonts": "python3 -I scripts/fetch-fonts.py",
    "test": "npm run build:ts && node --test \"tests/*.test.mjs\"",
    "dev": "python3 -m http.server 4173"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
