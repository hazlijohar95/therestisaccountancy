{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "./app/.cloudflare/types/index.d.ts"
  ],
  "exclude": [
    "dist",
    ".site",
    "brand",
    "cpe",
    "app/src",
    "app/node_modules",
    "app/vite.config.ts",
    "app/cloudflare.config.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
