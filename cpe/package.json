{
  "name": "@therestisaccountancy/cpe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5180",
    "build": "cf workers types && tsc -b && cf build && node scripts/check-bundle.ts",
    "deploy": "pnpm run build && cf deploy",
    "preview": "vite preview --host localhost --port 5181",
    "audio": "node scripts/build-audio.ts",
    "typecheck": "cf workers types && tsc -b",
    "test": "node --test \"worker/**/*.test.ts\" \"src/**/*.test.ts\"",
    "check:bundle": "node scripts/check-bundle.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "geist": "^1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cf": "1.0.0-rc.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.18"
  }
}
